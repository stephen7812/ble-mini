<template>
  <view class="control-page">
    <!-- 设备信息头部 -->
    <view class="device-header">
      <view class="device-title">
        <text class="device-name">{{ deviceName }}</text>
        <text class="device-sn">SN: {{ deviceSn }}</text>
      </view>
      <!-- 历史记录图标 -->
      <view class="history-icon" bindtap="goHistory">
        <text class="icon-text">📋</text>
      </view>
    </view>

    <!-- 加载状态 -->
    <view class="loading-section" wx:if="{{ loadingCommands }}">
      <view class="loading-spinner"></view>
      <text class="loading-text">正在加载控制功能...</text>
    </view>

    <!-- 暂无可用控制功能 -->
    <view class="empty-section" wx:if="{{ !loadingCommands && availableCommands.length === 0 }}">
      <text class="empty-icon">⚠️</text>
      <text class="empty-title">暂无可用控制功能</text>
      <text class="empty-hint">该设备暂不支持远程控制，或网络连接异常</text>
    </view>

    <!-- 动态控制卡片 -->
    <view class="control-section" wx:if="{{ !loadingCommands && availableCommands.length > 0 }}">
      <view class="section-title">远程控制</view>

      <!-- 动态渲染每个命令 -->
      <view class="control-card" wx:for="{{ availableCommands }}" wx:key="command">
        <view class="card-header">
          <text class="card-title">{{ item.name }}</text>
          <text class="card-desc" wx:if="{{ item.description }}">{{ item.description }}</text>
        </view>

        <view class="card-body">
          <!-- 动态渲染参数输入 -->
          <view class="input-row" wx:for="{{ item.params }}" wx:for-item="param" wx:key="key">
            <text class="input-label">{{ param.label }}</text>
            <input
              class="input-field"
              type="{{ param.type === 'number' ? 'digit' : 'text' }}"
              data-command="{{ item.command }}"
              data-param="{{ param.key }}"
              value="{{ getParamValue(item.command, param.key) }}"
              placeholder="{{ param.default }}"
              bindinput="handleParamInput"
            />
          </view>
        </view>

        <view class="card-actions">
          <button class="btn-confirm" data-command="{{ item.command }}" bindtap="handleSendCommand">
            确认执行
          </button>
        </view>
      </view>
    </view>

    <!-- 底部安全提示 -->
    <view class="safety-notice" wx:if="{{ !loadingCommands && availableCommands.length > 0 }}">
      <text class="notice-icon">⚠️</text>
      <text class="notice-text">远程控制将直接作用于设备，请谨慎操作</text>
    </view>
  </view>
</template>

<script>
import { createPage } from '@mpxjs/core'
import { sendControlCommand, getDeviceCommands, getDeviceBySn } from '../../services/api/tenant'

createPage({
  data: {
    deviceSn: '',
    deviceId: null,
    deviceName: '',
    valveType: '', // 阀门类型：pilot=先导阀，flow=流量阀等
    // 平台信息
    platformName: '',
    platformKind: '',
    // 设备支持的指令列表
    availableCommands: [],
    loadingCommands: true,
    // 参数值存储 { command: { paramKey: value } }
    paramValues: {}
  },

  onLoad(options) {
    const { sn, deviceId, name } = options
    if (!sn || !deviceId) {
      wx.showToast({ title: '缺少设备参数', icon: 'none' })
      setTimeout(() => wx.navigateBack(), 1500)
      return
    }

    this.setData({
      deviceSn: sn,
      deviceId: parseInt(deviceId),
      deviceName: name || sn
    })

    // 先获取设备完整信息，再查询支持的指令
    this.loadDeviceInfo()
  },

  methods: {
    // 加载设备完整信息（包含平台、产品等信息）
    async loadDeviceInfo() {
      try {
        const device = await getDeviceBySn(this.data.deviceSn)

        // 保存设备信息，用于后续判断平台类型
        this.deviceInfo = device

        // 更新设备名称和阀门类型
        // 注意：如果 valve_type 为 null/undefined，需要从其他字段推断或默认处理
        const valveType = device.valve_type || ''

        this.setData({
          deviceName: device.name || this.data.deviceSn,
          valveType: valveType
        })

        console.log('设备信息:', {
          name: device.name,
          valve_type: device.valve_type,
          valveType: valveType,
          sn: device.sn,
          device_model: device.device_model
        })

        // 获取设备支持的指令列表
        this.loadAvailableCommands()

      } catch (e) {
        console.error('加载设备信息失败:', e)
        wx.showModal({
          title: '加载失败',
          content: '无法获取设备信息，请检查网络后重试',
          confirmText: '重试',
          cancelText: '返回',
          success: (res) => {
            if (res.confirm) {
              this.loadDeviceInfo()
            } else {
              wx.navigateBack()
            }
          }
        })
      }
    },

    // 加载设备支持的指令列表
    async loadAvailableCommands() {
      this.setData({ loadingCommands: true })
      try {
        const result = await getDeviceCommands(this.data.deviceSn)

        console.log('API返回数据:', result)

        // 解析返回的数据结构
        // { kind: "black-ant", platform: "black-ant", capability: { commands: [...] } }
        const platformKind = result.kind || result.platform || ''
        const platformName = platformKind === 'black-ant' ? '黑蚂蚁' : (platformKind === 'huawei-iotda' ? '华为IoTDA' : platformKind)
        let commands = result.capability && result.capability.commands ? result.capability.commands : []

        console.log('过滤前的指令列表:', commands)
        console.log('当前阀门类型:', this.data.valveType)

        // 根据阀门类型过滤命令：先导阀不能设置开度和圈数
        if (this.data.valveType === 'pilot') {
          const originalLength = commands.length
          commands = commands.filter(cmd => {
            const command = cmd.command.toLowerCase()
            const shouldKeep = !command.includes('open') && !command.includes('position')
            console.log(`命令 ${cmd.command}: ${shouldKeep ? '保留' : '过滤'}`)
            return shouldKeep
          })
          console.log(`先导阀过滤: ${originalLength} -> ${commands.length} 条命令`)
        }

        console.log('过滤后的指令列表:', commands)

        // 初始化参数默认值
        const paramValues = {}
        commands.forEach(cmd => {
          paramValues[cmd.command] = {}
          if (cmd.params && Array.isArray(cmd.params)) {
            cmd.params.forEach(param => {
              paramValues[cmd.command][param.key] = param.default || ''
            })
          }
        })

        this.setData({
          availableCommands: commands,
          platformName: platformName,
          platformKind: platformKind,
          paramValues: paramValues,
          loadingCommands: false
        })

      } catch (e) {
        console.error('加载设备支持指令失败:', e)
        this.setData({
          availableCommands: [],
          loadingCommands: false
        })

        wx.showModal({
          title: '加载失败',
          content: e.message || '无法获取设备控制功能',
          showCancel: false
        })
      }
    },

    // 获取参数值
    getParamValue(command, paramKey) {
      if (!this.data.paramValues || !this.data.paramValues[command]) {
        return ''
      }
      return this.data.paramValues[command][paramKey] || ''
    },

    // 参数输入
    handleParamInput(e) {
      const { command, param } = e.currentTarget.dataset
      const value = e.detail.value

      this.setData({
        [`paramValues.${command}.${param}`]: value
      })
    },

    // 发送控制指令
    async handleSendCommand(e) {
      const commandName = e.currentTarget.dataset.command

      // 找到对应的命令配置
      const commandConfig = this.data.availableCommands.find(cmd => cmd.command === commandName)
      if (!commandConfig) {
        wx.showToast({ title: '指令配置错误', icon: 'none' })
        return
      }

      // 获取参数值
      const params = {}
      const commandValues = this.data.paramValues[commandName] || {}

      if (commandConfig.params && Array.isArray(commandConfig.params)) {
        for (const paramDef of commandConfig.params) {
          const value = commandValues[paramDef.key]

          // 参数验证
          if (value === '' || value === undefined) {
            wx.showToast({ title: `请输入${paramDef.label}`, icon: 'none' })
            return
          }

          // 类型转换
          if (paramDef.type === 'number') {
            params[paramDef.key] = Number(value)
            if (isNaN(params[paramDef.key])) {
              wx.showToast({ title: `${paramDef.label}必须是数字`, icon: 'none' })
              return
            }
          } else {
            params[paramDef.key] = value
          }
        }
      }

      // 二次确认
      const confirm = await this.showConfirm(`确定执行【${commandConfig.name}】吗？`)
      if (!confirm) return

      // 发送指令
      wx.showLoading({ title: '指令下发中...', mask: true })

      try {
        await sendControlCommand(this.data.deviceId, commandName, params)

        wx.hideLoading()
        wx.showToast({ title: '指令下发成功', icon: 'success' })

      } catch (e) {
        wx.hideLoading()
        wx.showModal({
          title: '指令下发失败',
          content: e.message || '请检查网络连接后重试',
          showCancel: false
        })
      }
    },

    // 跳转到历史记录页面
    goHistory() {
      wx.navigateTo({
        url: `/pages/control-history/index?deviceId=${this.data.deviceId}&sn=${encodeURIComponent(this.data.deviceSn)}&name=${encodeURIComponent(this.data.deviceName)}`
      })
    },

    // 显示确认对话框
    showConfirm(content) {
      return new Promise((resolve) => {
        wx.showModal({
          title: '确认操作',
          content,
          success: (res) => {
            resolve(res.confirm)
          }
        })
      })
    }
  }
})
</script>

<style lang="stylus">
.control-page
  min-height 100vh
  background-color #f5f5f5
  padding-bottom 100rpx

.device-header
  background-color #fff
  padding 30rpx
  border-bottom 1px solid #e5e5e5
  display flex
  justify-content space-between
  align-items flex-start

