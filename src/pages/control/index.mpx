  display flex
  flex-direction column
  align-items flex-start
  flex 1

.device-name
  font-size 36rpx
  font-weight bold
  color #333
  margin-bottom 12rpx

.device-sn
  font-size 24rpx
  color #999

.history-icon
  width 80rpx
  height 80rpx
  display flex
  align-items center
  justify-content center
  background-color #f5f5f5
  border-radius 50%
  cursor pointer
  transition all 0.3s

.history-icon:active
  background-color #e0e0e0
  transform scale(0.95)

.history-icon .icon-text
  font-size 40rpx

.platform-badge
  display inline-block
  padding 6rpx 16rpx
  background-color #e6f7ff
  color #1890ff
  border-radius 4rpx
  font-size 22rpx
  border 1px solid #91d5ff

/* 加载状态 */
.loading-section
  display flex
  flex-direction column
  align-items center
  padding 120rpx 40rpx

.loading-spinner
  width 60rpx
  height 60rpx
  border 6rpx solid #f3f3f3
  border-top-color #1890ff
  border-radius 50%
  animation spinAnim 0.8s linear infinite
  margin-bottom 24rpx

.loading-text
  font-size 28rpx
  color #999

/* 空状态 */
.empty-section
  display flex
  flex-direction column
  align-items center
  padding 120rpx 40rpx

.empty-icon
  font-size 80rpx
  margin-bottom 24rpx

.empty-title
  font-size 32rpx
  font-weight 600
  color #666
  margin-bottom 16rpx

.empty-hint
  font-size 26rpx
  color #999
  text-align center
  line-height 1.5

.control-section
  margin-top 20rpx

.section-title
  padding 20rpx 30rpx
  font-size 28rpx
  font-weight bold
  color #333
  background-color #fff

.control-card
  background-color #fff
  margin-bottom 20rpx
  padding 30rpx

.card-header
  margin-bottom 24rpx

.card-title
  font-size 32rpx
  font-weight bold
  color #333
  margin-bottom 8rpx

.card-desc
  font-size 24rpx
  color #999
  line-height 1.4

.card-body
  margin-bottom 24rpx

.input-row
  display flex
  align-items center
  margin-bottom 20rpx

.input-label
  font-size 28rpx
  color #666
  width 180rpx
  flex-shrink 0

.input-field
  flex 1
  height 70rpx
  padding 0 20rpx
  border 1px solid #d9d9d9
  border-radius 8rpx
  font-size 28rpx
  background-color #fafafa

.card-actions
  display flex

.btn-confirm
  flex 1
  height 80rpx
  line-height 80rpx
  border-radius 8rpx
  font-size 30rpx
  text-align center
  border none
  background-color #1890ff
  color #fff
  font-weight 600
  &:active
    background-color #096dd9

.history-section
  margin-top 20rpx

.task-list
  background-color #fff

.task-item
  display flex
  justify-content space-between
  align-items center
  padding 30rpx
  border-bottom 1px solid #f0f0f0
  &:last-child
    border-bottom none

.task-info
  flex 1
  display flex
  flex-direction column
  gap 10rpx

.task-command
  font-size 28rpx
  color #333
  font-weight bold

.task-params
  font-size 26rpx
  color #666

.task-time
  font-size 24rpx
  color #999

.task-status
  padding 10rpx 20rpx
  border-radius 4rpx
  font-size 24rpx
  &.status-success
    background-color #f6ffed
    color #52c41a
  &.status-fail
    background-color #fff2f0
