<template>
  <view class="control-container {{themeClass}}">
    <!-- Hero 头部：金属铭牌面板（设备信息与快捷入口） -->
    <view class="hero-section riveted anim-fade-in">
      <view class="hero-deco deco-1"></view>
      <view class="hero-deco deco-2"></view>

      <view class="hero-content">
        <view class="device-header">
          <view class="device-info">
            <view class="device-name-row">
              <view class="led on device-led"></view>
              <text class="device-name">{{ deviceName }}</text>
            </view>
            <text class="device-sn mono">SN: {{ deviceSn }}</text>
            <view class="device-meta" wx:if="{{ platformName }}">
              <text class="platform-badge">{{ platformName }}</text>
            </view>
          </view>
          <view class="header-actions">
            <view class="theme-switch" bindtap="toggleTheme">
              <text class="theme-icon">{{themeIcon}}</text>
            </view>
            <view class="history-btn" bindtap="goHistory">
              <text class="history-icon">⧉</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 主内容区 -->
    <view class="content-wrapper">
      <!-- 加载状态 -->
      <view class="loading-state anim-fade-in" wx:if="{{ loadingCommands }}">
        <view class="loading-spinner"></view>
        <text class="loading-text">正在加载控制功能...</text>
      </view>

      <!-- 暂无可用控制功能 -->
      <view class="empty-state anim-fade-in" wx:if="{{ !loadingCommands && availableCommands.length === 0 }}">
        <view class="empty-icon">
          <view class="empty-wave wave-1"></view>
          <view class="empty-wave wave-2"></view>
          <view class="empty-dot"></view>
        </view>
        <text class="empty-title">暂无可用控制功能</text>
        <text class="empty-hint">该设备暂不支持远程控制，或网络连接异常</text>
      </view>

      <!-- 控制命令列表 -->
      <view class="control-list anim-slide-up d1" wx:if="{{ !loadingCommands && availableCommands.length > 0 }}">
        <view class="section-header">
          <view class="header-screw"></view>
          <text class="section-title">远程控制</text>
          <text class="header-plate mono">CMD</text>
        </view>

        <!-- 动态渲染每个命令卡片：铆钉金属卡 + 左侧 LED 竖条 -->
        <view class="command-card riveted" wx:for="{{ availableCommands }}" wx:for-item="cmdItem" wx:key="command">
          <view class="cmd-led"></view>
          <text class="command-title">{{ cmdItem.name }}</text>
          <text class="command-desc" wx:if="{{ cmdItem.description }}">{{ cmdItem.description }}</text>

          <!--
            动态渲染参数输入：value 直接读 param.value，不调用 method。
            Mpx 从渲染函数里调方法时 this 未绑定实例，method 内访问 this.data
            会抛 "Cannot read properties of undefined (reading 'data')".
          -->

          <!-- 分时压力：独立 UI（总开关 + 5 个时段） -->
          <block wx:if="{{ cmdItem.command === 'setTimePressure' }}">
            <view class="tp-main-row">
              <view class="led {{ timePressure.enable ? 'on' : '' }}"></view>
              <text class="tp-main-label">分时压力总开关</text>
              <switch class="tp-main-switch" checked="{{ timePressure.enable }}" data-command="{{ cmdItem.command }}" bindchange="onTimePressureEnableToggle" />
            </view>

            <view class="tp-slots">
              <view class="tp-slot {{ !timePressure.enable ? 'tp-disabled' : '' }}" wx:for="{{ timePressure.slots }}" wx:for-item="slot" wx:key="id">
                <view class="tp-slot-head">
                  <view class="led {{ slot.on ? 'on' : '' }}"></view>
                  <text class="tp-slot-title">时段{{ slot.id }}</text>
                  <switch class="tp-slot-switch" checked="{{ slot.on }}" data-idx="{{ index }}" data-command="{{ cmdItem.command }}" bindchange="onTimePressureSlotToggle" />
                </view>
                <view class="tp-slot-body">
                  <picker
                    class="tp-time-picker"
                    mode="time"
                    value="{{ slot.time }}"
                    data-idx="{{ index }}"
                    data-command="{{ cmdItem.command }}"
                    bindchange="onTimePressureTime"
                    disabled="{{ !slot.on || !timePressure.enable }}"
                  >
                    <view class="tp-time-val mono {{ !slot.on || !timePressure.enable ? 'tp-off' : '' }}">{{ slot.time }}</view>
                  </picker>
                  <view class="tp-pressure-wrap">
                    <input
                      class="tp-pressure-input mono"
                      type="digit"
                      value="{{ slot.pressure }}"
                      data-idx="{{ index }}"
                      data-command="{{ cmdItem.command }}"
                      bindinput="onTimePressurePressure"
                      disabled="{{ !slot.on || !timePressure.enable }}"
                      placeholder="压力"
                    />
                    <text class="tp-pressure-unit">MPa</text>
                  </view>
                </view>
              </view>
            </view>
          </block>

          <!-- 普通参数 -->
          <block wx:else>
            <view class="param-row" wx:for="{{ cmdItem.params }}" wx:for-item="param" wx:key="key">
              <text class="param-label">{{ param.label }}</text>
              <view class="param-input-wrap">
                <!-- 枚举参数走 picker：候选值由后端字典给出或由前端补充 -->
                <picker
                  wx:if="{{ param.widgetType === 'enum' }}"
                  class="param-input param-picker"
                  style="width: 100%;"
                  mode="selector"
                  range="{{ param.options }}"
                  range-key="label"
                  value="{{ param.optionIndex }}"
                  data-command="{{ cmdItem.command }}"
                  data-param="{{ param.key }}"
                  bindchange="handleParamPick"
                >
                  <view class="picker-display">
                    <text class="picker-value mono">{{ param.optionLabel }}</text>
                    <text class="picker-arrow">⌄</text>
                  </view>
                </picker>

                <!-- 日期参数走日期选择器 -->
                <picker
                  wx:elif="{{ param.widgetType === 'date' }}"
                  class="param-input param-picker"
                  style="width: 100%;"
                  mode="date"
                  value="{{ param.value }}"
                  data-command="{{ cmdItem.command }}"
                  data-param="{{ param.key }}"
                  bindchange="handleParamDatePick"
                >
                  <view class="picker-display">
                    <text class="picker-value mono">{{ param.value }}</text>
                    <text class="picker-arrow">⌄</text>
                  </view>
                </picker>

                <!-- 普通输入 -->
                <input
                  wx:else
                  class="param-input mono"
                  type="{{ param.widgetType === 'number' ? 'digit' : 'text' }}"
                  data-command="{{ cmdItem.command }}"
                  data-param="{{ param.key }}"
                  value="{{ param.value }}"
                  placeholder="{{ param.default }}"
                  bindinput="handleParamInput"
                />

                <text class="param-unit" wx:if="{{ param.unit }}">{{ param.unit }}</text>
              </view>
            </view>

            <!-- 枚举项的行为说明：只显示当前选中项 -->
            <view class="param-hint" wx:for="{{ cmdItem.params }}" wx:for-item="param" wx:key="key" wx:if="{{ param.widgetType === 'enum' && param.optionDesc }}">
              <text class="param-hint-text">{{ param.optionDesc }}</text>
            </view>
          </block>

          <view class="command-actions">
            <button class="btn-set" data-command="{{ cmdItem.command }}" bindtap="handleSendCommand">设定</button>
          </view>
        </view>

        <!-- 底部安全提示 -->
        <view class="safety-banner anim-slide-up d2">
          <view class="safety-icon">!</view>
          <text class="safety-text">远程控制将直接作用于设备，请谨慎操作</text>
        </view>
      </view>
    </view>
  </view>
</template>

<script>
import { createPage } from '@mpxjs/core'
import { sendControlCommand, getDeviceCommands, getDeviceBySn } from '../../services/api/tenant'
import { useDeviceStore } from '../../stores/device'

createPage({
  data: {
    deviceSn: '',
    deviceId: null,
    deviceName: '',
    // 产品类别：flow_control=流量调节阀，pilot_reducing=先导减压阀
    productCategory: '',
    // 设备阀控类型（遗留字段，仅作 productCategory 缺失时的兜底）
    valveType: '',
    // 平台信息
    platformName: '',
    platformKind: '',
    // 设备支持的指令列表
    availableCommands: [],
    loadingCommands: true,
    // 参数值存储 { command: { paramKey: value } }
    paramValues: {},
    // 分时压力设置（总开关 + 5 个时段）
    timePressure: {
      enable: false,
      slots: [
        { id: 1, on: false, time: '00:00', pressure: '' },
        { id: 2, on: false, time: '00:00', pressure: '' },
        { id: 3, on: false, time: '00:00', pressure: '' },
        { id: 4, on: false, time: '00:00', pressure: '' },
        { id: 5, on: false, time: '00:00', pressure: '' }
      ]
    },
    // 主题（三档：light / dark / darker）
    themeClass: '',
    themeIcon: '☀️'
  },

  onLoad(options) {
    const { sn, deviceId, name } = options
    if (!sn || !deviceId) {
      wx.showToast({ title: '缺少设备参数', icon: 'none' })
      setTimeout(() => wx.navigateBack(), 1500)
      return
    }

    this.setData({
      deviceSn: sn,
      deviceId: parseInt(deviceId),
      deviceName: name || sn
    })

    // 先获取设备完整信息，再查询支持的指令
    this.loadDeviceInfo()
  },

  onShow() {
    // 恢复主题状态，保持与实时监控页一致
    const store = useDeviceStore()
    this.setData({ themeClass: store.themeClass, themeIcon: store.themeIcon })
  },

  methods: {
    // 加载设备完整信息（包含平台、产品等信息）
    async loadDeviceInfo() {
      try {
        const device = await getDeviceBySn(this.data.deviceSn)

        // 保存设备信息，用于后续判断平台类型
        this.deviceInfo = device

        // 产品类别以 product_category 为准（flow_control / pilot_reducing）。
        // 不用 device.valve_type：那是遗留字段，存量数据连流量阀也是默认值 "pilot"，
        // 用它判断会把流量阀当先导阀，误过滤掉设置开度等命令。
        const productCategory = device.product_category || ''

        this.setData({
          deviceName: device.name || this.data.deviceSn,
          productCategory: productCategory,
          valveType: device.valve_type || ''
        })

        console.log('设备信息:', {
          name: device.name,
          product_category: device.product_category,
          valve_type: device.valve_type,
          sn: device.sn,
          device_model: device.device_model
        })

        // 获取设备支持的指令列表
        this.loadAvailableCommands()

      } catch (e) {
        console.error('加载设备信息失败:', e)
        wx.showModal({
          title: '加载失败',
          content: '无法获取设备信息，请检查网络后重试',
          confirmText: '重试',
          cancelText: '返回',
          success: (res) => {
            if (res.confirm) {
              this.loadDeviceInfo()
            } else {
              wx.navigateBack()
            }
          }
        })
      }
    },

    // 加载设备支持的指令列表
    async loadAvailableCommands() {
      this.setData({ loadingCommands: true })
      try {
        const result = await getDeviceCommands(this.data.deviceSn)

        console.log('API返回数据:', result)

        // 解析返回的数据结构
        // { kind: "black-ant", platform: "black-ant", capability: { commands: [...] } }
        const platformKind = result.kind || result.platform || ''
        const platformName = platformKind === 'black-ant' ? '黑蚂蚁' : (platformKind === 'huawei-iotda' ? '华为IoTDA' : platformKind)
        let commands = result.capability && result.capability.commands ? result.capability.commands : []

        console.log('后端返回的指令列表:', commands)
        console.log('当前产品类别:', this.data.productCategory)
        console.log('当前阀控类型:', this.data.valveType)

        // 按设备类型过滤命令。优先使用 product_category，缺失时用 valve_type 兜底：
        // - flow / flow_control：流量调节阀，支持开度、周期、供暖日期、工作模式、回水温度、室温
        // - pilot / pilot_reducing：先导减压阀，支持周期、供暖日期、目标压力、分时压力
        const category = this.resolveDeviceCategory()
        if (category) {
          const allowed = this.getCommandsByCategory(category)
          const originalLength = commands.length
          commands = commands.filter(cmd => allowed.indexOf(cmd.command) !== -1)
          console.log(`${category} 过滤: ${originalLength} -> ${commands.length} 条命令`)

          // 先导阀：把压力设置相关命令固定排在最前面
          if (category === 'pilot_reducing') {
            commands = this.sortPilotCommands(commands)
          }
        } else {
          console.warn('无法识别设备类别，显示后端返回的全部命令')
        }

        // 初始化参数默认值：value 直接内联到每个 param 上供模板读取，
        // 同时保留 paramValues 映射供下发指令时取值。
        const paramValues = {}
        const normalizedCommands = commands.map(cmd => {
          paramValues[cmd.command] = {}
          const params = Array.isArray(cmd.params) ? cmd.params : []
          const nextParams = params.map(param => {
            // 根据命令类型规范化参数控件与单位：
            // - 工作模式强制走枚举选择器
            // - 周期参数单位统一为「分」
            // - 供暖日期强制走日期选择器
            const normalized = this.normalizeParam(cmd.command, param)
            const initial = normalized.default === undefined || normalized.default === null ? '' : String(normalized.default)

            // 枚举参数额外算三个展示字段：picker 只认下标，而下发要的是 options 里的 value。
            // 这里把「下标 / 选中项文案 / 选中项说明」一起内联到 param 上，
            // 因为 Mpx 模板里不能调 method 去现算（this 未绑定实例）。
            if (normalized.widgetType === 'enum' && Array.isArray(normalized.options) && normalized.options.length) {
              // 找不到与 default 相符的选项时落到第 0 项：宁可预选一个合法值，
              // 也不要让 picker 停在 -1（界面空白，用户不点就发出一个空 mode）。
              const idx = Math.max(0, normalized.options.findIndex(opt => opt.value === normalized.default))
              const picked = normalized.options[idx]
              paramValues[cmd.command][normalized.key] = picked.value
              return {
                ...normalized,
                value: picked.value,
                optionIndex: idx,
                optionLabel: picked.label,
                optionDesc: picked.description || ''
              }
            }

            // 日期参数：未给默认值时默认今天
            if (normalized.widgetType === 'date') {
              const dateValue = initial || this.formatDate(new Date())
              paramValues[cmd.command][normalized.key] = dateValue
              return { ...normalized, value: dateValue }
            }

            paramValues[cmd.command][normalized.key] = initial
            return { ...normalized, value: initial }
          })
          return { ...cmd, params: nextParams }
        })

        this.setData({
          availableCommands: normalizedCommands,
          platformName: platformName,
          platformKind: platformKind,
          paramValues: paramValues,
          loadingCommands: false
        })

      } catch (e) {
        console.error('加载设备支持指令失败:', e)
        this.setData({
          availableCommands: [],
          loadingCommands: false
        })

        wx.showModal({
          title: '加载失败',
          content: e.message || '无法获取设备控制功能',
          showCancel: false
        })
      }
    },

    // 参数输入：同时回写 paramValues（下发时取值）和 availableCommands 里的 value（模板显示）
    handleParamInput(e) {
      const { command, param } = e.currentTarget.dataset
      const value = e.detail.value

      const cmdIndex = this.data.availableCommands.findIndex(item => item.command === command)
      if (cmdIndex === -1) return
      const paramIndex = (this.data.availableCommands[cmdIndex].params || []).findIndex(item => item.key === param)
      if (paramIndex === -1) return

      this.setData({
        [`paramValues.${command}.${param}`]: value,
        [`availableCommands[${cmdIndex}].params[${paramIndex}].value`]: value
      })
    },

    // 枚举参数选择：picker 的 e.detail.value 是**下标**，不是候选值本身，
    // 必须换算成 options[idx].value 再回写 paramValues，否则下发的 mode 会是 0~3。
    handleParamPick(e) {
      const { command, param } = e.currentTarget.dataset
      const idx = Number(e.detail.value)

      const cmdIndex = this.data.availableCommands.findIndex(item => item.command === command)
      if (cmdIndex === -1) return
      const params = this.data.availableCommands[cmdIndex].params || []
      const paramIndex = params.findIndex(item => item.key === param)
      if (paramIndex === -1) return

      const picked = (params[paramIndex].options || [])[idx]
      if (!picked) return

      this.setData({
        [`paramValues.${command}.${param}`]: picked.value,
        [`availableCommands[${cmdIndex}].params[${paramIndex}].value`]: picked.value,
        [`availableCommands[${cmdIndex}].params[${paramIndex}].optionIndex`]: idx,
        [`availableCommands[${cmdIndex}].params[${paramIndex}].optionLabel`]: picked.label,
        [`availableCommands[${cmdIndex}].params[${paramIndex}].optionDesc`]: picked.description || ''
      })
    },

    // 日期参数选择
    handleParamDatePick(e) {
      const { command, param } = e.currentTarget.dataset
      const value = e.detail.value

      const cmdIndex = this.data.availableCommands.findIndex(item => item.command === command)
      if (cmdIndex === -1) return
      const params = this.data.availableCommands[cmdIndex].params || []
      const paramIndex = params.findIndex(item => item.key === param)
      if (paramIndex === -1) return

      this.setData({
        [`paramValues.${command}.${param}`]: value,
        [`availableCommands[${cmdIndex}].params[${paramIndex}].value`]: value
      })
    },

    // ========== 分时压力 ==========

    // 总开关切换：关闭时同时关闭所有时段开关，开启时不改变子开关状态
    onTimePressureEnableToggle(e) {
      const enable = !!e.detail.value
      const patch = { 'timePressure.enable': enable }
      if (!enable) {
        for (let i = 0; i < 5; i++) {
          patch[`timePressure.slots[${i}].on`] = false
        }
      }
      this.setData(patch)
    },

    // 单个时段开关切换：任一子开关开启则总开关自动开启；全部关闭则总开关自动关闭
    onTimePressureSlotToggle(e) {
      const idx = Number(e.currentTarget.dataset.idx)
      const on = !!e.detail.value
      const patch = { [`timePressure.slots[${idx}].on`]: on }
      if (on) {
        patch['timePressure.enable'] = true
      } else {
        const anyOn = this.data.timePressure.slots.some((s, i) => i !== idx && s.on)
        if (!anyOn) patch['timePressure.enable'] = false
      }
      this.setData(patch)
    },

    // 时段时间选择
    onTimePressureTime(e) {
      const idx = Number(e.currentTarget.dataset.idx)
      this.setData({ [`timePressure.slots[${idx}].time`]: e.detail.value })
    },

    // 时段压力输入
    onTimePressurePressure(e) {
      const idx = Number(e.currentTarget.dataset.idx)
      this.setData({ [`timePressure.slots[${idx}].pressure`]: e.detail.value })
    },

    // 把 timePressure 对象转换为后端下发的参数对象。
    // 格式与租户端一致：{ enabled, en1..5, time1..5, ps1..5 }，ps 单位为 MPa，
    // 后端接口负责将 MPa 转换为 KPa 再传给黑蚂蚁平台。
    buildTimePressureParams() {
      const { enable, slots } = this.data.timePressure
      const params = { enabled: enable ? 1 : 0 }
      for (let i = 0; i < 5; i++) {
        const s = slots[i]
        params[`en${i + 1}`] = s.on ? 1 : 0
        if (s.on) {
          params[`time${i + 1}`] = s.time
          params[`ps${i + 1}`] = Number(s.pressure)
        }
      }
      return params
    },

    // 发送控制指令
    async handleSendCommand(e) {
      const commandName = e.currentTarget.dataset.command

      // 找到对应的命令配置
      const commandConfig = this.data.availableCommands.find(cmd => cmd.command === commandName)
      if (!commandConfig) {
        wx.showToast({ title: '指令配置错误', icon: 'none' })
        return
      }

      let params = {}

      // 分时压力：使用独立的 timePressure 数据构造参数
      if (commandName === 'setTimePressure') {
        const { enable, slots } = this.data.timePressure
        const active = []

        for (let i = 0; i < 5; i++) {
          const s = slots[i]
          if (!s.on) continue
          if (!s.time) {
            wx.showToast({ title: `时段${i + 1} 未选择时间`, icon: 'none' })
            return
          }
          const v = Number(s.pressure) || 0
          // 前端输入单位为 MPa，与后端校验范围一致（0~2.5 MPa）
          if (v <= 0 || v > 2.5) {
            wx.showToast({ title: `时段${i + 1} 压力需在 0~2.5 MPa 之间`, icon: 'none' })
            return
          }
          const [h, m] = String(s.time).split(':').map(Number)
          active.push({ idx: i, min: h * 60 + m })
        }

        if (enable && !active.length) {
          wx.showToast({ title: '请至少启用一个时段', icon: 'none' })
          return
        }

        for (let k = 1; k < active.length; k++) {
          if (active[k].min <= active[k - 1].min) {
            wx.showToast({ title: '时段时间需按先后递增', icon: 'none' })
            return
          }
        }

        params = this.buildTimePressureParams()
      } else {
        // 普通参数：从 paramValues 取值并校验
        const commandValues = this.data.paramValues[commandName] || {}

        if (commandConfig.params && Array.isArray(commandConfig.params)) {
          for (const paramDef of commandConfig.params) {
            const value = commandValues[paramDef.key]

            // 参数验证
            if (value === '' || value === undefined) {
              wx.showToast({ title: `请输入${paramDef.label}`, icon: 'none' })
              return
            }

            // 类型转换
            if (paramDef.type === 'number') {
              params[paramDef.key] = Number(value)
              if (isNaN(params[paramDef.key])) {
                wx.showToast({ title: `${paramDef.label}必须是数字`, icon: 'none' })
                return
              }
            } else if (paramDef.type === 'enum') {
              // 枚举值原样发送：字典里 value 本身已是设备要的类型（工作模式是数字 129~132），
              // 统一 Number() 会把将来出现的字符串枚举压成 NaN。
              params[paramDef.key] = value
            } else {
              params[paramDef.key] = value
            }
          }
        }
      }

      // 二次确认
      const confirm = await this.showConfirm(`确定执行【${commandConfig.name}】吗？`)
      if (!confirm) return

      // 发送指令
      wx.showLoading({ title: '指令下发中...', mask: true })

      try {
        await sendControlCommand(this.data.deviceId, commandName, params)

        wx.hideLoading()
        wx.showToast({ title: '指令下发成功', icon: 'success' })

      } catch (e) {
        wx.hideLoading()
        wx.showModal({
          title: '指令下发失败',
          content: e.message || '请检查网络连接后重试',
          showCancel: false
        })
      }
    },

    // 跳转到历史记录页面
    goHistory() {
      wx.navigateTo({
        url: `/pages/control-history/index?deviceId=${this.data.deviceId}&sn=${encodeURIComponent(this.data.deviceSn)}&name=${encodeURIComponent(this.data.deviceName)}`
      })
    },

    // 切换主题（三档循环）
    toggleTheme() {
      const store = useDeviceStore()
      store.toggleDarkMode()
      this.setData({ themeClass: store.themeClass, themeIcon: store.themeIcon })
    },

    // 解析设备类别：优先 product_category，缺失时用 valve_type 兜底
    resolveDeviceCategory() {
      const productCategory = this.data.productCategory
      if (productCategory === 'flow_control' || productCategory === 'pilot_reducing') {
        return productCategory
      }

      const valveType = this.data.valveType
      if (valveType === 'flow') return 'flow_control'
      if (valveType === 'pilot') return 'pilot_reducing'

      return ''
    },

    // 获取指定设备类别允许下发的命令名列表
    getCommandsByCategory(category) {
      const COMMANDS_BY_CATEGORY = {
        flow_control: ['setOpening', 'setCycle', 'setHeatDate', 'setWorkMode', 'setReturnTemp', 'setRoomTemp'],
        pilot_reducing: ['setCycle', 'setHeatDate', 'setPressure', 'setTimePressure']
      }
      return COMMANDS_BY_CATEGORY[category] || []
    },

    // 先导阀命令排序：压力设置命令固定排在最前面
    sortPilotCommands(commands) {
      const priority = ['setPressure', 'setTimePressure']
      const priorityCommands = []
      const otherCommands = []

      commands.forEach(cmd => {
        if (priority.indexOf(cmd.command) !== -1) {
          priorityCommands.push(cmd)
        } else {
          otherCommands.push(cmd)
        }
      })

      priorityCommands.sort((a, b) => priority.indexOf(a.command) - priority.indexOf(b.command))
      return [...priorityCommands, ...otherCommands]
    },

    // 规范化参数：根据命令类型强制指定控件类型与单位
    normalizeParam(command, param) {
      const WORK_MODE_OPTIONS = [
        { label: '通断模式', value: 129, description: '阀门只能全开(100)或全关(0)' },
        { label: '回水模式', value: 130, description: '根据回水温度自动调节阀门开度' },
        { label: '室温模式', value: 131, description: '根据室内温度自动调节阀门开度' },
        { label: '流量平衡模式', value: 132, description: '可设置任意开度(0-100)，用于流量平衡调节' },
        { label: '停止', value: 137, description: '' }
      ]

      // 设置工作模式：强制使用枚举选择器
      if (command === 'setWorkMode') {
        const options = (param.type === 'enum' && Array.isArray(param.options) && param.options.length)
          ? param.options
          : WORK_MODE_OPTIONS
        return {
          ...param,
          type: 'enum',
          widgetType: 'enum',
          options,
          label: param.label || '工作模式'
        }
      }

      // 设置周期：单位统一为「分」，标签去掉后端可能带的「(秒)/（秒）」字样
      if (command === 'setCycle') {
        let label = param.label || '上报周期'
        label = label.replace(/[（(]?\s*秒\s*[)）]?/g, '').replace(/[（(]?\s*分\s*[)）]?/g, '').trim() || '上报周期'
        return {
          ...param,
          type: 'number',
          widgetType: 'number',
          unit: '分',
          label
        }
      }

      // 设置压力：单位统一为「MPa」，标签去掉后端可能带的「(KPa)」字样
      if (command === 'setPressure') {
        let label = param.label || '设置压力'
        label = label.replace(/[（(]?\s*[Kk][Pp][Aa]\s*[)）]?/g, '').replace(/[（(]?\s*[Mm][Pp][Aa]\s*[)）]?/g, '').trim() || '设置压力'
        return {
          ...param,
          type: 'number',
          widgetType: 'number',
          unit: 'MPa',
          label
        }
      }

      // 设置供暖日期：强制使用日期选择器
      if (command === 'setHeatDate') {
        return {
          ...param,
          type: 'date',
          widgetType: 'date',
          label: param.label || '供暖日期'
        }
      }

      // 默认：保持后端类型
      return {
        ...param,
        widgetType: param.type === 'enum' ? 'enum' : (param.type === 'number' ? 'number' : 'text')
      }
    },

    // 格式化日期为 YYYY-MM-DD
    formatDate(date) {
      const year = date.getFullYear()
      const month = String(date.getMonth() + 1).padStart(2, '0')
      const day = String(date.getDate()).padStart(2, '0')
      return `${year}-${month}-${day}`
    },

    // 显示确认对话框
    showConfirm(content) {
      return new Promise((resolve) => {
        wx.showModal({
          title: '确认操作',
          content,
          success: (res) => {
            resolve(res.confirm)
          }
        })
      })
    }
  }
})
</script>

<style scoped>
/* ==================== 工业机械风 · 远程阀门控制页 ====================
   取色只走 app.mpx 语义变量（--color-* / --grad-* / --deco-*），本页不硬编码主题色；
   明档随 page 主题、暗档随根节点 .dark class 自动切换，局部暗档补丁见文末。 */
.control-container {
  min-height: 100vh;
  padding-bottom: 40rpx;
  /* 底色与拉丝金属纹理由 page 层主题（app.mpx）提供 */
}

/* ==================== 动画定义 ==================== */
@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(40rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes rotate {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.anim-fade-in {
  animation: fadeIn 0.5s ease-out;
}

.anim-slide-up {
  animation: slideUp 0.6s cubic-bezier(0.22, 0.9, 0.32, 1);
}

.anim-slide-up.d1 {
  animation-delay: 0.1s;
  opacity: 0;
  animation-fill-mode: forwards;
}

.anim-slide-up.d2 {
  animation-delay: 0.2s;
  opacity: 0;
  animation-fill-mode: forwards;
}

/* ==================== Hero：金属铭牌面板（riveted 四角铆钉） ==================== */
.hero-section {
  position: relative;
