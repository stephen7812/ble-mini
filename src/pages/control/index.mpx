  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.25);
  transition: transform 0.15s ease, filter 0.15s ease;
}

.btn-set::after {
  border: none;
}

.btn-set:active {
  transform: scale(0.96) translateY(2rpx);
  filter: brightness(0.94);
}

/* ==================== 分时压力：金属拨杆 + 时段子面板 ==================== */
/* 总开关行：凸起金属条 + 状态 LED（原生 switch 拨杆工业化见非 scoped 区） */
.tp-main-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 24rpx;
  padding: 20rpx 24rpx;
  background: var(--color-panel-2);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-sm);
  box-shadow:
    inset 2rpx 2rpx 0 var(--color-highlight),
    inset -2rpx -2rpx 0 rgba(0, 0, 0, 0.1);
}

.tp-main-label {
  flex: 1;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text);
  letter-spacing: 2rpx;
}

.tp-main-switch {
  transform: scale(0.85);
}

.tp-slots {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

/* 时段模块：内凹安装槽 */
.tp-slot {
  background: var(--color-panel-2);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-sm);
  box-shadow: inset 2rpx 2rpx 4rpx var(--color-input-inset);
  padding: 20rpx;
  transition: opacity 0.2s ease;
}

.tp-slot.tp-disabled {
  opacity: 0.55;
}

.tp-slot-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.tp-slot-title {
  flex: 1;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-text);
  letter-spacing: 1rpx;
}

.tp-slot-switch {
  transform: scale(0.75);
}

.tp-slot-body {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.tp-time-picker {
  flex-shrink: 0;
}

/* 时间读数：DIN 数码管（模板挂全局 .mono） */
.tp-time-val {
  width: 150rpx;
  height: 76rpx;
  line-height: 72rpx;
  text-align: center;
  background: var(--color-panel-3);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-sm);
  box-shadow: inset 2rpx 2rpx 4rpx var(--color-input-inset);
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text);
  letter-spacing: 2rpx;
}

.tp-time-val.tp-off {
  color: var(--color-text-tertiary);
}

.tp-pressure-wrap {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

/* 压力输入：内凹数码槽（模板挂全局 .mono） */
.tp-pressure-input {
  flex: 1;
  min-width: 0;
  height: 76rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  background: var(--color-panel-3);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-sm);
  box-shadow: inset 2rpx 2rpx 4rpx var(--color-input-inset);
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text);
  text-align: left;
}

.tp-pressure-input:focus {
  border-color: var(--color-primary);
}

.tp-pressure-unit {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
  flex-shrink: 0;
}

/* ==================== 安全提示：琥珀警戒条 ==================== */
.safety-banner {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 28rpx;
  margin-top: 8rpx;
  background: rgba(214, 131, 10, 0.08);
  border: 2rpx var(--panel-border-style) rgba(214, 131, 10, 0.45);
  border-radius: var(--radius-lg);
  box-shadow:
    inset 2rpx 2rpx 0 var(--color-highlight),
    var(--shadow-card);
}

/* 警示图标：黄黑斜纹铭牌 */
.safety-icon {
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-sm);
  border: 2rpx solid rgba(0, 0, 0, 0.25);
  background: repeating-linear-gradient(-45deg, var(--color-warning) 0 12rpx, rgba(0, 0, 0, 0.55) 12rpx 24rpx);
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 700;
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.4);
}

.safety-text {
  flex: 1;
  font-size: 24rpx;
  color: var(--color-warning);
  line-height: 1.5;
  font-weight: 600;
  letter-spacing: 1rpx;
}

/* ==================== 暗档补丁：提亮橙色光效（面板/边框/文字由变量自动切换） ==================== */
.control-container.dark .btn-set {
  box-shadow:
    inset 2rpx 2rpx 0 rgba(255, 255, 255, 0.3),
    inset -2rpx -2rpx 0 rgba(0, 0, 0, 0.25),
    0 6rpx 16rpx rgba(255, 138, 30, 0.35);
}

.control-container.dark .safety-banner {
  background: rgba(255, 176, 32, 0.08);
  border-color: rgba(255, 176, 32, 0.4);
}
</style>

<style>
/* 旋转动画 - 供 loading-spinner 使用 */
@keyframes spinAnim {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* 分时压力开关：金属拨杆工业化。
   原生 switch 内部节点（.wx-switch-input）拿不到 scoped 属性，须在非 scoped 区覆盖：
   关闭 = 钢灰拨杆槽；开启 = 工业橙 LED 拨杆。 */
.tp-main-switch .wx-switch-input,
.tp-slot-switch .wx-switch-input {
  background: var(--color-track) !important;
  border: 2rpx solid var(--color-border) !important;
  box-shadow: inset 0 2rpx 4rpx var(--color-input-inset) !important;
}

.tp-main-switch .wx-switch-input.checked,
.tp-slot-switch .wx-switch-input.checked {
  background: var(--color-primary) !important;
  border-color: var(--color-primary) !important;
  box-shadow: 0 0 12rpx rgba(232, 115, 10, 0.5) !important;
}

.control-container.dark .tp-main-switch .wx-switch-input.checked,
.control-container.dark .tp-slot-switch .wx-switch-input.checked {
  box-shadow: 0 0 14rpx rgba(255, 138, 30, 0.55) !important;
}
</style>

