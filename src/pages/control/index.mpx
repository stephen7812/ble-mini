<template>
  <view class="control-page">
    <!-- 设备信息头部 -->
    <view class="device-header">
      <view class="device-title">
        <text class="device-name">{{ deviceName }}</text>
        <text class="device-sn">SN: {{ deviceSn }}</text>
      </view>
    </view>

    <!-- 快捷控制卡片 -->
    <view class="control-section">
      <view class="section-title">快捷控制</view>

      <!-- 开度调节 -->
      <view class="control-card">
        <view class="card-header">
          <text class="card-title">开度调节</text>
          <text class="card-hint">当前: {{ currentOpenness }}%</text>
        </view>
        <view class="card-body">
          <slider value="{{ targetOpenness }}" min="0" max="100" show-value bindchange="handleOpennessChange" />
          <view class="slider-value">目标: {{ targetOpenness }}%</view>
        </view>
        <view class="card-actions">
          <button class="btn-small btn-cancel" bindtap="resetOpenness">重置</button>
          <button class="btn-small btn-confirm" bindtap="handleSetOpenness">确认调节</button>
        </view>
      </view>

      <!-- 压力设定 -->
      <view class="control-card">
        <view class="card-header">
          <text class="card-title">压力设定</text>
          <text class="card-hint">当前: {{ currentPressure }} MPa</text>
        </view>
        <view class="card-body">
          <view class="input-row">
            <text class="input-label">目标压力</text>
            <input
              class="input-field"
              type="digit"
              value="{{ targetPressure }}"
              placeholder="请输入压力值"
              bindinput="handlePressureInput"
            />
            <text class="input-unit">MPa</text>
          </view>
          <text class="input-hint">范围: 0.0 ~ 1.6 MPa</text>
        </view>
        <view class="card-actions">
          <button class="btn-small btn-cancel" bindtap="resetPressure">重置</button>
          <button class="btn-small btn-confirm" bindtap="handleSetPressure">确认设定</button>
        </view>
      </view>

      <!-- 温度设定 -->
      <view class="control-card">
        <view class="card-header">
          <text class="card-title">温度设定</text>
          <text class="card-hint">当前: {{ currentTemperature }}°C</text>
        </view>
        <view class="card-body">
          <view class="input-row">
            <text class="input-label">目标温度</text>
            <input
              class="input-field"
              type="digit"
              value="{{ targetTemperature }}"
              placeholder="请输入温度值"
              bindinput="handleTemperatureInput"
            />
            <text class="input-unit">°C</text>
          </view>
          <text class="input-hint">范围: 5 ~ 95°C</text>
        </view>
        <view class="card-actions">
          <button class="btn-small btn-cancel" bindtap="resetTemperature">重置</button>
          <button class="btn-small btn-confirm" bindtap="handleSetTemperature">确认设定</button>
        </view>
      </view>
    </view>

    <!-- 历史操作记录 -->
    <view class="history-section" wx:if="{{ taskList.length > 0 }}">
      <view class="section-title">历史操作</view>
      <view class="task-list">
        <view class="task-item" wx:for="{{ taskList }}" wx:key="id">
          <view class="task-info">
            <text class="task-command">{{ formatCommand(item.command) }}</text>
            <text class="task-params">{{ formatParams(item.params) }}</text>
            <text class="task-time">{{ formatTime(item.executed_at || item.created_at) }}</text>
          </view>
          <view class="task-status" :class="getStatusClass(item.status)">
            {{ getStatusText(item.status) }}
          </view>
        </view>
      </view>
    </view>

    <!-- 底部安全提示 -->
    <view class="safety-notice">
      <text class="notice-icon">⚠️</text>
      <text class="notice-text">远程控制将直接作用于设备，请谨慎操作</text>
    </view>
  </view>
</template>

<script>
import { createPage } from '@mpxjs/core'
import { sendControlCommand, getControlTaskList, getDeviceRealtime } from '../../services/api/tenant'

createPage({
  data: {
    deviceSn: '',
    deviceId: null,
    deviceName: '',
    // 当前值（从实时数据获取）
    currentOpenness: '-',
    currentPressure: '-',
    currentTemperature: '-',
    // 目标值（用户输入）
    targetOpenness: 50,
    targetPressure: '',
    targetTemperature: '',
    // 操作历史
    taskList: []
  },

  onLoad(options) {
    const { sn, deviceId, name } = options
    if (!sn || !deviceId) {
      wx.showToast({ title: '缺少设备参数', icon: 'none' })
      setTimeout(() => wx.navigateBack(), 1500)
      return
    }

    this.setData({
      deviceSn: sn,
      deviceId: parseInt(deviceId),
      deviceName: name || sn
    })

    // 加载设备当前状态
    this.loadDeviceStatus()
    // 加载操作历史
    this.loadTaskHistory()
  },

  methods: {
    // 加载设备当前状态
    async loadDeviceStatus() {
      try {
        const data = await getDeviceRealtime(this.data.deviceSn)
        if (data && data.data) {
          this.setData({
            currentOpenness: data.data.openness != null ? data.data.openness : '-',
            currentPressure: data.data.pressure != null ? data.data.pressure.toFixed(1) : '-',
            currentTemperature: data.data.temp_set != null ? data.data.temp_set.toFixed(1) : '-',
            targetOpenness: data.data.openness != null ? data.data.openness : this.data.targetOpenness
          })
        }
      } catch (e) {
        console.error('加载设备状态失败:', e)
      }
    },

    // 加载操作历史
    async loadTaskHistory() {
      try {
        const result = await getControlTaskList(1, 10)
        // 只显示当前设备的任务
        this.setData({
          taskList: (result.list || []).filter(task => task.device_sn === this.data.deviceSn)
        })
      } catch (e) {
        console.error('加载操作历史失败:', e)
      }
    },

    // 开度滑块变化
    handleOpennessChange(e) {
      this.setData({ targetOpenness: e.detail.value })
    },

    // 压力输入
    handlePressureInput(e) {
      this.setData({ targetPressure: e.detail.value })
    },

    // 温度输入
    handleTemperatureInput(e) {
      this.setData({ targetTemperature: e.detail.value })
    },

    // 重置开度
    resetOpenness() {
      if (this.data.currentOpenness !== '-') {
        this.setData({ targetOpenness: this.data.currentOpenness })
      }
    },

    // 重置压力
    resetPressure() {
      this.setData({ targetPressure: '' })
    },

    // 重置温度
    resetTemperature() {
      this.setData({ targetTemperature: '' })
    },

    // 设置开度
    async handleSetOpenness() {
      const openness = parseInt(this.data.targetOpenness)

      // 二次确认
      const confirm = await this.showConfirm(`确定将开度调节至 ${openness}% 吗？`)
      if (!confirm) return

      await this.sendCommand('set_openness', { openness })
    },

    // 设置压力
    async handleSetPressure() {
      const pressure = parseFloat(this.data.targetPressure)

      // 参数校验
      if (isNaN(pressure)) {
        wx.showToast({ title: '请输入有效的压力值', icon: 'none' })
        return
      }
      if (pressure < 0 || pressure > 1.6) {
        wx.showToast({ title: '压力值范围: 0.0 ~ 1.6 MPa', icon: 'none' })
        return
      }

      // 二次确认
      const confirm = await this.showConfirm(`确定将目标压力设定为 ${pressure.toFixed(2)} MPa 吗？`)
      if (!confirm) return

      // 注意：这里需要确认后端接受的单位是 MPa 还是 kPa
      // 如果后端要 kPa，需要乘以 1000
      await this.sendCommand('set_pressure', { pressure })
    },

    // 设置温度
    async handleSetTemperature() {
      const temperature = parseFloat(this.data.targetTemperature)

      // 参数校验
      if (isNaN(temperature)) {
        wx.showToast({ title: '请输入有效的温度值', icon: 'none' })
        return
      }
      if (temperature < 5 || temperature > 95) {
        wx.showToast({ title: '温度值范围: 5 ~ 95°C', icon: 'none' })
        return
      }

      // 二次确认
      const confirm = await this.showConfirm(`确定将目标温度设定为 ${temperature.toFixed(1)}°C 吗？`)
      if (!confirm) return

      await this.sendCommand('set_temperature', { temperature })
    },

    // 发送控制指令（统一处理）
    async sendCommand(command, params) {
      wx.showLoading({ title: '指令下发中...', mask: true })

      try {
        await sendControlCommand(this.data.deviceId, command, params)

        wx.hideLoading()
        wx.showToast({ title: '指令下发成功', icon: 'success' })

        // 刷新操作历史
        setTimeout(() => this.loadTaskHistory(), 500)

        // 延迟刷新设备数据（等待设备执行）
        setTimeout(() => this.loadDeviceStatus(), 3000)

      } catch (e) {
        wx.hideLoading()
        wx.showModal({
          title: '指令下发失败',
          content: e.message || '请检查网络连接后重试',
          showCancel: false
        })
      }
    },

    // 显示确认对话框
    showConfirm(content) {
      return new Promise((resolve) => {
        wx.showModal({
          title: '确认操作',
          content,
          success: (res) => {
            resolve(res.confirm)
          }
        })
      })
    },

    // 格式化命令名称
    formatCommand(command) {
      const commandMap = {
        'set_openness': '开度调节',
        'set_pressure': '压力设定',
        'set_temperature': '温度设定'
      }
      return commandMap[command] || command
    },

    // 格式化参数
    formatParams(paramsJson) {
      if (!paramsJson) return ''
      try {
        const params = JSON.parse(paramsJson)
        if (params.openness != null) return `${params.openness}%`
        if (params.pressure != null) return `${params.pressure} MPa`
        if (params.temperature != null) return `${params.temperature}°C`
        return JSON.stringify(params)
      } catch (e) {
        return paramsJson
      }
    },

    // 格式化时间
    formatTime(timestamp) {
      if (!timestamp) return ''
      const date = new Date(timestamp * 1000)
      return `${date.getMonth() + 1}-${date.getDate()} ${date.getHours()}:${String(date.getMinutes()).padStart(2, '0')}`
    },

    // 获取状态样式类
    getStatusClass(status) {
      if (status === 1) return 'status-success'
      if (status === 3 || status === 4) return 'status-fail'
      return 'status-pending'
    },

    // 获取状态文本
    getStatusText(status) {
      const statusMap = {
        0: '待执行',
        1: '成功',
        3: '失败',
        4: '已取消'
      }
      return statusMap[status] || '未知'
    }
  }
})
</script>

<style lang="stylus">
.control-page
  min-height 100vh
  background-color #f5f5f5
  padding-bottom 100rpx

.device-header
  background-color #fff
  padding 30rpx
  border-bottom 1px solid #e5e5e5

.device-title
  display flex
  align-items baseline

.device-name
  font-size 36rpx
  font-weight bold
  color #333
  margin-right 20rpx

.device-sn
  font-size 24rpx
  color #999

.control-section
  margin-top 20rpx

.section-title
  padding 20rpx 30rpx
  font-size 28rpx
  font-weight bold
  color #333
  background-color #fff

.control-card
  background-color #fff
  margin-bottom 20rpx
  padding 30rpx

.card-header
  display flex
  justify-content space-between
  align-items center
  margin-bottom 30rpx

.card-title
  font-size 32rpx
  font-weight bold
  color #333

.card-hint
  font-size 24rpx
  color #999

.card-body
  margin-bottom 30rpx

.slider-value
  text-align center
  font-size 28rpx
  color #1890ff
  margin-top 20rpx

.input-row
  display flex
  align-items center
  margin-bottom 15rpx

.input-label
  font-size 28rpx
  color #666
  width 150rpx

.input-field
  flex 1
  height 70rpx
  padding 0 20rpx
  border 1px solid #d9d9d9
  border-radius 8rpx
  font-size 28rpx

.input-unit
  font-size 24rpx
  color #999
  margin-left 15rpx
  width 80rpx

.input-hint
  font-size 24rpx
  color #999
  padding-left 150rpx

.card-actions
  display flex
  gap 20rpx

.btn-small
  flex 1
  height 70rpx
  line-height 70rpx
  border-radius 8rpx
  font-size 28rpx
  text-align center
  border none

.btn-cancel
  background-color #fff
  color #666
  border 1px solid #d9d9d9
  &:active
    background-color #fafafa

.btn-confirm
  background-color #1890ff
  color #fff
  &:active
    background-color #096dd9

.history-section
  margin-top 20rpx

.task-list
  background-color #fff

.task-item
  display flex
  justify-content space-between
  align-items center
  padding 30rpx
  border-bottom 1px solid #f0f0f0
  &:last-child
    border-bottom none

.task-info
  flex 1
  display flex
  flex-direction column
  gap 10rpx

.task-command
  font-size 28rpx
  color #333
  font-weight bold

.task-params
  font-size 26rpx
  color #666

.task-time
  font-size 24rpx
  color #999

.task-status
  padding 10rpx 20rpx
  border-radius 4rpx
  font-size 24rpx
  &.status-success
    background-color #f6ffed
    color #52c41a
  &.status-fail
    background-color #fff2f0
    color #ff4d4f
  &.status-pending
    background-color #e6f7ff
    color #1890ff

.safety-notice
  display flex
  align-items center
  justify-content center
  padding 30rpx
  margin-top 20rpx
  background-color #fffbe6
  border 1px solid #ffe58f
  border-radius 8rpx
  margin 20rpx 30rpx

.notice-icon
  font-size 32rpx
  margin-right 15rpx

.notice-text
  font-size 24rpx
  color #d48806
</style>
