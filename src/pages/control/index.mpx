.notice-text
  font-size 24rpx
  color #d48806
</style>

<style>
/* 旋转动画 - 使用纯CSS避免Stylus添加-moz-前缀 */
@keyframes spinAnim {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}
</style>

<script type="application/json">
{
  "navigationBarTitleText": "远程控制",
  "navigationBarBackgroundColor": "#ffffff",
  "navigationBarTextStyle": "black"
}
</script>
