<template>
  <view class="page {{themeClass}}">
    <!-- 品牌头图：工业机壳顶盖（拉丝金属 + 沉头螺丝） -->
    <view class="hero anim-item d1">
      <view class="hero-screws"></view>
      <!-- 纯 CSS 阀门手轮 Logo：外环 + 十字辐条，呼应智能阀门业务 -->
      <view class="logo-ring">
        <view class="logo-mark">
          <view class="logo-spoke v"></view>
          <view class="logo-spoke h"></view>
          <view class="logo-hub"></view>
        </view>
      </view>
      <text class="title">设备管理</text>
      <text class="subtitle">正丰智能 · 现场作业平台</text>
      <text class="nameplate mono">ACCESS TERMINAL</text>
    </view>

    <!-- 登录面板：铆接金属控制面板，上浮叠压机壳顶盖 -->
    <view class="card login-card riveted anim-item d2">
      <!-- 面板状态灯：绿=就绪 / 琥珀=登录中 / 红=报错 -->
      <view class="led login-led {{loading ? 'warn' : (errorMsg ? 'err' : 'on')}}"></view>
      <text class="login-title">账号登录</text>
      <text class="login-sub">请使用租户端账号登录</text>

      <view class="field-group">
        <view class="field-label">用户名</view>
        <view class="field-wrap {{focusField === 'username' ? 'focused' : ''}}">
          <input
            class="field-input"
            model:value="{{username}}"
            placeholder="请输入用户名"
            placeholder-class="field-placeholder"
            data-field="username"
            bindfocus="onFieldFocus"
            bindblur="onFieldBlur"
          />
        </view>
      </view>

      <view class="field-group">
        <view class="field-label">密码</view>
        <view class="field-wrap {{focusField === 'password' ? 'focused' : ''}}">
          <input
            class="field-input"
            model:value="{{password}}"
            password
            placeholder="请输入密码"
            placeholder-class="field-placeholder"
            data-field="password"
            bindfocus="onFieldFocus"
            bindblur="onFieldBlur"
            bindconfirm="handleLogin"
          />
        </view>
      </view>

      <view class="error-pill" wx:if="{{errorMsg}}">
        <view class="led err"></view>
        <text class="error">{{errorMsg}}</text>
      </view>

      <button class="login-btn" loading="{{loading}}" disabled="{{loading}}" bindtap="handleLogin">
        {{loading ? '登录中' : '登 录'}}
      </button>
    </view>

    <text class="footer anim-item d3">登录即代表同意现场作业管理规范</text>
  </view>
</template>

<script>
import { createPage } from '@mpxjs/core'
import { useAuthStore } from '../../stores/auth'
import { useDeviceStore } from '../../stores/device'

createPage({
  data: { username: '', password: '', loading: false, errorMsg: '', themeClass: '', themeIcon: '☀️', focusField: '' },

  onShow() {
    const store = useDeviceStore()
    this.setData({ themeClass: store.themeClass, themeIcon: store.themeIcon })
  },

  onFieldFocus(e) {
    this.setData({ focusField: e.currentTarget.dataset.field || '' })
  },

  onFieldBlur() {
    this.setData({ focusField: '' })
  },

  async handleLogin() {
    // 已在请求中时直接忽略，避免连点发出两次登录
    if (this.data.loading) return

    const username = (this.data.username || '').trim()
    const password = this.data.password || ''
    if (!username || !password) {
      this.setData({ errorMsg: '请输入用户名和密码' })
      return
    }

    this.setData({ loading: true, errorMsg: '' })
    try {
      await useAuthStore().login(username, password)
      // redirectTo 而不是 navigateTo：登录页不该留在返回栈里，
      // 否则用户在首页点返回会退回一个已经登录过的登录页。
      wx.redirectTo({ url: '/pages/index/index' })
    } catch (err) {
      // 后端的文案已经足够具体（用户不存在 / 密码错误 / 租户已被禁用），原样展示
      this.setData({ errorMsg: err.message || '登录失败' })
    } finally {
      this.setData({ loading: false })
    }
  },
})
</script>

<style scoped>
.page { min-height: 100vh; box-sizing: border-box; padding: 0 32rpx 48rpx; }

/* ========== 入场动画 ========== */
.anim-item { opacity: 0; animation: fadeUp .55s cubic-bezier(.22, .9, .32, 1) forwards; }
.d1 { animation-delay: .02s; }
.d2 { animation-delay: .12s; }
.d3 { animation-delay: .24s; }
@keyframes fadeUp {
  from { opacity: 0; transform: translateY(32rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* ========== 品牌头图：工业机壳顶盖 ========== */
.hero {
  position: relative; overflow: hidden;
  display: flex; flex-direction: column; align-items: center;
  margin: 0 -32rpx; padding: 96rpx 40rpx 128rpx;
  background: linear-gradient(170deg, var(--color-panel-3) 0%, var(--color-bg-secondary) 55%, var(--color-panel-2) 100%);
  border-bottom: 2rpx var(--panel-border-style) var(--color-border);
  border-radius: 0 0 var(--radius-lg) var(--radius-lg);
  box-shadow: inset 2rpx 2rpx 0 var(--color-highlight), inset 0 -6rpx 12rpx var(--color-input-inset);
}
/* 顶盖沉头螺丝（底部两颗被登录面板压住，只画顶部） */
.hero-screws { position: absolute; inset: 0; pointer-events: none; }
.hero-screws::before,
.hero-screws::after {
  content: ''; position: absolute; top: 28rpx; width: 16rpx; height: 16rpx;
  border-radius: 50%;
  background: radial-gradient(circle, var(--deco-rivet) 0 5rpx, var(--deco-rivet-shadow) 5.5rpx 7rpx, transparent 8rpx);
}
.hero-screws::before { left: 32rpx; }
.hero-screws::after { right: 32rpx; }

/* Logo：金属座圈 + 橙色阀门手轮，通电呼吸辉光 */
.logo-ring {
  position: relative;
  width: 152rpx; height: 152rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  background: var(--color-fill);
  border: 2rpx solid var(--color-border-strong);
  animation: logoBreath 3.2s ease-in-out infinite;
}
@keyframes logoBreath {
  0%, 100% { box-shadow: 0 0 8rpx 2rpx var(--color-primary); }
  50% { box-shadow: 0 0 26rpx 6rpx var(--color-primary); }
}
.logo-mark {
  position: relative; width: 84rpx; height: 84rpx;
  border: 7rpx solid var(--color-primary); border-radius: 50%;
  box-shadow: 0 3rpx 8rpx rgba(0, 0, 0, 0.18);
}
.logo-spoke { position: absolute; background: var(--color-primary); border-radius: 4rpx; }
.logo-spoke.v { left: 50%; top: -7rpx; bottom: -7rpx; width: 7rpx; margin-left: -3.5rpx; }
.logo-spoke.h { top: 50%; left: -7rpx; right: -7rpx; height: 7rpx; margin-top: -3.5rpx; }
.logo-hub {
  position: absolute; left: 50%; top: 50%;
  width: 22rpx; height: 22rpx; margin: -11rpx 0 0 -11rpx;
  border-radius: 50%; background: var(--color-bg);
  border: 3rpx solid var(--color-border-strong);
  box-shadow: inset 1rpx 1rpx 0 var(--color-highlight);
}

.title {
  margin-top: 36rpx; font-size: 52rpx; font-weight: 700;
  color: var(--color-text); letter-spacing: 4rpx;
  text-shadow: 0 1rpx 0 var(--color-highlight);
}
.subtitle { margin-top: 14rpx; font-size: 24rpx; color: var(--color-text-secondary); letter-spacing: 2rpx; }

/* 英文小铭牌 */
.nameplate {
  display: inline-block; margin-top: 28rpx; padding: 8rpx 30rpx;
  border: 2rpx var(--panel-border-style) var(--color-border);
  border-radius: var(--radius-sm);
  background: var(--color-fill);
  box-shadow: inset 1rpx 1rpx 0 var(--color-highlight);
  font-size: 20rpx; font-weight: 600; letter-spacing: 3rpx;
  color: var(--color-primary);
}

/* ========== 登录面板：铆接金属控制面板 ========== */
.login-card {
  position: relative; z-index: 2;
  margin: -76rpx 8rpx 0; padding: 44rpx 36rpx 40rpx;
  border-radius: var(--radius-lg);
  box-shadow:
    inset 2rpx 2rpx 0 var(--color-highlight),
    inset -2rpx -2rpx 0 rgba(0, 0, 0, 0.12),
    var(--shadow-float);
}
/* 面板状态灯：绿=就绪 / 琥珀=登录中 / 红=报错 */
.login-led { position: absolute; top: 46rpx; right: 36rpx; }
.login-title {
  display: block; font-size: 38rpx; font-weight: 700;
  color: var(--color-text); letter-spacing: 2rpx;
  text-shadow: 0 1rpx 0 var(--color-highlight);
}
.login-sub { display: block; margin-top: 10rpx; font-size: 24rpx; color: var(--color-text-secondary); letter-spacing: 1rpx; }

/* ========== 表单：内凹金属槽 ========== */
.field-group { margin-top: 34rpx; }
.field-label {
  display: flex; align-items: center;
  font-size: 22rpx; font-weight: 600; letter-spacing: 2rpx;
  color: var(--color-text-secondary); margin-bottom: 12rpx;
}
.field-label::before {
  content: ''; width: 10rpx; height: 10rpx; margin-right: 12rpx;
  background: var(--color-primary); border-radius: 2rpx;
  transform: rotate(45deg);
  box-shadow: 0 0 8rpx var(--color-primary);
}
.field-wrap {
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-sm);
  background: var(--color-panel-2);
  box-shadow: inset 2rpx 2rpx 4rpx var(--color-input-inset);
  transition: border-color .2s ease, box-shadow .2s ease;
}
.field-wrap.focused {
  border-color: var(--color-primary);
  box-shadow: inset 2rpx 2rpx 4rpx var(--color-input-inset), 0 0 0 3rpx var(--color-fill);
}
.field-input {
  height: 96rpx; padding: 0 26rpx; box-sizing: border-box;
  font-size: 30rpx; color: var(--color-text);
  background: transparent; border: none; border-radius: var(--radius-sm);
  box-shadow: none;
}
.field-placeholder { color: var(--color-text-tertiary); font-size: 28rpx; }

/* ========== 报警槽：danger 体系 ========== */
.error-pill {
  display: flex; align-items: center;
  margin-top: 28rpx; padding: 16rpx 24rpx;
  border: 2rpx var(--panel-border-style) var(--color-danger);
  border-radius: var(--radius-sm);
  background: var(--color-fill);
  box-shadow: inset 2rpx 2rpx 4rpx var(--color-input-inset);
  animation: fadeUp .25s ease;
}
.error-pill .led { animation: alarmBlink .9s ease-in-out infinite; }
@keyframes alarmBlink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.3; }
}
.error { margin-left: 16rpx; font-size: 24rpx; font-weight: 600; color: var(--color-danger); letter-spacing: 1rpx; }

/* ========== 登录键：橙色金属实体键 ========== */
.login-btn {
  width: 100%; height: 100rpx; line-height: 96rpx; padding: 0;
  margin-top: 44rpx;
  border: 2rpx var(--panel-border-style) var(--color-border-strong);
  border-radius: var(--radius);
  font-size: 32rpx; font-weight: 700; color: #fff; letter-spacing: 6rpx;
  background: var(--grad-btn-primary);
  box-shadow:
    inset 2rpx 2rpx 0 rgba(255, 255, 255, 0.35),
    inset -2rpx -2rpx 0 rgba(0, 0, 0, 0.2),
    var(--shadow-float);
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.3);
  transition: transform .15s ease, filter .15s ease;
}
.login-btn::after { border: none; }
.login-btn:active { transform: scale(0.98) translateY(2rpx); filter: brightness(0.92); }
.login-btn[disabled] { opacity: 0.8; color: #fff; }

.footer {
  display: block; margin-top: 48rpx; text-align: center;
  font-size: 22rpx; color: var(--color-text-tertiary); letter-spacing: 2rpx;
}

/* ========== 暗档说明：全部取色走语义变量，根节点 .dark 自动切换，无需局部覆写 ========== */
</style>

<script type="application/json">
{ "navigationBarTitleText": "登录" }
</script>
