<template>
  <view class="page {{themeClass}}">
    <view class="card riveted">
      <view class="row"><text class="label">设备编号</text><text class="value mono">{{form.sn}}</text></view>
      <view class="row">
        <text class="label">设备名称</text>
        <input class="input field-input" value="{{form.name}}" placeholder="请输入" placeholder-class="input-placeholder" bindinput="onNameInput" />
      </view>
      <view class="row">
        <text class="label">所属小区</text>
        <picker
          class="picker"
          range="{{communityNames}}"
          value="{{communityIndex}}"
          bindchange="onCommunityChange"
        >
          <text class="value">{{communityNames[communityIndex] || '请选择'}}</text>
        </picker>
      </view>
      <view class="row"><text class="label">省市区</text><text class="value muted">{{regionText || '选择小区后自动带出'}}</text></view>
      <view class="row">
        <text class="label">详细地址</text>
        <input class="input field-input" value="{{form.address}}" placeholder="请输入" placeholder-class="input-placeholder" bindinput="onAddressInput" />
      </view>
      <view class="row"><text class="label">经纬度</text><text class="value muted">{{coordText}}</text></view>
      <view class="hint">省市区与经纬度取自所属小区，需要修改请到网页端的小区管理页</view>
    </view>

    <view class="card riveted">
      <view class="card-title">安装信息</view>
      <view class="row">
        <text class="label">安装人</text>
        <input class="input field-input" value="{{form.installer_name}}" placeholder="请输入" placeholder-class="input-placeholder" bindinput="onInstallerInput" />
      </view>
      <view class="row">
        <text class="label">安装日期</text>
        <picker class="picker" mode="date" value="{{installDate}}" bindchange="onDateChange">
          <text class="value">{{installDate || '请选择'}}</text>
        </picker>
      </view>
      <view class="row">
        <text class="label">备注</text>
        <input class="input field-input" value="{{form.remark}}" placeholder="选填" placeholder-class="input-placeholder" bindinput="onRemarkInput" />
      </view>
      <view class="photos">
        <view class="photo-wrap" wx:for="{{form.install_photos}}" wx:for-index="photoIdx" wx:key="*this">
          <image class="photo" src="{{form.local_photos[photoIdx] || item}}" mode="aspectFill" data-url="{{item}}" bindtap="previewPhoto" />
          <text class="photo-del" data-url="{{item}}" bindtap="removePhoto">×</text>
        </view>
        <view class="photo-add" wx:if="{{form.install_photos.length < 3}}" bindtap="choosePhoto">+</view>
      </view>
    </view>

    <view class="actions">
      <button class="btn-primary btn-block" loading="{{saving}}" disabled="{{saving}}" bindtap="handleSave">保存</button>
    </view>
  </view>
</template>

<script>
import { createPage } from '@mpxjs/core'
import { getCommunityOptions, getDeviceBySn, updateDevice, uploadImage, downloadFile, normalizeFileUrl } from '../../services/api/tenant'
import { useAuthStore } from '../../stores/auth'
import { useDeviceStore } from '../../stores/device'

const MAX_PHOTOS = 3

createPage({
  data: {
    sn: '',
    saving: false,
    themeClass: '',
    communities: [],
    communityNames: [],
    communityIndex: -1,
    installDate: '',
    regionText: '',
    coordText: '未填写',
    form: {
      id: 0,
      sn: '',
      name: '',
      community_id: null,
      province: '',
      city: '',
      district: '',
      address: '',
      longitude: null,
      latitude: null,
      remark: '',
      installer_name: '',
      install_time: null,
      install_photos: [],
      local_photos: [],
    },
  },

  onLoad(query) {
    this.setData({ sn: decodeURIComponent(query.sn || ''), themeClass: useDeviceStore().themeClass })
    // 进页面先挡一道，避免用户从历史栈直接回到这一页绕过入口判定
    if (!useAuthStore().canInstall) {
      wx.showModal({
        title: '账户暂无操作权限',
        content: '你的账户还没有分配设备安装权限，请联系管理员开通。',
        showCancel: false,
        confirmText: '知道了',
        success: () => wx.navigateBack(),
      })
      return
    }
    this.init()
  },

  async init() {
    try {
      const [device, communityRes] = await Promise.all([getDeviceBySn(this.data.sn), getCommunityOptions()])
      const communities = (communityRes && communityRes.list) || []

      const form = {
        id: device.id,
        sn: device.sn,
        name: device.name || '',
        community_id: device.community_id || null,
        province: device.province || '',
        city: device.city || '',
        district: device.district || '',
        address: device.address || '',
        longitude: device.longitude === undefined ? null : device.longitude,
        latitude: device.latitude === undefined ? null : device.latitude,
        remark: device.remark || '',
        // realname 在 auth store 里已经兜底成用户名，这里不用再判一次空
        installer_name: device.installer_name || useAuthStore().user.realname,
        install_time: device.install_time || null,
        install_photos: (device.install_photos || []).map(normalizeFileUrl),
        local_photos: [],
      }

      this.setData({
        communities,
        communityNames: communities.map(c => c.name),
        communityIndex: communities.findIndex(c => c.id === form.community_id),
        form,
        installDate: form.install_time ? this.toDateStr(form.install_time) : '',
      })
      this.refreshDerived()
      // 下载已有图片到本地临时文件，解决编辑页加载时已保存图片显示空白的问题
      if (form.install_photos.length > 0) {
        this.downloadExistingPhotos(form.install_photos)
      }
    } catch (err) {
      wx.showModal({
        title: '加载失败',
        content: err.message || '请稍后重试',
        showCancel: false,
        success: () => wx.navigateBack(),
      })
    }
  },

  /**
   * 表单字段统一走这里改。
   *
   * 不用 this.setData({ 'form.name': x }) 的路径写法：整份 form 每次都是新对象，
   * 视图更新的时机只有一种，省得为「某个字段改了视图没动」去排查路径拼写。
   */
  patchForm(patch) {
    this.setData({ form: { ...this.data.form, ...patch } })
  },

  /** 省市区与坐标是派生展示，任何改动小区的操作后都要重算 */
  refreshDerived() {
    const form = this.data.form
    this.setData({
      regionText: [form.province, form.city, form.district].filter(Boolean).join(' / '),
      coordText:
        form.longitude === null || form.latitude === null
          ? '未填写'
          : `${form.longitude}, ${form.latitude}`,
    })
  },

  /** 串行下载已有图片到本地临时文件，解决编辑页加载时已保存图片显示空白的问题 */
  async downloadExistingPhotos(urls) {
    const localPhotos = []
    for (const url of urls) {
      try {
        const localPath = await downloadFile(url)
        localPhotos.push(localPath)
      } catch (e) {
        localPhotos.push('')
      }
    }
    this.patchForm({ local_photos: localPhotos })
  },

  toDateStr(seconds) {
    const d = new Date(seconds * 1000)
    const p = n => String(n).padStart(2, '0')
    return `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())}`
  },

  onNameInput(e) {
    this.patchForm({ name: e.detail.value })
  },
  onAddressInput(e) {
    this.patchForm({ address: e.detail.value })
  },
  onInstallerInput(e) {
    this.patchForm({ installer_name: e.detail.value })
  },
  onRemarkInput(e) {
    this.patchForm({ remark: e.detail.value })
  },

  /**
   * 选中小区后把小区的省市区、地址与中心点带进来。
   * 与网页端 handleCommunityChange 的规则逐条对齐：小区没填中心点时不覆盖已有坐标，
   * 拿 null 去盖掉一个已知坐标是纯粹的损失。
   */
  onCommunityChange(e) {
    const index = Number(e.detail.value)
    const c = this.data.communities[index]
    if (!c) return
    const patch = {
      community_id: c.id,
      province: c.province || '',
      city: c.city || '',
      district: c.district || '',
      address: c.address || '',
    }
    if (c.longitude !== null && c.longitude !== undefined && c.latitude !== null && c.latitude !== undefined) {
      patch.longitude = c.longitude
      patch.latitude = c.latitude
    }
    this.setData({ communityIndex: index })
    this.patchForm(patch)
    this.refreshDerived()
  },

  /**
   * 只取到日的精度。安装人员回填的是「哪天装的」，让他在手机上拨到分钟
   * 只会拨出一个假精确的时间。存的时候补成当天 00:00。
   */
  onDateChange(e) {
    const date = e.detail.value
    this.setData({ installDate: date })
    // iOS 解析不了 '2026-08-06 00:00:00' 这种带空格的格式，用 / 分隔才是全平台都认的写法
    this.patchForm({ install_time: Math.floor(new Date(`${date.replace(/-/g, '/')} 00:00:00`).getTime() / 1000) })
  },

  previewPhoto(e) {
    // install_photos 存的是相对路径，previewImage 要绝对地址，过一道归一
    wx.previewImage({
      current: normalizeFileUrl(e.currentTarget.dataset.url),
      urls: this.data.form.install_photos.map(normalizeFileUrl),
    })
  },

  removePhoto(e) {
    const url = e.currentTarget.dataset.url
    // 从两个数组同时摘掉
    this.patchForm({
      install_photos: this.data.form.install_photos.filter(u => u !== url),
      local_photos: this.data.form.local_photos.filter((_, i) => this.data.form.install_photos[i] !== url),
    })
  },

  async choosePhoto() {
    const remain = MAX_PHOTOS - this.data.form.install_photos.length
    let files = []
    try {
      const res = await new Promise((resolve, reject) => {
        wx.chooseMedia({ count: remain, mediaType: ['image'], success: resolve, fail: reject })
      })
      files = res.tempFiles || []
    } catch (e) {
      return // 用户取消
    }

    wx.showLoading({ title: '上传中' })
    try {
      // 串行上传：安装现场网络普遍不好，并发几张更容易整批超时，
      // 而且串行能在中途失败时保住已经传上去的那几张。
      for (const f of files) {
        // 后端现在返回站点相对路径（/upload/...），原样入库——
        // 域名拼接交给展示侧（normalizeFileUrl），数据库不耦合域名。
        const url = await uploadImage(f.tempFilePath, this.data.form.sn)
        // 上传成功后用 wx.downloadFile 下载到本地临时文件，
        // 解决真机预览时 <image> 组件无法加载 HTTP 图片的问题（iOS ATS 限制）。
        const localPath = await downloadFile(url)
        this.patchForm({
          install_photos: [...this.data.form.install_photos, url],
          local_photos: [...this.data.form.local_photos, localPath],
        })
      }
      wx.hideLoading()
    } catch (err) {
      wx.hideLoading()
      wx.showModal({ title: '上传失败', content: err.message || '请重试', showCancel: false })
    }
  },

  async handleSave() {
    if (this.data.saving) return
    this.setData({ saving: true })
    const form = this.data.form
    try {
      // 逐字段列出，与后端白名单 DEVICE_EDITABLE_FIELDS 对齐。
      // 直接展开 this.data.form 会把 sn 一起送过去，那是设备身份，后端不收。
      await updateDevice({
        id: form.id,
        name: form.name,
        community_id: form.community_id,
        province: form.province,
        city: form.city,
        district: form.district,
        address: form.address,
        longitude: form.longitude,
        latitude: form.latitude,
        remark: form.remark,
        installer_name: form.installer_name,
        install_time: form.install_time,
        install_photos: form.install_photos,
      })
      wx.showToast({ title: '保存成功', icon: 'success' })
      // 详情页的 onShow 会重新拉一次，所以这里不用回传数据
      setTimeout(() => wx.navigateBack(), 800)
    } catch (err) {
      wx.showModal({ title: '保存失败', content: err.message || '请稍后重试', showCancel: false })
    } finally {
      this.setData({ saving: false })
    }
  },
})
</script>

<style scoped>
.page { padding: 24rpx 24rpx 48rpx; min-height: 100vh; box-sizing: border-box; }

.card { margin: 0 0 24rpx; padding: 28rpx 28rpx 16rpx; }

/* 金属铭牌小节：橙边条 + 螺丝点 + 加宽字距 */
.card-title {
  display: flex; align-items: center;
  margin-bottom: 12rpx; padding: 12rpx 16rpx;
  background: var(--color-panel-3);
  border: 2rpx var(--panel-border-style) var(--color-border);
  border-left: 8rpx solid var(--color-primary);
  border-radius: var(--radius-sm);
  font-size: 26rpx; font-weight: 700; color: var(--color-text); letter-spacing: 3rpx;
  box-shadow: inset 1rpx 1rpx 0 var(--color-highlight), inset -1rpx -1rpx 0 rgba(0, 0, 0, 0.12);
}
.card-title::before,
.card-title::after {
  content: ''; flex-shrink: 0;
  width: 12rpx; height: 12rpx; border-radius: 50%;
  background: var(--deco-rivet);
  box-shadow: inset 0 1rpx 2rpx var(--deco-rivet-shadow), 0 1rpx 0 var(--color-highlight);
}
.card-title::before { margin-right: 14rpx; }
.card-title::after { margin-left: auto; }

.row {
  display: flex; align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}
.row:last-child { border-bottom: none; }
.label { width: 170rpx; flex-shrink: 0; font-size: 28rpx; color: var(--color-text-secondary); letter-spacing: 1rpx; }
.value { flex: 1; font-size: 28rpx; color: var(--color-text); word-break: break-all; }
.value.muted { color: var(--color-text-tertiary); }

/* 内凹金属槽输入：槽底/边框/聚焦态由全局 field-input 提供 */
.input { flex: 1; min-width: 0; min-height: 72rpx; box-sizing: border-box; padding: 10rpx 20rpx; font-size: 28rpx; color: var(--color-text); }
.input-placeholder { color: var(--color-text-tertiary); font-size: 26rpx; }
.picker {
  flex: 1; min-width: 0; box-sizing: border-box;
  display: flex; align-items: center;
  padding: 14rpx 20rpx;
  background: var(--color-panel-2);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-sm);
  box-shadow: inset 2rpx 2rpx 4rpx var(--color-input-inset);
}

.hint { padding: 16rpx 0 4rpx; font-size: 24rpx; color: var(--color-accent-2); line-height: 1.5; letter-spacing: 1rpx; }

.photos { display: flex; flex-wrap: wrap; padding: 16rpx 0 4rpx; }
.photo-wrap { position: relative; margin: 0 16rpx 16rpx 0; }
.photo { width: 180rpx; height: 180rpx; border-radius: var(--radius-sm); border: 1rpx solid var(--color-border); box-shadow: var(--shadow-card); }
.photo-del {
  position: absolute; top: -12rpx; right: -12rpx;
  width: 44rpx; height: 44rpx; line-height: 40rpx; text-align: center;
  border-radius: 50%; background: var(--color-danger); color: #fff; font-size: 32rpx;
  border: 2rpx var(--panel-border-style) var(--color-border-strong);
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.25);
}
.photo-add {
  width: 180rpx; height: 180rpx; line-height: 176rpx; text-align: center;
  border: 2rpx dashed var(--color-border); border-radius: var(--radius-sm);
  color: var(--color-text-tertiary); font-size: 60rpx;
  background: var(--color-panel-2);
  box-shadow: inset 2rpx 2rpx 4rpx var(--color-input-inset);
}
.photo-add:active { background: var(--color-fill-strong); }

.actions { padding: 8rpx 0 16rpx; }
.btn-block { width: 100%; box-sizing: border-box; height: 96rpx; line-height: 92rpx; padding: 0 48rpx; }
</style>

<script type="application/json">
{ "navigationBarTitleText": "编辑设备" }
</script>
