<template>
  <view class="app {{themeClass}}">
    <!-- ========= 内容区 ========= -->
    <!-- 仪表盘 -->
    <view wx:if="{{tab === 'dashboard'}}" class="tab-content">
      <view class="db-hero riveted">
        <view class="db-hero-deco hd1"></view>
        <view class="db-hero-deco hd2"></view>
        <view class="db-hero-top">
          <view class="db-hero-main">
            <text class="db-hero-label">设备编号</text>
            <text class="db-hero-title">{{deviceId || '未连接'}}</text>
          </view>
          <view class="db-hero-side">
            <view class="db-status {{discoveryStarted ? 'db-on' : 'db-off'}}">
              <view class="db-dot"></view>
              <text>{{bluetoothStatus}}</text>
            </view>
            <view class="theme-toggle" bindtap="toggleTheme">
              <text>{{themeIcon}}</text>
            </view>
          </view>
        </view>

        <button class="db-read-btn {{readStatus.isReading ? 'reading' : ''}}" bindtap="startRead" disabled="{{readStatus.isReading}}">
          <block wx:if="{{readStatus.isReading}}">
            <view class="db-spinner"></view>
            <text>读取中…</text>
          </block>
          <text wx:else>读取设备状态</text>
        </button>
      </view>

      <button wx:if="{{page2Failed && !readStatus.isReading}}" class="db-retry-btn" bindtap="retryPage2">
        <text class="db-retry-icon">↻</text>
        <text>第二页无响应，重读第二页</text>
      </button>

      <block wx:if="{{dashboard}}">
        <!-- 故障告警条（有故障才显示） -->
        <view wx:if="{{dashboard.alert}}" class="db-alert">
          <text class="db-alert-icon">!</text>
          <view class="db-alert-body">
            <text class="db-alert-title">设备告警</text>
            <text class="db-alert-text">{{dashboard.alert}}</text>
          </view>
        </view>

        <!-- 分组参数卡片 -->
        <view wx:for="{{dashboard.groups}}" wx:key="title" class="db-group riveted anim-in" style="animation-delay: {{index * 0.08}}s">
          <view class="db-group-head">
            <view class="db-group-bar bar-{{index % 3}}"></view>
            <text class="db-group-title">{{item.title}}</text>
          </view>
          <view class="db-grid">
            <view wx:for="{{item.items}}" wx:for-item="cell" wx:key="key" class="db-cell {{cell.full ? 'full' : ''}}">
              <text class="db-cell-val">{{cell.value}}</text>
              <text class="db-cell-label">{{cell.label}}</text>
            </view>
          </view>
        </view>

        <!-- 分时压力独立区 -->
        <view wx:if="{{dashboard.timeShare}}" class="db-group db-ts riveted">
          <view class="db-ts-head">
            <view class="db-group-head">
              <view class="db-group-bar db-ts-bar"></view>
              <text class="db-group-title">分时压力</text>
            </view>
            <text class="db-ts-badge {{dashboard.timeShare.enabled ? 'on' : 'off'}}">{{dashboard.timeShare.enabled ? '开启' : '关闭'}}</text>
          </view>
          <view wx:if="{{dashboard.timeShare.slots.length > 0}}" class="db-ts-list">
            <view wx:for="{{dashboard.timeShare.slots}}" wx:key="key" class="db-ts-row">
              <text class="db-ts-idx">{{item.label}}</text>
              <text class="db-ts-range">{{item.range}}</text>
              <text class="db-ts-kpa">{{item.kpa}}</text>
            </view>
          </view>
          <view wx:else class="db-ts-empty">未配置分时段</view>
        </view>

        <view wx:if="{{updateTime}}" class="db-updated">
          <text class="db-updated-dot"></text>
          <text>最后更新 {{updateTime}}</text>
        </view>
      </block>

      <view wx:if="{{!dashboard && !readStatus.isReading}}" class="db-placeholder">
        <text class="db-placeholder-icon">◉</text>
        <text class="db-placeholder-text">点击上方按钮读取设备参数</text>
      </view>
    </view>

    <!-- 控制 -->
    <view wx:if="{{tab === 'control'}}" class="tab-content">
      <view class="ctrl-section">
        <text class="ctrl-section-title">快速操作</text>
        <view class="ctrl-quick">
          <button class="ctrl-btn ctrl-open" data-action="openAll" bindtap="sendControlCmd">
            <text class="ctrl-btn-icon">○</text>
            <text class="ctrl-btn-label">全开</text>
          </button>
          <button class="ctrl-btn ctrl-close" data-action="closeAll" bindtap="sendControlCmd">
            <text class="ctrl-btn-icon">⊘</text>
            <text class="ctrl-btn-label">全关</text>
          </button>
          <button class="ctrl-btn ctrl-reset" bindtap="execCmd('deviceReset','复位设备？')">
            <text class="ctrl-btn-icon">↺</text>
            <text class="ctrl-btn-label">复位</text>
          </button>
        </view>
      </view>

      <!-- 旧阀设置 -->
      <view wx:if="{{mode === 'old'}}" class="ctrl-section">
        <text class="ctrl-section-title">参数设置</text>

        <view class="pf-field">
          <view class="pf-row">
            <text class="pf-label">开度设定</text>
            <view class="pf-inp">
              <input class="pf-input" type="digit" model:value="{{p_opening}}" placeholder="0~100" />
              <text class="pf-unit">%</text>
            </view>
          </view>
          <button class="pf-btn" bindtap="execCmd('setOpening',null,[p_opening])">设定</button>
        </view>

        <view class="pf-field">
          <view class="pf-row">
            <text class="pf-label">工作模式</text>
            <view class="pf-inp">
              <picker model:value="{{p_modeIdx}}" range="{{workModes}}" bindchange="p_modeIdx = $event.detail.value" style="flex:1">
                <view class="pf-input">{{workModes[p_modeIdx]}}</view>
              </picker>
            </view>
          </view>
          <button class="pf-btn" bindtap="execCmd('setWorkMode',null,[workModeCodes[p_modeIdx]])">设定</button>
        </view>

        <view class="pf-field pf-group">
          <text class="pf-group-title">开度限制</text>
          <view class="pf-row">
            <text class="pf-label">最大开度</text>
            <view class="pf-inp">
              <input class="pf-input" type="digit" model:value="{{p_limitU}}" placeholder="0~100" />
              <text class="pf-unit">%</text>
            </view>
          </view>
          <view class="pf-row">
            <text class="pf-label">最小开度</text>
            <view class="pf-inp">
              <input class="pf-input" type="digit" model:value="{{p_limitL}}" placeholder="0~100" />
              <text class="pf-unit">%</text>
            </view>
          </view>
          <button class="pf-btn" bindtap="execCmd('setOpeningLimits',null,[p_limitU,p_limitL])">设限</button>
        </view>

        <view class="pf-field pf-group">
          <text class="pf-group-title">上报周期</text>
          <view class="pf-row">
            <text class="pf-label">采样周期</text>
            <view class="pf-inp">
              <input class="pf-input" type="digit" model:value="{{p_spMin}}" placeholder="采样周期" />
              <text class="pf-unit">分</text>
            </view>
          </view>
          <view class="pf-row">
            <text class="pf-label">供暖上报</text>
            <view class="pf-inp">
              <input class="pf-input" type="digit" model:value="{{p_rpOnMin}}" placeholder="供暖上报" />
              <text class="pf-unit">分</text>
            </view>
          </view>
          <view class="pf-row">
            <text class="pf-label">非供暖上报</text>
            <view class="pf-inp">
              <input class="pf-input" type="digit" model:value="{{p_rpOffDay}}" placeholder="非供暖上报" />
              <text class="pf-unit">天</text>
            </view>
          </view>
          <button class="pf-btn" bindtap="execCmd('setReportCycle',null,[p_spMin,p_rpOnMin,p_rpOffDay])">设定</button>
        </view>
      </view>

      <!-- 新阀设置 -->
      <view wx:if="{{mode === 'new'}}" class="ctrl-section">
        <text class="ctrl-section-title">参数设置</text>

        <view class="pf-field">
          <view class="pf-row">
            <text class="pf-label">目标压力</text>
            <view class="pf-inp">
              <input class="pf-input" type="digit" model:value="{{p_pressure}}" placeholder="0~160" />
              <text class="pf-unit">×10KPa</text>
            </view>
          </view>
          <button class="pf-btn" bindtap="sendTargetPressure">设定</button>
        </view>

        <view class="pf-field">
          <view class="pf-row">
            <text class="pf-label">压力补偿</text>
            <view class="pf-inp">
              <input class="pf-input" type="digit" model:value="{{p_compIn}}" placeholder="进水补偿" />
              <text class="pf-unit">/</text>
              <input class="pf-input" type="digit" model:value="{{p_compRet}}" placeholder="回水补偿" />
            </view>
          </view>
          <button class="pf-btn" bindtap="execCmd('setPressureCompensation',null,[p_compIn,p_compRet])">补偿</button>
        </view>

        <view class="pf-field pf-group">
          <text class="pf-group-title">压力上下限</text>
          <view class="pf-row">
            <text class="pf-label">进水上限</text>
            <view class="pf-inp">
              <input class="pf-input" type="digit" model:value="{{p_inletUpper}}" placeholder="0~160" />
              <text class="pf-unit">×10KPa</text>
            </view>
          </view>
          <view class="pf-row">
            <text class="pf-label">进水下限</text>
            <view class="pf-inp">
              <input class="pf-input" type="digit" model:value="{{p_inletLower}}" placeholder="0~160" />
              <text class="pf-unit">×10KPa</text>
            </view>
          </view>
          <view class="pf-row">
            <text class="pf-label">回水上限</text>
            <view class="pf-inp">
              <input class="pf-input" type="digit" model:value="{{p_retUpper}}" placeholder="0~160" />
              <text class="pf-unit">×10KPa</text>
            </view>
          </view>
          <view class="pf-row">
            <text class="pf-label">回水下限</text>
            <view class="pf-inp">
              <input class="pf-input" type="digit" model:value="{{p_retLower}}" placeholder="0~160" />
              <text class="pf-unit">×10KPa</text>
            </view>
          </view>
          <button class="pf-btn" bindtap="sendPressureLimits">设限</button>
        </view>

        <view class="pf-field pf-group">
          <text class="pf-group-title">上报周期</text>
          <view class="pf-row">
            <text class="pf-label">采样周期</text>
            <view class="pf-inp">
              <input class="pf-input" type="digit" model:value="{{p_spMin}}" placeholder="10~2550" />
              <text class="pf-unit">分</text>
            </view>
          </view>
          <view class="pf-row">
            <text class="pf-label">供暖上报</text>
            <view class="pf-inp">
              <input class="pf-input" type="digit" model:value="{{p_rpOnMin}}" placeholder="10~2550" />
              <text class="pf-unit">分</text>
            </view>
          </view>
          <view class="pf-row">
            <text class="pf-label">非供暖上报</text>
            <view class="pf-inp">
              <input class="pf-input" type="digit" model:value="{{p_rpOffDay}}" placeholder="1~255" />
              <text class="pf-unit">天</text>
            </view>
          </view>
          <button class="pf-btn" bindtap="sendReportCycle">设定</button>
        </view>

        <view class="pf-field pf-group">
          <text class="pf-group-title">压力报警阈值</text>
          <view class="pf-row">
            <text class="pf-label">进水阈值</text>
            <view class="pf-inp">
              <input class="pf-input" type="digit" model:value="{{p_threshIn}}" placeholder="0~160" />
              <text class="pf-unit">×10KPa</text>
            </view>
          </view>
          <view class="pf-row">
            <text class="pf-label">回水阈值</text>
            <view class="pf-inp">
              <input class="pf-input" type="digit" model:value="{{p_threshRet}}" placeholder="0~160" />
              <text class="pf-unit">×10KPa</text>
            </view>
          </view>
          <button class="pf-btn" bindtap="sendPressureThreshold">设限</button>
        </view>

        <view class="pf-field pf-group">
          <view class="pf-row">
            <text class="pf-group-title">分时压力</text>
            <switch class="ps-main-sw" checked="{{p_psEnable}}" bindchange="onPsEnableToggle" />
          </view>
          <view class="ps-slot" wx:for="{{p_slots}}" wx:key="id">
            <text class="ps-idx">分时{{index + 1}}</text>
            <picker class="ps-time" mode="time" value="{{item.time}}" data-idx="{{index}}" bindchange="onSlotTime" disabled="{{!item.on}}">
              <view class="ps-time-val {{item.on ? '' : 'ps-off'}}">{{item.on ? item.time : '--:--'}}</view>
            </picker>
            <input class="ps-kpa" type="digit" value="{{item.kpa}}" data-idx="{{index}}" bindinput="onSlotKpa" placeholder="1~160" disabled="{{!item.on}}" />
            <text class="ps-unit">×10KPa</text>
            <switch class="ps-sw" checked="{{item.on}}" data-idx="{{index}}" bindchange="onSlotToggle" />
          </view>
          <button class="pf-btn" bindtap="sendTimePressure">下发分时压力</button>
        </view>
      </view>

      <!-- 蓝牙配置 -->
      <view class="ctrl-section">
        <text class="ctrl-section-title">蓝牙配置</text>
        <view class="ctrl-group riveted">
          <view class="ctrl-row">
            <text class="ctrl-label">设备地址</text>
            <input class="ctrl-addr ctrl-addr-flex" type="text" placeholder="设备编号后6位" model:value="{{configAddress}}" bindblur="onAddressBlur" />
            <view class="ctrl-scan-btn" bindtap="scanAddr">扫码</view>
          </view>
          <view class="ctrl-divider"></view>
          <view class="ctrl-row">
            <text class="ctrl-label">蓝牙模式</text>
            <view class="ctrl-mode">
              <view class="ctrl-mode-dot {{discoveryStarted || advertiseStart ? 'on' : (advertiseReady || bleReady ? 'ready' : '')}}"></view>
              <text class="ctrl-mode-text">{{bleMode}}</text>
            </view>
          </view>
          <view class="ctrl-divider"></view>
          <view class="ctrl-row">
            <text class="ctrl-label">工作状态</text>
            <text class="ctrl-workstatus {{statusColorClass}}">{{bluetoothStatus}}</text>
          </view>
          <view class="ctrl-divider"></view>
          <view class="ctrl-row">
            <text class="ctrl-label">广播信道</text>
            <picker range="{{channels}}" bindchange="onChannelChange">
              <view class="ctrl-picker">信道 {{channels[configChannel]}}</view>
            </picker>
          </view>
          <view class="ctrl-divider"></view>
          <view class="ctrl-init-row">
            <view class="ctrl-init-btn {{reinitLoading ? 'loading' : ''}}" bindtap="reinitBle">
              <view wx:if="{{reinitLoading}}" class="ctrl-init-spinner"></view>
              <text>{{reinitLoading ? '初始化中…' : '重新初始化蓝牙'}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 历史 -->
    <view wx:if="{{tab === 'history'}}" class="tab-content">
      <view class="hist-header">
        <text class="hist-title">指令日志</text>
        <text class="hist-clear" wx:if="{{logs.length}}" bindtap="clearLogs">清空</text>
      </view>
      <view wx:if="{{!logs.length}}" class="hist-empty">
        <text>暂无日志</text>
      </view>
      <view wx:for="{{logs}}" wx:key="time" class="hist-item hist-{{item.dir}} anim-in" style="animation-delay: {{index * 0.04}}s">
        <view class="hist-top">
          <text class="hist-time">{{item.time}}</text>
          <view class="hist-tag {{item.dir}}">{{item.dir === 'recv' ? '接收' : '发送'}}</view>
          <text class="hist-copy" bindtap="onCopy" data-hex="{{item.hex}}">复制</text>
        </view>
        <text class="hist-hex">{{item.hex}}</text>
      </view>
    </view>

    <!-- ========= 底部导航 ========= -->
    <view class="tabbar">
      <view class="tabbar-item {{tab === 'dashboard' ? 'tabbar-active' : ''}}" bindtap="switchTab" data-tab="dashboard">
        <text class="tabbar-icon">◉</text>
        <text class="tabbar-label">仪表盘</text>
      </view>
      <view class="tabbar-item {{tab === 'control' ? 'tabbar-active' : ''}}" bindtap="switchTab" data-tab="control">
        <text class="tabbar-icon">▣</text>
        <text class="tabbar-label">控制</text>
      </view>
      <view class="tabbar-item {{tab === 'history' ? 'tabbar-active' : ''}}" bindtap="switchTab" data-tab="history">
        <text class="tabbar-icon">☰</text>
        <text class="tabbar-label">历史</text>
      </view>
    </view>
  </view>
</template>

<script>
import { createPage } from '@mpxjs/core'
import { useDeviceStore } from '../../stores/device'
import { getProtocol } from '../../services/protocol/factory'
import { resetSeq } from '../../services/protocol/old-valve'
import { generateDataWithAddr } from '../../services/beacon/bleUtil'

const FILTER_NAME = 'ANTS'
const MANUFACTURER_ID = '0x00C7'
// ===== 读取指令的时序预算（决定「读取超时」何时触发）=====
// 一次读取 = 「广播命令 AD_DURATION 毫秒 → 静默 RESEND_DELAY 毫秒等回复 → 未收到则重试」，最多 MAX_RETRIES 次。
// 单次读取最长耗时 ≈ MAX_RETRIES × (AD_DURATION + RESEND_DELAY) ≈ 3 ×1600ms ≈ 4.8s，超时即报「设备无响应」。
// 注意：手机只在 AD_DURATION(400ms) 这个窗口内发射命令，其余 1200ms 处于静默；若设备的接收占空比错过这 400ms 窗口，
// 就收不到命令、也就不会回复 → 表现为「读取超时」。这是超时最常见的成因（配合信道/地址/距离），并非解析逻辑出错。
const AD_DURATION = 400
const RESEND_DELAY = 1200
const MAX_RETRIES = 3

const workModes = ['通断阀', '回水调节', '室内调节', '流量平衡', '停止']
const workModeCodes = [0x81, 0x82, 0x83, 0x84, 0x89]
const channels = ['37', '38', '39']

const OLD_MODE_MAP = { 0x81: '通断阀', 0x82: '回水调节', 0x83: '室内调节', 0x84: '流量平衡', 0x89: '停止' }

function parseTemperature(hexStr) {
  if (hexStr.length !== 4) return '--'
  const bigEndian = hexStr.slice(2) + hexStr.slice(0, 2)
  let num = parseInt(bigEndian, 16)
  const isNegative = (num & 0x8000) !== 0
  if (isNegative) num = -(num & 0x7FFF)
  return `${(num / 100).toFixed(2)}℃`
}

const PAGE1_LAYOUT = [
  { key: 'frameHeader', label: '帧头', start: 0, end: 2 },
  { key: 'workMode', label: '工作模式', start: 2, end: 4,
    parse: v => OLD_MODE_MAP[parseInt(v, 16)] || `${parseInt(v, 16)}` },
  { key: 'valveOpenness', label: '阀门开度', start: 4, end: 6,
    parse: v => `${parseInt(v, 16)}%` },
  { key: 'valveSetOpenness', label: '设定开度', start: 6, end: 8,
    parse: v => `${parseInt(v, 16)}%` },
  { key: 'valveMaxOpenness', label: '开度上限', start: 8, end: 10,
    parse: v => `${parseInt(v, 16)}%` },
  { key: 'valveMinOpenness', label: '开度下限', start: 10, end: 12,
    parse: v => `${parseInt(v, 16)}%` },
  { key: 'sampleCycle', label: '采样周期', start: 12, end: 14,
    parse: v => `${parseInt(v, 16)}×10分钟` },
  { key: 'reportCycleHeating', label: '供暖上报周期', start: 14, end: 16,
    parse: v => `${parseInt(v, 16)}×10分钟` },
  { key: 'reportCycleNonHeating', label: '非供暖上报周期', start: 16, end: 18,
    parse: v => `${parseInt(v, 16)}天` },
  { key: 'inletTemp', label: '进水温度', start: 24, end: 28,
    parse: parseTemperature },
  { key: 'returnTemp', label: '回水温度', start: 28, end: 32,
    parse: parseTemperature },
]

// ===== 先导阀(压力阀)响应解析 =====
// hex 字符串按字节切片：帧头=byte0=chars[0:2]，data[k]=chars[2+2k:4+2k]
function u8(v) { return parseInt(v, 16) || 0 }
function s8(v) { const n = parseInt(v, 16) || 0; return n > 127 ? n - 256 : n }
function kpa10(v) { return `${u8(v) * 10} KPa` }        // 单位10KPa
function kpaS8(v) { return `${s8(v)} KPa` }             // INT8 补偿
function min10(v) { return `${u8(v) * 10} 分钟` }       // 单位10分钟
function hhmm(min) {                                    // 当日分钟数 → HH:MM（如 0→00:00，1440→24:00）
  const h = Math.floor(min / 60)
  const m = min % 60
  return `${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}`
}
// 分时压力：5 段，每段 时(1B,×10=当日分钟) + 压(1B,×10KPa)。0xFF=未启用跳过。
// 解析成时间段：本段起始 → 下一段起始（末段至 24:00），range 与 kpa 分列，供仪表盘独立区展示。
function timeSlotRows(p2) {
  const slots = []
  for (let i = 0; i < 5; i++) {
    const off = 4 + i * 4
    const tb = u8(p2.slice(off, off + 2))
    if (tb === 255) continue
    slots.push({ idx: i + 1, start: tb * 10, kpa: u8(p2.slice(off + 2, off + 4)) * 10 })
  }
  return slots.map((s, k) => {
    const end = k + 1 < slots.length ? slots[k + 1].start : 1440
    return { key: `slot${s.idx}`, label: `时段 ${s.idx}`,
      range: `${hhmm(s.start)} - ${hhmm(end)}`, kpa: `${s.kpa} KPa` }
  })
}
// 表单 → setTimePressure 入参 [使能, t1,p1,...,t5,p5]。时间HH:MM→分钟/10取整，压力×10KPa直接字节，停用段=255/0。
function slotsToParams(enable, slots) {
  const params = [enable ? 1 : 0]
  for (let i = 0; i < 5; i++) {
    const s = slots[i] || {}
    if (s.on && s.time) {
      const [h, m] = String(s.time).split(':').map(Number)
      params.push(Math.round((h * 60 + m) / 10), Number(s.kpa) || 0)
    } else {
      params.push(255, 0)
    }
  }
  return params
}

// 状态/功能位语义化：BLE 单字节只承载 V902ZF 状态字的低8位(BIT0~7)，高8位(电池欠压/SIM/4G/网络等)仅物联网上报
// 设备状态位定义表：置位=故障(0正常/1故障)
const VALVE_STATUS_BITS = ['阀门堵转', '阀门空转', '电位器故障', '霍尔传感器故障', '阀前压力传感器故障', '出水压力传感器故障', '压差异常', '出水压力调节异常']
// 功能模块使能位定义表：置位=使能(0禁止/1使能)
const VALVE_FUNC_BITS = ['LCD显示', '拆除报警', '', '', '', '压力上限报警', '压力下限报警', '压力变化阈值报警']
function bitsOn(hex, names) {
  const v = u8(hex)
  const on = []
  for (let i = 0; i < 8; i++) if ((v >> i) & 1) on.push(names[i] || `预留位${i}`)
  return on
}
function valveStatus(v) {                               // 无故障=正常，否则逐项列出故障
  const on = bitsOn(v, VALVE_STATUS_BITS)
  return on.length ? on.join('、') : '正常'
}
function valveFunc(v) {                                  // 列出已使能的功能，无则显示「无」
  const on = bitsOn(v, VALVE_FUNC_BITS)
  return on.length ? on.join('、') : '无'
}

// 查询第一页 回复 0x3F（15 字节数据域）
const PAGE1_LAYOUT_NEW = [
  { key: 'inletPressure', label: '阀前压力', start: 2, end: 4, parse: kpa10 },
  { key: 'returnPressure', label: '阀后压力', start: 4, end: 6, parse: kpa10 },
  { key: 'setPressure', label: '设定压力', start: 6, end: 8, parse: kpa10 },
  { key: 'inletComp', label: '阀前压力补偿', start: 8, end: 10, parse: kpaS8 },
  { key: 'returnComp', label: '阀后压力补偿', start: 10, end: 12, parse: kpaS8 },
  { key: 'returnUpper', label: '阀后压力上限', start: 12, end: 14, parse: kpa10 },
  { key: 'returnLower', label: '阀后压力下限', start: 14, end: 16, parse: kpa10 },
  { key: 'status', label: '状态', start: 16, end: 18, parse: valveStatus },
  { key: 'funcBits', label: '功能位', start: 18, end: 20, parse: valveFunc },
  { key: 'valvePosition', label: '阀门圈数', start: 20, end: 22, parse: v => `${u8(v)}` },
  { key: 'targetPosition', label: '设定圈数', start: 22, end: 24, parse: v => `${u8(v)}` },
  { key: 'posUpper', label: '圈数上限', start: 24, end: 26, parse: v => `${u8(v)}` },
  { key: 'posLower', label: '圈数下限', start: 26, end: 28, parse: v => `${u8(v)}` },
  { key: 'sampleCycle', label: '采样周期', start: 28, end: 30, parse: min10 },
  { key: 'reportCycle', label: '上报周期(供暖期)', start: 30, end: 32, parse: min10 },
]

// 查询第二页 回复 0x4F（15 字节数据域）
const PAGE2_LAYOUT_NEW = [
  { key: 'timeEnable', label: '分时压力', start: 2, end: 4, parse: v => u8(v) === 1 ? '开启' : '关闭' },
  { key: 'inletThreshold', label: '阀前压力阈值', start: 24, end: 26, parse: kpa10 },
  { key: 'returnThreshold', label: '阀后压力阈值', start: 26, end: 28, parse: kpa10 },
  { key: 'battery', label: '电池电压', start: 28, end: 30, parse: v => `${((u8(v) + 300) / 100).toFixed(2)} V` },
  { key: 'signal', label: '信号值', start: 30, end: 32, parse: v => `${u8(v)}` },
]

// 仪表盘分组：把两页参数按语义归到「压力 / 阀位 / 设备」三组卡片展示。
// status(故障) 单独提为顶部告警，timeEnable+分时段 单独成「分时压力」区，均不进这些分组。
const NEW_DASH_GROUPS = [
  { title: '压力', keys: ['inletPressure', 'returnPressure', 'setPressure', 'inletComp', 'returnComp', 'returnUpper', 'returnLower', 'inletThreshold', 'returnThreshold'] },
  { title: '阀位', keys: ['valvePosition', 'targetPosition', 'posUpper', 'posLower'] },
  { title: '设备', keys: ['sampleCycle', 'reportCycle', 'battery', 'signal', 'funcBits'] },
]

function ab2hex(buffer) {
  const u8 = new Uint8Array(buffer)
  return Array.from(u8).map(b => b.toString(16).padStart(2, '0').toUpperCase()).join('')
}

function toHex(arr) {
  if (arr instanceof ArrayBuffer) arr = new Uint8Array(arr)
  return Array.from(arr).map(b => b.toString(16).padStart(2, '0')).join('')
}

// 设备广播地址 = 设备编号后 6 位 hex。优先从广播名(P-/V5-/BA- 等前缀)提取，
// 提取不到再回退到上次手动输入(storage)。deviceId 在 iOS 是随机 UUID，不能当地址用。
function extractAddr(name) {
  if (!name) return ''
  let s = String(name).trim()
  const prefixes = ['P-', 'P_', 'V5-', 'BA-', 'BLACKANT']
  const upper = s.toUpperCase()
  for (const p of prefixes) {
    if (upper.startsWith(p)) { s = s.slice(p.length); break }
  }
  s = s.replace(/[^0-9a-fA-F]/g, '')
  return s.length >= 6 ? s.slice(-6).toLowerCase() : ''
}

function fmtTime() {
  const d = new Date()
  return d.toLocaleTimeString('zh-CN', { hour12: false })
}

createPage({
  data: {
    themeClass: '',
    themeIcon: '☀️',
    tab: 'dashboard',
    deviceName: '', deviceType: '', deviceId: '', deviceIdShort: '',
    mode: 'old',
    bluetoothStatus: '待初始化', statusColorClass: 'status-default',
    bleMode: '待初始化', reinitLoading: false,
    discoveryStarted: false, advertiseReady: false, advertiseStart: false, bleReady: false,
    cmdLoading: false,
    configAddress: '', configChannel: 0, channels,
    p_opening: 50, p_modeIdx: 1, p_limitU: 100, p_limitL: 0,
    p_pressure: '20', p_position: 0, p_compIn: '0', p_compRet: '0',
    p_spMin: 30, p_rpOnMin: 30, p_rpOffDay: 3,
    p_retUpper: '', p_retLower: '',       // 阀后压力上/下限（×10KPa 字节值，page1 data[5][6]）
    p_inletUpper: '', p_inletLower: '',   // 阀前压力上/下限（×10KPa 字节值，设备不回读）
    p_inletCurrent: 0,                    // 进水当前压力字节（page1 data[0]，作为分时压力上限兜底）
    p_threshIn: '', p_threshRet: '',      // 进水/阀后压力报警阈值（×10KPa 字节值，page2 data[11][12]）
    p_psEnable: false,                       // 分时压力总使能
    p_slots: [                               // 5 段：on=启用 time=HH:MM kpa=压力
      { id: 0, on: false, time: '00:00', kpa: '' }, { id: 1, on: false, time: '00:00', kpa: '' },
      { id: 2, on: false, time: '00:00', kpa: '' }, { id: 3, on: false, time: '00:00', kpa: '' },
      { id: 4, on: false, time: '00:00', kpa: '' },
    ],
    logs: [], workModes, workModeCodes,
    dashboard: null,
    updateTime: '',
    readStatus: { isReading: false, page1Done: false, page2Done: false, page1Data: '', page2Data: '', timer: null },
    page2Failed: false,
    readMode: 'single',
  },
  onLoad() {
    resetSeq()
    const store = useDeviceStore()
    const device = store.currentDevice
    if (!device) { wx.navigateBack(); return }
    const id = device.deviceId || ''
    // 广播地址取设备编号后 6 位：优先从广播名前缀提取，取不到再用上次手动输入(storage)。
    // deviceId 在 iOS 是随机 UUID，不能当地址用。
    const nameAddr = extractAddr(device.localName || device.name || device.deviceName || '')
    const savedAddr = (wx.getStorageSync('address') || '').replace(/\s+/g, '').toLowerCase()
    const savedChannel = wx.getStorageSync('channel') || '37'
    this.setData({
      themeClass: store.themeClass,
      themeIcon: store.themeIcon,
      deviceName: id,
      deviceType: device.valveType || '',
      deviceId: id,
      deviceIdShort: id.slice(-6),
      configAddress: nameAddr || savedAddr,
      mode: device.valveTypeId || 'old',
      configChannel: Math.max(0, channels.indexOf(savedChannel)),
    })
    this.protocol = getProtocol(this.data.mode)
    this.cmds = this.protocol.commands
    // 广播模式也记入「连接记录」，下次可从首页历史直接进入、无需重新扫描
    if (id) {
      store.addDevice({
        deviceId: id,
        localName: device.localName || device.name || device.deviceName || '',
        valveType: device.valveType || '',
        valveTypeId: device.valveTypeId || 'old',
        mode: 'broadcast',
      })
    }
    this.loadLogs()
    this.initBluetooth()
  },
  onShow() {
    this.setData({ themeClass: useDeviceStore().themeClass, themeIcon: useDeviceStore().themeIcon })
  },
  onUnload() {
    this.clearTimer()
    this.stopAdvertising()
    this.stopDiscovery()
    if (this._bleServer) {
      this._bleServer.close().catch(() => {})
    }
    wx.closeBluetoothAdapter({ fail: () => {} })
  },
  clearTimer() {
    const t = this.data.readStatus.timer
    if (t) { clearTimeout(t); this.setData({ 'readStatus.timer': null }) }
  },
  updateStatus(text, cls) {
    this.setData({ bluetoothStatus: text, statusColorClass: cls || '' })
  },
  // 根据广播/监听/就绪状态推导「蓝牙模式」，供蓝牙配置区实时展示
  syncBleMode() {
    const { advertiseStart, advertiseReady, discoveryStarted, bleReady } = this.data
    let mode
    if (advertiseStart && discoveryStarted) mode = '广播 + 监听'
    else if (advertiseStart) mode = '广播中'
    else if (discoveryStarted) mode = '监听中'
    else if (advertiseReady || bleReady) mode = '待机（服务就绪）'
    else mode = '待初始化'
    this.setData({ bleMode: mode })
  },
  initBluetooth() {
    this.updateStatus('初始化蓝牙...', 'status-loading')
    wx.openBluetoothAdapter({
      success: () => {
        this.updateStatus('蓝牙就绪', 'status-success')
        this.initDiscovery()
        this.initAdvertiseServer()
      },
      fail: () => { this.updateStatus('请开启蓝牙', 'status-error') }
    })
  },
  initDiscovery() {
    if (this.data.discoveryStarted) return
    wx.startBluetoothDevicesDiscovery({
      allowDuplicatesKey: true,
      powerLevel: 'high',
      success: () => {
        this.setData({ discoveryStarted: true })
        this.syncBleMode()
        this.onBLEFound()
      }
    })
  },
  stopDiscovery() {
    if (this.data.discoveryStarted) {
      wx.stopBluetoothDevicesDiscovery({ fail: () => {} })
      this.setData({ discoveryStarted: false })
      this.syncBleMode()
    }
  },
  initAdvertiseServer() {
    wx.createBLEPeripheralServer().then(res => {
      this._bleServer = res.server
      this.setData({ advertiseReady: true })
      this.syncBleMode()
    }).catch(() => {})
  },
  onBLEFound() {
    wx.onBluetoothDeviceFound(res => {
      res.devices.forEach(device => {
        if (device.localName !== FILTER_NAME) return
        if (!device.advertisData) return
        const hex = ab2hex(device.advertisData).substring(4)
        const rssi = device.RSSI
        this.logResp(hex)

        const { isReading, page1Done, page2Done } = this.data.readStatus
        const { readMode } = this.data

        // 读模式下优先匹配 3F/3E
        if (isReading) {
          if (readMode === 'single') {
            if (!page1Done && hex.slice(0, 2) === '3F') {
              this.clearTimer()
              this.setData({
                'readStatus.page1Done': true,
                'readStatus.page1Data': hex
              })
              this.storePage(hex, rssi)
              this.finishRead()
              return
            }
          }
          if (readMode === 'full') {
            if (!page1Done) {
              if (hex.slice(0, 2) === '3F') {
                this.clearTimer()
                this.setData({
                  'readStatus.page1Done': true,
                  'readStatus.page1Data': hex
                })
                this.storePage(hex, rssi)
                this.updateStatus('已收第一页，开始读取第二页', 'status-processing')
                this.startPage2()
                return
              }
            } else if (!page2Done) {
              if (hex.slice(0, 2) === '4F') {
                this.clearTimer()
                this.setData({
                  'readStatus.page2Done': true,
                  'readStatus.page2Data': hex
                })
                this.storePage(hex, rssi)
                this.finishRead()
                return
              }
            }
          }
        }

        if (hex.slice(0, 2) === '3F') {
          this.updateDashboard(hex, rssi)
        }
      })
    })
  },
  startRead() {
    if (!this.data.configAddress) {
      wx.showToast({ title: '请配置设备地址', icon: 'none' })
      return
    }
    if (this.data.readStatus.isReading) return
    this._readRetries = 0
    this._page1Hex = null
    this._page2Hex = null
    // 先导阀参数分两页(0x3F/0x4F)，电池/信号/阈值/分时压力在第二页 → 读全部
    const readMode = this.data.mode === 'new' ? 'full' : 'single'
    this.setData({
      cmdLoading: true,
      readMode,
      page2Failed: false,
      readStatus: { isReading: true, page1Done: false, page2Done: false, page1Data: '', page2Data: '', timer: null }
    })
    this.updateStatus('正在读取状态...', 'status-processing')
    this.loopPage1()
  },
  loopPage1() {
    // 守卫：读取已停止 / 第一页已收到，则不再重发（由收到 3F 的分支 clearTimer 并推进流程）
    if (!this.data.readStatus.isReading || this.data.readStatus.page1Done) return
    // 已重发 MAX_RETRIES 次仍未收到 3F 回复 → 判定「读取超时，设备无响应」
    // 这不是解析 bug：是在时序预算内没扫到设备回帧。排查方向：广播信道、设备地址、距离/设备是否休眠。
    if (this._readRetries >= MAX_RETRIES) {
      this.finishRead()
      this.updateStatus('读取超时', 'status-error')
      wx.showToast({ title: '读取超时，设备无响应', icon: 'none' })
      return
    }
    this._readRetries++
    // 发一帧 queryPage1；发送回调里再装配「RESEND_DELAY 后重试」的定时器。
    // 收到 3F 时会 clearTimer 打断该定时器；否则到点后回到 loopPage1 走下一次重试或超时。
    this.sendCmd('queryPage1', () => {
      this.setData({
        'readStatus.timer': setTimeout(() => this.loopPage1(), RESEND_DELAY)
      })
    })
  },
  startPage2() {
    this._readRetries2 = 0
    this.updateStatus('正在读取第二页...', 'status-processing')
    this.loopPage2()
  },
  // 仅重读第二页：保留已读到的第一页(_page1Hex)，只重跑 page2 流程。
  // 收到 4F 后走 onBLEFound 的 full/page2 分支 → storePage + finishRead 合并渲染两页。
  retryPage2() {
    if (this.data.readStatus.isReading) return
    if (!this._page1Hex) { wx.showToast({ title: '请先读取设备', icon: 'none' }); return }
    this.setData({
      cmdLoading: true,
      readMode: 'full',
      page2Failed: false,
      // page1Done=true 让接收分支直接进入「等待 4F」；保留第一页原始数据
      readStatus: { isReading: true, page1Done: true, page2Done: false, page1Data: this._page1Hex, page2Data: '', timer: null },
    })
    this.startPage2()
  },
  loopPage2() {
    if (!this.data.readStatus.isReading || this.data.readStatus.page2Done) return
    this.loopPage2Cmd()
  },
  loopPage2Cmd() {
    // 守卫：已完成/已停止读取则直接返回，避免异步回调装配的孤儿定时器把成功状态改写为「无响应」
    if (!this.data.readStatus.isReading || this.data.readStatus.page2Done) return
    // 第二页超时：第一页已成功，按部分完成收尾（保留第一页数据），并置 page2Failed 让界面出现「重读第二页」
    if (this._readRetries2 >= MAX_RETRIES) {
      this.finishRead()
      this.setData({ page2Failed: true })
      this.updateStatus('第二页无响应，仅显示第一页', 'status-success')
      return
    }
    this._readRetries2++
    this.sendCmd('queryPage2', () => {
      this.setData({
        'readStatus.timer': setTimeout(() => this.loopPage2Cmd(), RESEND_DELAY)
      })
    })
  },
  sendCmd(cmdKey, callback) {
    const fn = this.cmds[cmdKey]
    if (!fn) return
    const cmd = fn()
    const hex = toHex(cmd)
    this.sendRaw(hex, callback)
  },
  // 把一帧命令 hex 通过 BLE 外围广播发出去。设备收到后会回广播，由 onBLEFound 扫描解析。
  sendRaw(hex, callback) {
    this.logCmd(hex)
    const addr = (this.data.configAddress || '').replace(/\s+/g, '').toLowerCase()
    if (addr.length < 6 || addr.length > 10) {
      wx.showToast({ icon: 'none', title: '请先填写设备地址(编号后6位)' })
      callback && callback(); return
    }
    wx.setStorageSync('address', addr)
    // 按设备地址 + 信道对 payload 做加白/CRC 编码（信道取 storage 'channel'，默认 37）。
    // 若此处信道与设备实际工作信道不一致，设备无法解码 → 不回复 → 读取超时。
    const actPayload = generateDataWithAddr(addr, hex)
    if (!actPayload) { callback && callback(); return }
    const buf = new ArrayBuffer(actPayload.length)
    const view = new Uint8Array(buf)
    for (let i = 0; i < actPayload.length; i++) {
      view[i] = actPayload[i] < 0 ? actPayload[i] + 256 : actPayload[i]
    }
    const srv = this._bleServer
    if (!srv) { callback && callback(); return }
    // 关键：先 await 上一次广播停止，再发起新广播。避免 stop 未完成时 startAdvertising 被适配器拒绝，
    // 那样会走 .catch 空转一次重试（只等待、没真正发命令），是此前读取超时偏多的脆弱点。
    this.stopAdvertising().then(() => srv.startAdvertising({
      advertiseRequest: {
        connectable: true,
        deviceName: '',
        manufacturerData: [{ manufacturerId: MANUFACTURER_ID, manufacturerSpecificData: buf }],
      },
      powerLevel: 'high',
    })).then(() => {
      this.setData({ advertiseStart: true })
      this.syncBleMode()
      // 只广播 AD_DURATION(400ms) 后即停，并触发 callback（在 loopPageX 里 callback 负责装配重试定时器）。
      setTimeout(() => {
        this.stopAdvertising()
        callback && callback()
      }, AD_DURATION)
    }).catch(() => { callback && callback() })
  },
  // 停止广播。返回 Promise，便于 sendRaw 在「停止完成后」再发起新广播（消除 stop/start 竞态）。
  stopAdvertising() {
    this.setData({ advertiseStart: false })
    this.syncBleMode()
    if (this._bleServer) {
      return this._bleServer.stopAdvertising().catch(() => {})
    }
    return Promise.resolve()
  },
  getSeq() {
    const map = '0123456789abcdef'
    const c = map[(this._seq || 0) % 16]
    this._seq = (this._seq || 0) + 1
    return c
  },
  // 把已收到的页数据渲染成「分组仪表盘」结构（读取全部完成后统一调用一次，布局不随分页到达而抖动）。
  // dashboard = { alert:故障文本, groups:[{title,items:[{key,label,value,full}]}], timeShare:{enabled,slots}|null }
  renderStatus() {
    const isNew = this.data.mode === 'new'
    const p1 = this._page1Hex
    const p2 = this._page2Hex
    if (!p1 && !p2) { this.setData({ dashboard: null }); return }

    if (isNew) {
      // 汇总两页所有可解析字段到 key→{label,value}（分时使能单独处理，不进此表）
      const vals = {}
      if (p1) PAGE1_LAYOUT_NEW.forEach(i => { if (i.parse) vals[i.key] = { label: i.label, value: i.parse(p1.slice(i.start, i.end)) } })
      if (p2) PAGE2_LAYOUT_NEW.forEach(i => { if (i.parse && i.key !== 'timeEnable') vals[i.key] = { label: i.label, value: i.parse(p2.slice(i.start, i.end)) } })

      // 故障状态 → 顶部告警条（正常则不显示）
      let alert = ''
      if (p1) { const st = valveStatus(p1.slice(16, 18)); if (st !== '正常') alert = st }

      // 按语义分组，仅保留有数据的组/项；长文本(如功能位)整行占满
      const groups = NEW_DASH_GROUPS.map(g => ({
        title: g.title,
        items: g.keys.filter(k => vals[k]).map(k => ({
          key: k, label: vals[k].label, value: vals[k].value, full: vals[k].value.length > 8,
        })),
      })).filter(g => g.items.length)

      // 分时压力独立区：开启状态 + 已启用时段列表
      const timeShare = p2 ? { enabled: u8(p2.slice(2, 4)) === 1, slots: timeSlotRows(p2) } : null

      this.setData({ dashboard: { alert, groups, timeShare }, updateTime: new Date().toLocaleString() })
      if (p1) this.syncInputs(p1, true)
      if (p2) this.syncTimeSlots(p2)
    } else {
      // 旧阀：单组扁平展示
      const items = []
      if (p1) PAGE1_LAYOUT.forEach(i => { if (i.parse) items.push({ key: i.key, label: i.label, value: i.parse(p1.slice(i.start, i.end)), full: false }) })
      this.setData({
        dashboard: { alert: '', groups: items.length ? [{ title: '参数', items }] : [], timeShare: null },
        updateTime: new Date().toLocaleString(),
      })
      if (p1) this.syncInputs(p1, false)
    }
  },
  // 回读到的参数回填到控制表单，保证「读取后再调整」的数值正确
  syncInputs(p1, isNew) {
    const b = k => parseInt(p1.slice(2 + 2 * k, 4 + 2 * k), 16) || 0
    if (isNew) {
      const sb = k => { const n = parseInt(p1.slice(2 + 2 * k, 4 + 2 * k), 16) || 0; return n > 127 ? n - 256 : n }
      this.setData({
        p_pressure: String(b(2)),           // 设定压力（×10KPa 字节值）
        p_position: b(9),                   // 阀门圈数
        p_limitU: b(11),                    // 圈数上限
        p_limitL: b(12),                    // 圈数下限
        p_compIn: String(sb(3)),            // 阀前压力补偿 KPa（INT8，1KPa/unit）
        p_compRet: String(sb(4)),           // 阀后压力补偿 KPa
        p_retUpper: String(b(5)),           // 阀后压力上限（×10KPa 字节值）
        p_retLower: String(b(6)),           // 阀后压力下限（×10KPa 字节值）
        p_inletCurrent: b(0),              // 进水当前压力字节（分时压力上限兜底）
        p_spMin: b(13) * 10,               // 采样周期 分钟（×10 转分）
        p_rpOnMin: b(14) * 10,             // 上报周期(供暖期) 分钟
      })
    } else {
      const modeIdx = workModeCodes.indexOf(b(0))
      this.setData({
        p_opening: b(2), p_limitU: b(3) || 100, p_limitL: b(4),
        p_spMin: b(5) * 10 || 30, p_rpOnMin: b(6) * 10 || 30, p_rpOffDay: b(7) || 3,
        p_modeIdx: modeIdx >= 0 ? modeIdx : 0,
      })
    }
  },
  // 第二页读回后，把分时压力使能与 5 段回填到设置表单（0xFF=停用）
  syncTimeSlots(p2) {
    const slots = []
    for (let i = 0; i < 5; i++) {
      const off = 4 + i * 4
      const tb = u8(p2.slice(off, off + 2))
      if (tb === 255) { slots.push({ id: i, on: false, time: '00:00', kpa: '' }) }
      else { slots.push({ id: i, on: true, time: hhmm(tb * 10), kpa: String(u8(p2.slice(off + 2, off + 4))) }) }
    }
    this.setData({
      p_psEnable: u8(p2.slice(2, 4)) === 1, p_slots: slots,
      p_threshIn: String(u8(p2.slice(24, 26))),    // 阀前压力阈值（×10KPa 字节值）
      p_threshRet: String(u8(p2.slice(26, 28))),   // 阀后压力阈值（×10KPa 字节值）
    })
  },
  // 仅缓存收到的页数据，不渲染（读取过程中调用，避免布局随分页逐页刷新而抖动）
  storePage(hex, rssi) {
    this._lastRssi = rssi
    const head = hex.slice(0, 2)
    if (head === '3F' && hex.length >= 32) this._page1Hex = hex
    else if (head === '4F' && hex.length >= 32) this._page2Hex = hex
  },
  // 缓存 + 即时渲染（被动监听场景：非读取流程中收到 3F 广播时实时更新）
  updateDashboard(hex, rssi) {
    this.storePage(hex, rssi)
    this.renderStatus()
  },
  finishRead() {
    this.clearTimer()
    if (this._readTimeout) { clearTimeout(this._readTimeout); this._readTimeout = null }
    this.stopAdvertising()
    this.setData({
      cmdLoading: false,
      readStatus: { isReading: false, page1Done: false, page2Done: false, page1Data: '', page2Data: '', timer: null }
    })
    // 读取结束后一次性把所有已缓存页渲染到仪表盘，保证各显示区同时出现、布局稳定
    this.renderStatus()
    this.updateStatus('读取完成', 'status-success')
  },

  /* ========== Send 控制指令（不用回读） ========== */
  sendTargetPressure() {
    const v = Number(this.data.p_pressure) || 0    // 控制页单位 ×10KPa，直接作为字节发送
    if (v < 0 || v > 160) { wx.showToast({ title: '目标压力 0~160(×10KPa)', icon: 'none' }); return }
    this.execCmd('setTargetPressure', null, [v])
  },
  sendPressureLimits() {
    const n = k => { const v = Number(this.data[k]) || 0; return v }
    const vals = [n('p_inletUpper'), n('p_inletLower'), n('p_retUpper'), n('p_retLower')]
    if (vals.some(v => v < 0 || v > 160)) { wx.showToast({ title: '压力值超出范围 0~160(×10KPa)', icon: 'none' }); return }
    this.execCmd('setPressureLimits', '设置压力上下限？', vals)
  },
  sendReportCycle() {
    const s = Math.round(Number(this.data.p_spMin) / 10)     // 分钟→×10min 字节
    const r = Math.round(Number(this.data.p_rpOnMin) / 10)
    const d = Number(this.data.p_rpOffDay) || 0
    if (s < 1 || s > 255 || r < 1 || r > 255) { wx.showToast({ title: '采样/供暖上报需在 10~2550(分)', icon: 'none' }); return }
    if (d < 1 || d > 255) { wx.showToast({ title: '非供暖上报需在 1~255(天)', icon: 'none' }); return }
    this.execCmd('setReportCycle', null, [s, r, d])
  },
  sendPressureThreshold() {
    const i = Number(this.data.p_threshIn) || 0
    const r = Number(this.data.p_threshRet) || 0
    if (i < 0 || i > 160 || r < 0 || r > 160) { wx.showToast({ title: '压力阈值超出范围 0~160(×10KPa)', icon: 'none' }); return }
    this.execCmd('setPressureThreshold', null, [i, r])
  },
  // 分时压力：总使能 / 每段开关 / 时间 / 压力
  // 分时压力总开关：关闭时把下面所有分时开关一起关掉；开启时保持子开关现状
  onPsEnableToggle(e) {
    const on = !!e.detail.value
    const patch = { p_psEnable: on }
    if (!on) {
      this.data.p_slots.forEach((s, i) => { patch[`p_slots[${i}].on`] = false })
    }
    this.setData(patch)
  },
  // 分时开关：只要有一个子分时被打开，总开关就自动跟着开启；全部关掉时总开关也一起关闭
  onSlotToggle(e) {
    const idx = e.currentTarget.dataset.idx
    const on = !!e.detail.value
    const patch = { [`p_slots[${idx}].on`]: on }
    if (on) {
      patch.p_psEnable = true
    } else {
      const anyOn = this.data.p_slots.some((s, i) => i !== idx && s.on)
      if (!anyOn) patch.p_psEnable = false
    }
    this.setData(patch)
  },
  onSlotTime(e) { this.setData({ [`p_slots[${e.currentTarget.dataset.idx}].time`]: e.detail.value }) },
  onSlotKpa(e) { this.setData({ [`p_slots[${e.currentTarget.dataset.idx}].kpa`]: e.detail.value }) },
  sendTimePressure() {
    // 分时压力上限：优先取进水上限/当前阀前压力，未设置则用硬顶 160(=1600KPa=1.6MPa)
    const inletUpper = Number(this.data.p_inletUpper) || this.data.p_inletCurrent
    const max = inletUpper ? Math.min(inletUpper, 160) : 160

    const slots = this.data.p_slots
    const active = []
    for (let i = 0; i < 5; i++) {
      const s = slots[i]
      if (!s.on) continue
      if (!s.time) { wx.showToast({ title: `分时${i + 1} 未选时间`, icon: 'none' }); return }
      const [h, m] = s.time.split(':').map(Number)
      const v = Number(s.kpa) || 0
      if (v <= 0 || v > max) { wx.showToast({ title: `分时${i + 1} 压力需在 1~${max}(×10KPa)`, icon: 'none' }); return }
      active.push({ min: h * 60 + m })
    }
    if (this.data.p_psEnable && !active.length) { wx.showToast({ title: '请至少启用一个时段', icon: 'none' }); return }
    for (let k = 1; k < active.length; k++) {
      if (active[k].min <= active[k - 1].min) { wx.showToast({ title: '时段时间需按先后递增', icon: 'none' }); return }
    }
    this.execCmd('setTimePressure', '下发分时压力设置？', slotsToParams(this.data.p_psEnable, slots))
  },
  sendControlCmd(e) {
    const action = e.currentTarget.dataset.action
    if (!this.data.configAddress || this.data.cmdLoading) return
    // 先导阀是压力阀，无开/关指令：全开=同步阀门圈数到「圈数上限」，全关=同步到0
    if (this.data.mode === 'new') {
      let pos = 0
      if (action === 'openAll') {
        const p1 = this._page1Hex
        if (!p1) { wx.showToast({ icon: 'none', title: '请先读取设备获取圈数上限' }); return }
        pos = parseInt(p1.slice(24, 26), 16) || 0   // data[11] = 圈数上限
      }
      this.execCmd('syncValvePosition', null, [pos])
      return
    }
    this.setData({ cmdLoading: true })
    const cmd = this.buildCtrlCmd(action)
    if (!cmd) { this.setData({ cmdLoading: false }); return }
    this.sendRaw(cmd, () => {
      this.setData({ cmdLoading: false })
      this.updateStatus('指令已发送', 'status-success')
    })
  },
  buildCtrlCmd(action) {
    const seq = this.getSeq()
    let cmd
    switch (action) {
      case 'openAll': cmd = '221' + seq + '64'; break
      case 'closeAll': cmd = '221' + seq + '00'; break
      case 'setOpening':
        const v = parseInt(this.data.p_opening)
        if (isNaN(v) || v < 0 || v > 100) return null
        cmd = '221' + seq + ('0' + v.toString(16)).slice(-2); break
      default: return null
    }
    return cmd.padEnd(32, 'f')
  },

  /* ========== 配置相关 ========== */
  toggleConfig() { this.setData({ showConfig: !this.data.showConfig }) },
  onChannelChange(e) {
    const idx = e.detail.value
    this.setData({ configChannel: idx })
    wx.setStorageSync('channel', channels[idx])
  },
  onAddressBlur(e) {
    const addr = (e.detail.value || '').toLowerCase().replace(/[^0-9a-f]/g, '').slice(0, 10)
    this.setData({ configAddress: addr })
    if (addr.length >= 6 && addr.length <= 10) wx.setStorageSync('address', addr)
  },
  loadLogs() {
    const logs = wx.getStorageSync('broadcastHistory') || []
    this.setData({ logs })
  },
  saveLogs() {
    wx.setStorageSync('broadcastHistory', this.data.logs)
  },
  logCmd(hex) {
    const records = this.data.logs
    records.unshift({ name: '发送指令', hex, time: fmtTime(), ok: true, dir: 'send' })
    if (records.length > 50) records.length = 50
    this.setData({ logs: records })
    this.saveLogs()
  },
  logResp(hex) {
    const records = this.data.logs
    records.unshift({ name: '收到广播', hex, time: fmtTime(), ok: true, dir: 'recv' })
    if (records.length > 50) records.length = 50
    this.setData({ logs: records })
    this.saveLogs()
  },
  toggleTheme() {
    const store = useDeviceStore()
    store.toggleDarkMode()
    this.setData({ themeClass: store.themeClass, themeIcon: store.themeIcon })
  },
  switchTab(e) {
    this.setData({ tab: e.currentTarget.dataset.tab })
  },
  initBle() {
    return new Promise((resolve, reject) => {
      if (this._bleReady) { resolve(); return }
      wx.openBluetoothAdapter({
        success: () => {
          wx.createBLEPeripheralServer().then(res => {
            this._bleServer = res.server
            this._bleReady = true
            this.setData({ bleReady: true })
            resolve()
          }).catch(reject)
        },
        fail: (err) => { reject(new Error('蓝牙初始化失败: ' + err.errMsg)) }
      })
    })
  },
  initBleSvc() {
    wx.showLoading({ title: '初始化...' })
    this.initBle().then(() => {
      wx.hideLoading()
      wx.showToast({ title: '蓝牙已就绪', icon: 'success' })
    }).catch(err => {
      wx.hideLoading()
      wx.showToast({ icon: 'none', title: err.message })
    })
  },
  // 扫码取设备编号后6位填入地址，并重新初始化蓝牙
  scanAddr() {
    const that = this
    wx.scanCode({
      onlyFromCamera: false,
      success(res) {
        const raw = (res.result || '').trim()
        if (!raw) { wx.showToast({ icon: 'none', title: '未识别到二维码内容' }); return }
        // 地址为 16 进制(6位)，只取扫描结果里的十六进制字符的最后6位
        const hex = raw.toLowerCase().match(/[0-9a-f]/g) || []
        const addr = hex.slice(-6).join('')
        if (addr.length < 6) { wx.showToast({ icon: 'none', title: '未识别到有效的设备编号' }); return }
        that.setData({ configAddress: addr })
        wx.setStorageSync('address', addr)
        wx.showToast({ icon: 'success', title: '已填入编号后6位' })
        that.reinitBle()
      },
      fail() { /* 用户取消，静默不提示 */ }
    })
  },
  // 重新初始化蓝牙：先停掉广播/扫描并关闭旧 server，再重建；过程中状态栏与模式实时可见变化
  reinitBle() {
    if (this.data.reinitLoading) return
    this.setData({ reinitLoading: true, bluetoothStatus: '重新初始化中...', statusColorClass: 'status-processing' })
    this.clearTimer()
    this.stopAdvertising()
    this.stopDiscovery()
    const srv = this._bleServer
    this._bleServer = null
    this._bleReady = false
    this.setData({ advertiseReady: false, advertiseStart: false, bleReady: false })
    this.syncBleMode()
    const finish = (ok, msg, cls) => {
      this.setData({ reinitLoading: false })
      this.updateStatus(msg, cls)
      this.syncBleMode()
    }
    const rebuild = () => {
      wx.openBluetoothAdapter({
        success: () => {
          this.initDiscovery()
          this.initAdvertiseServer()
          finish(true, '蓝牙已重新初始化', 'status-success')
        },
        fail: () => finish(false, '请开启蓝牙', 'status-error')
      })
    }
    if (srv) {
      srv.stopAdvertising().catch(() => {}).then(() => {
        srv.close().catch(() => {}).then(rebuild)
      }).catch(rebuild)
    } else {
      rebuild()
    }
  },
  execCmd(cmdKey, confirmMsg, params) {    if (confirmMsg) {
      const that = this
      wx.showModal({ title: '确认', content: confirmMsg, success(r) {
        if (r.confirm) that.execCmd(cmdKey, null, params)
      }})
      return
    }
    const fn = this.cmds[cmdKey]
    if (!fn) { wx.showToast({ title: '未知指令', icon: 'none' }); return }
    let cmd
    if (params) {
      const nums = params.map(p => Number(p) || 0)
      cmd = fn(...nums)
    } else {
      cmd = fn()
    }
    const hex = toHex(cmd)
    this.sendRaw(hex, () => {
      wx.vibrateShort({ type: 'light' })
    })
  },
  onCopy(e) {
    wx.setClipboardData({ data: e.currentTarget.dataset.hex })
    wx.showToast({ title: '已复制', icon: 'success' })
  },
  clearLogs() {
    resetSeq()
    this.setData({ logs: [] })
    wx.setStorageSync('broadcastHistory', [])
  },
})
</script>

<style scoped>
/* ====================================================================
   工业机械风 · 蓝牙广播控制页
   --------------------------------------------------------------
   取色全部走 app.mpx 语义变量：工业橙主色 --color-primary、金属灰
   面板系、绿/琥珀/红状态色；根节点 .app 挂 dark 即整体切换暗档。
   蓝色零残留：原 iOS 蓝（#007AFF / #0A84FF 系）已全部替换。
   ================================================================ */

/* ---------- 页面容器：透出 page 层主题背景纹理 ----------
   状态 tint 令牌（tint 系与 line 系）已收编到 app.mpx 全局主题层，
   随风格（工业、能源、蓝图）与明暗档自动切换，此处不再局部覆写。 */
.app {
  min-height: 100vh;
  padding: 0 0 120rpx 0;
}

/* ======================= SHARED ========================== */

.tab-content {
  padding: 24rpx 20rpx;
}

/* 主题切换：金属旋钮 */
.theme-toggle {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  border-radius: 50%;
  background: var(--grad-btn-outline);
  border: 2rpx var(--panel-border-style) var(--color-border-strong);
  box-shadow: inset 2rpx 2rpx 0 var(--color-highlight), inset -2rpx -2rpx 0 rgba(0, 0, 0, 0.12);
  margin-left: 12rpx;
  flex-shrink: 0;
  transition: transform .2s ease, filter .2s ease;
}
.theme-toggle:active { transform: scale(0.9) rotate(-15deg); filter: brightness(0.95); }

/* ======================= DASHBOARD ========================== */

/* ---------- 仪表盘头图：拉丝金属仪表面板（riveted 四角螺丝） ---------- */
.db-hero {
  position: relative;
  overflow: hidden;
  margin: -24rpx -20rpx 28rpx;
  padding: 48rpx 36rpx 44rpx;
  background: var(--grad-panel);
  border: 2rpx var(--panel-border-style) var(--color-border);
  border-radius: 0 0 var(--radius-lg) var(--radius-lg);
  box-shadow:
    inset 0 6rpx 0 0 var(--color-primary),
    inset 2rpx 2rpx 0 var(--color-highlight),
    inset -2rpx -2rpx 0 rgba(0, 0, 0, 0.12),
    var(--shadow-float);
}
.db-hero-deco { position: absolute; border-radius: 50%; pointer-events: none; }
.db-hero-deco.hd1 {
  width: 300rpx; height: 300rpx; top: -130rpx; right: -70rpx;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.10) 0%, transparent 65%);
}
.db-hero-deco.hd2 {
  width: 160rpx; height: 160rpx; bottom: -60rpx; left: -30rpx;
  border: 2rpx solid var(--color-border);
  box-shadow: inset 0 0 0 2rpx var(--color-highlight);
}
.db-hero-top { position: relative; display: flex; align-items: flex-start; justify-content: space-between; }
.db-hero-main { display: flex; flex-direction: column; min-width: 0; flex: 1; }
.db-hero-label { font-size: 22rpx; color: var(--color-text-secondary); letter-spacing: 3rpx; }
.db-hero-title {
  margin-top: 10rpx;
  font-size: 32rpx; font-weight: 700; color: var(--color-text);
  font-family: 'DIN Alternate', 'Roboto Mono', 'SF Mono', Menlo, monospace;
  letter-spacing: 1rpx; word-break: break-all;
}
.db-hero-side { display: flex; align-items: center; flex-shrink: 0; margin-left: 20rpx; }

/* ---------- BLE 状态铭牌 + LED：工作=绿光呼吸 / 断开=熄灭 ---------- */
.db-status {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  padding: 6rpx 16rpx;
  border-radius: var(--radius-sm);
}
.db-on {
  background: var(--tint-success);
  color: var(--color-success);
}
.db-off {
  background: var(--color-fill);
  color: var(--color-text-secondary);
}
.db-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--color-track);
  box-shadow: inset 0 0 4rpx rgba(0, 0, 0, 0.4);
}
.db-on .db-dot { background: var(--color-success); box-shadow: 0 0 8rpx var(--color-success); animation: ledBreathe 2s ease-in-out infinite; }
.db-off .db-dot { background: var(--color-text-tertiary); box-shadow: none; }
@keyframes ledBreathe {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.55; }
}

/* ---------- 读取按钮：橙色金属实体键 ---------- */
.db-read-btn {
  width: 100%;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
  background: var(--grad-btn-primary);
  border: 2rpx var(--panel-border-style) var(--color-border-strong);
  border-radius: var(--radius);
  font-size: 30rpx;
  font-weight: 700;
  color: #FFF;
  letter-spacing: 3rpx;
  box-shadow:
    inset 2rpx 2rpx 0 rgba(255, 255, 255, 0.35),
    inset -2rpx -2rpx 0 rgba(0, 0, 0, 0.2),
    0 8rpx 20rpx var(--glow-primary);
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.25);
  transition: transform .15s ease, filter .15s ease;
}
.db-read-btn::after { border: none; }
.db-hero .db-read-btn { margin: 36rpx 0 0; }
.db-read-btn:active { transform: scale(0.98) translateY(2rpx); filter: brightness(0.94); }
.db-read-btn.reading {
  gap: 14rpx;
  opacity: 0.9;
}
.db-spinner {
  width: 30rpx;
  height: 30rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.35);
  border-top-color: #FFF;
  border-radius: 50%;
  animation: db-spin 0.7s linear infinite;
}
@keyframes db-spin {
  to { transform: rotate(360deg); }
}

/* 第二页无响应时的「重读第二页」按钮：琥珀警示 */
.db-retry-btn {
  width: 100%;
  height: 80rpx;
  display: flex; align-items: center; justify-content: center; gap: 10rpx;
  margin-bottom: 24rpx;
  border-radius: var(--radius);
  background: var(--tint-warning);
  color: var(--color-warning);
  border: 1rpx solid var(--line-warning);
  font-size: 26rpx; font-weight: 600;
  letter-spacing: 1rpx;
}
.db-retry-btn::after { border: none; }
.db-retry-btn:active { opacity: 0.8; transform: scale(0.98); }
.db-retry-icon { font-size: 30rpx; }

/* ---------- 故障告警条：红色警示铭牌 ---------- */
.db-alert {
  display: flex; align-items: center; gap: 14rpx;
  background: var(--tint-danger);
  border: 1rpx solid var(--line-danger);
  border-radius: var(--radius-lg);
  padding: 20rpx; margin-bottom: 16rpx;
}
.db-alert-icon {
  width: 44rpx; height: 44rpx; flex-shrink: 0;
  border-radius: 50%; background: var(--color-danger); color: #FFF;
  font-size: 30rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  animation: alertPulse 1.6s ease-in-out infinite;
}
.db-alert-body { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4rpx; }
.db-alert-title { font-size: 22rpx; font-weight: 700; color: var(--color-danger); letter-spacing: 1rpx; }
.db-alert-text { font-size: 24rpx; color: var(--color-text); line-height: 1.4; }
@keyframes alertPulse {
  0%, 100% { box-shadow: 0 0 0 0 var(--line-danger); }
  60% { box-shadow: 0 0 0 12rpx rgba(216, 57, 43, 0); }
}

/* ---------- 分组参数卡：铆钉金属面板 ---------- */
.db-group {
  position: relative;
  background: var(--grad-panel);
  border: 2rpx var(--panel-border-style) var(--color-border);
  border-radius: var(--radius-lg);
  padding: 22rpx 20rpx 18rpx;
  margin-bottom: 16rpx;
  box-shadow:
    inset 2rpx 2rpx 0 var(--color-highlight),
    inset -2rpx -2rpx 0 rgba(0, 0, 0, 0.12),
    var(--shadow-card);
  overflow: hidden;
}
/* 标题行：LED 色条 + 铭牌标题（压力=钢灰 / 阀位=绿 / 设备=琥珀，按序循环） */
.db-group-head { display: flex; align-items: center; margin-bottom: 16rpx; }
.db-group-bar {
  width: 6rpx; height: 26rpx; flex-shrink: 0;
  border-radius: 3rpx; margin-right: 12rpx;
  background: var(--color-accent-2);
}
.db-group-bar.bar-0 { background: var(--color-accent-2); }
.db-group-bar.bar-1 { background: var(--color-success); box-shadow: 0 0 8rpx var(--color-success); }
.db-group-bar.bar-2 { background: var(--color-warning); box-shadow: 0 0 8rpx var(--color-warning); }
.db-group-title {
  font-size: 24rpx; font-weight: 700; color: var(--color-text-secondary);
  letter-spacing: 2rpx;
}
/* 参数格：内凹数据窗（DIN 数码读数） */
.db-grid {
  display: grid; grid-template-columns: 1fr 1fr;
  gap: 2rpx; background: var(--color-border);
  border: 1rpx solid var(--color-border); border-radius: var(--radius-sm); overflow: hidden;
}
.db-cell {
  background: var(--color-panel-2);
  padding: 22rpx 20rpx;
  display: flex; flex-direction: column; gap: 8rpx;
  box-shadow: inset 1rpx 1rpx 0 var(--color-highlight);
}
.db-cell.full { grid-column: 1 / -1; }
.db-cell-val {
  font-size: 34rpx; font-weight: 700; color: var(--color-text);
  font-family: 'DIN Alternate', 'Roboto Mono', 'SF Mono', Menlo, monospace;
  line-height: 1.15; letter-spacing: 1rpx;
}
.db-cell-label { font-size: 20rpx; color: var(--color-text-tertiary); letter-spacing: 1rpx; }

/* ---------- 分时压力独立区 ---------- */
.db-ts-bar { background: var(--color-primary); box-shadow: 0 0 8rpx var(--color-primary); }
.db-ts-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16rpx; }
.db-ts-head .db-group-head { margin-bottom: 0; }
.db-ts-badge { font-size: 20rpx; padding: 5rpx 18rpx; border-radius: var(--radius-sm); font-weight: 600; letter-spacing: 1rpx; }
.db-ts-badge.on { background: var(--tint-success); color: var(--color-success); border: 1rpx solid var(--line-success); }
.db-ts-badge.off { background: var(--color-fill); color: var(--color-text-secondary); border: 1rpx solid var(--color-border); }
.db-ts-list {
  display: flex; flex-direction: column; gap: 2rpx;
  background: var(--color-border); border: 1rpx solid var(--color-border);
  border-radius: var(--radius-sm); overflow: hidden;
}
.db-ts-row { display: flex; align-items: center; gap: 12rpx; background: var(--color-panel-2); padding: 16rpx; }
.db-ts-idx { font-size: 22rpx; color: var(--color-text-secondary); flex-shrink: 0; width: 84rpx; }
.db-ts-range { flex: 1; font-size: 26rpx; font-weight: 600; color: var(--color-text); font-variant-numeric: tabular-nums; font-family: 'DIN Alternate', 'Roboto Mono', 'SF Mono', Menlo, monospace; }
.db-ts-kpa { font-size: 26rpx; font-weight: 700; color: var(--color-success); flex-shrink: 0; font-family: 'DIN Alternate', 'Roboto Mono', 'SF Mono', Menlo, monospace; }
.db-ts-empty { font-size: 24rpx; color: var(--color-text-tertiary); text-align: center; padding: 20rpx 0; letter-spacing: 2rpx; }

/* 最后更新时间 */
.db-updated {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin-top: 20rpx;
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  letter-spacing: 1rpx;
}
.db-updated-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--color-success);
  box-shadow: 0 0 6rpx var(--color-success);
}

.db-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}
.db-placeholder-icon { font-size: 56rpx; color: var(--color-text-tertiary); margin-bottom: 16rpx; }
.db-placeholder-text {
  font-size: 26rpx;
  color: var(--color-text-tertiary);
  letter-spacing: 2rpx;
}

/* 旧版布局选择器（模板未引用，保持兼容） */
.db-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}
.db-header-right {
  display: flex;
  align-items: center;
}
.db-title-row {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
}
.db-title-label {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}
.db-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
  font-family: 'DIN Alternate', 'Roboto Mono', 'SF Mono', Menlo, monospace;
  letter-spacing: 1rpx;
}

/* ======================= CONTROL ========================== */

.ctrl-section {
  margin-bottom: 40rpx;
}
/* 章节标题：螺丝点 + 铭牌 */
.ctrl-section-title {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--color-text-secondary);
  text-transform: uppercase;
  letter-spacing: 3rpx;
  margin-bottom: 14rpx;
  padding: 0 6rpx;
}
.ctrl-section-title::before {
  content: '';
  width: 14rpx; height: 14rpx; border-radius: 50%;
  margin-right: 12rpx; flex-shrink: 0;
  background: radial-gradient(circle at 35% 30%, var(--deco-rivet) 0 3rpx, var(--deco-rivet-shadow) 3.6rpx 5rpx, var(--color-border-strong) 5.6rpx 8rpx);
  box-shadow: inset 0 0 2rpx rgba(0, 0, 0, 0.3), 0 1rpx 2rpx rgba(0, 0, 0, 0.2);
}

.ctrl-quick {
  display: flex;
  gap: 12rpx;
}
/* 快速操作：金属按键（全开=绿 / 全关=红 / 复位=橙） */
.ctrl-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 32rpx 8rpx;
  background: var(--color-panel-2);
  border: 2rpx var(--panel-border-style) var(--color-border);
  border-radius: var(--radius);
  box-shadow:
    inset 2rpx 2rpx 0 var(--color-highlight),
    inset -2rpx -2rpx 0 rgba(0, 0, 0, 0.1);
  transition: all 0.15s;
}
.ctrl-btn::after { border: none; }
.ctrl-btn:active {
  transform: scale(0.95);
  filter: brightness(0.94);
}
.ctrl-btn-icon {
  width: 76rpx; height: 76rpx; line-height: 76rpx;
  border-radius: 50%; text-align: center;
  font-size: 38rpx;
}
.ctrl-btn-label {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text);
  letter-spacing: 2rpx;
}
.ctrl-open .ctrl-btn-icon { color: var(--color-success); background: var(--tint-success); }
.ctrl-close .ctrl-btn-icon { color: var(--color-danger); background: var(--tint-danger); }
/* ↺(U+21BA) 字形本身偏小，加大字号与 ○/⊘ 视觉对齐 */
.ctrl-reset .ctrl-btn-icon { color: var(--color-primary); background: var(--tint-primary); font-size: 46rpx; line-height: 68rpx; }

/* ======================= PARAMETER FIELDS (card style) ========================== */
/* 参数卡：金属面板 + 左侧工业橙标记条 */
.pf-field {
  position: relative;
  background: var(--grad-panel);
  border: 2rpx var(--panel-border-style) var(--color-border);
  border-radius: var(--radius);
  box-shadow:
    inset 6rpx 0 0 0 var(--color-primary),
    inset 2rpx 2rpx 0 var(--color-highlight),
    inset -2rpx -2rpx 0 rgba(0, 0, 0, 0.12),
    var(--shadow-card);
  padding: 28rpx;
  margin-bottom: 28rpx;
}
.pf-row { display: flex; align-items: center; gap: 12rpx; margin-bottom: 8rpx; }
.pf-label {
  font-size: 26rpx; font-weight: 600; color: var(--color-text);
  flex-shrink: 0; width: 140rpx;
}

.pf-inp { display: flex; align-items: center; gap: 8rpx; flex: 1; min-width: 0; }
/* 输入框：内凹金属槽，聚焦橙色描边 */
.pf-input {
  flex: 1; height: 80rpx;
  background: var(--color-panel-2);
  border: 2rpx var(--panel-border-style) var(--color-border);
  box-shadow: inset 2rpx 2rpx 6rpx var(--color-input-inset);
  border-radius: var(--radius-sm);
  padding: 0 16rpx; font-size: 28rpx; color: var(--color-text);
  font-family: 'DIN Alternate', 'Roboto Mono', 'SF Mono', Menlo, monospace;
  text-align: left; box-sizing: border-box; min-width: 0;
  transition: border-color .2s ease, box-shadow .2s ease;
}
.pf-input:focus {
  border-color: var(--color-primary);
  box-shadow: inset 2rpx 2rpx 6rpx var(--color-input-inset), 0 0 0 3rpx var(--glow-primary-soft);
}
.pf-unit { font-size: 24rpx; color: var(--color-text-tertiary); flex-shrink: 0; width: 40rpx; text-align: center; }
/* 设定按钮：橙色金属实体键 */
.pf-btn {
  display: block; margin-left: auto; height: 64rpx; line-height: 60rpx; padding: 0 32rpx;
  background: var(--grad-btn-primary);
  border: 2rpx var(--panel-border-style) var(--color-border-strong);
  border-radius: var(--radius-sm);
  font-size: 24rpx; font-weight: 700; color: #FFF; letter-spacing: 2rpx;
  box-shadow:
    inset 2rpx 2rpx 0 rgba(255, 255, 255, 0.35),
    inset -2rpx -2rpx 0 rgba(0, 0, 0, 0.2),
    0 4rpx 12rpx var(--glow-primary);
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.25);
}
.pf-btn::after { border: none; }
.pf-btn:active { filter: brightness(0.94); transform: translateY(2rpx); }

.pf-group-title {
  display: flex;
  align-items: center;
  font-size: 22rpx; font-weight: 700; color: var(--color-text-secondary);
  text-transform: uppercase; letter-spacing: 3rpx;
  margin-bottom: 16rpx;
}
.pf-group-title::before {
  content: '';
  width: 14rpx; height: 14rpx; border-radius: 50%;
  margin-right: 12rpx; flex-shrink: 0;
  background: radial-gradient(circle at 35% 30%, var(--deco-rivet) 0 3rpx, var(--deco-rivet-shadow) 3.6rpx 5rpx, var(--color-border-strong) 5.6rpx 8rpx);
  box-shadow: inset 0 0 2rpx rgba(0, 0, 0, 0.3), 0 1rpx 2rpx rgba(0, 0, 0, 0.2);
}

/* 分时压力 */
.ps-main-sw { margin-left: auto; transform: scale(0.8); }
.ps-slot { display: flex; align-items: center; gap: 10rpx; margin-bottom: 14rpx; }
.ps-idx { font-size: 22rpx; color: var(--color-text-secondary); flex-shrink: 0; width: 78rpx; }
.ps-time { flex-shrink: 0; }
.ps-time-val {
  min-width: 108rpx; height: 68rpx; line-height: 64rpx; text-align: center;
  background: var(--color-panel-2);
  border: 2rpx var(--panel-border-style) var(--color-border);
  box-shadow: inset 2rpx 2rpx 6rpx var(--color-input-inset);
  border-radius: var(--radius-sm);
  font-size: 26rpx; color: var(--color-text);
  font-family: 'DIN Alternate', 'Roboto Mono', 'SF Mono', Menlo, monospace;
}
.ps-time-val.ps-off { color: var(--color-text-tertiary); }
.ps-kpa {
  flex: 1; min-width: 0; height: 68rpx;
  background: var(--color-panel-2);
  border: 2rpx var(--panel-border-style) var(--color-border);
  box-shadow: inset 2rpx 2rpx 6rpx var(--color-input-inset);
  border-radius: var(--radius-sm);
  padding: 0 14rpx; font-size: 26rpx; color: var(--color-text);
  font-family: 'DIN Alternate', 'Roboto Mono', 'SF Mono', Menlo, monospace;
  box-sizing: border-box; text-align: left;
  transition: border-color .2s ease, box-shadow .2s ease;
}
.ps-kpa:focus {
  border-color: var(--color-primary);
  box-shadow: inset 2rpx 2rpx 6rpx var(--color-input-inset), 0 0 0 3rpx var(--glow-primary-soft);
}
.ps-unit { font-size: 22rpx; color: var(--color-text-tertiary); flex-shrink: 0; }
.ps-sw { transform: scale(0.68); flex-shrink: 0; }

/* 蓝牙配置：铆钉金属面板（riveted 四角螺丝） */
.ctrl-group {
  background: var(--grad-panel);
  border: 2rpx var(--panel-border-style) var(--color-border);
  border-radius: var(--radius);
  box-shadow:
    inset 2rpx 2rpx 0 var(--color-highlight),
    inset -2rpx -2rpx 0 rgba(0, 0, 0, 0.12),
    var(--shadow-card);
  overflow: hidden;
}

.ctrl-row {
  display: flex;
  align-items: center;
  padding: 20rpx 20rpx;
  border-bottom: 1rpx solid var(--color-border);
  gap: 12rpx;
}
.ctrl-row:last-child { border-bottom: none; }
.ctrl-label {
  font-size: 28rpx;
  color: var(--color-text);
  flex-shrink: 0;
  min-width: 100rpx;
}
/* 设备地址：内凹金属槽（hex 等宽字） */
.ctrl-addr {
  height: 64rpx;
  background: var(--color-panel-2);
  border: 2rpx var(--panel-border-style) var(--color-border);
  box-shadow: inset 2rpx 2rpx 6rpx var(--color-input-inset);
  border-radius: var(--radius-sm);
  padding: 0 14rpx;
  font-size: 26rpx;
  color: var(--color-text);
  font-family: 'SF Mono', Menlo, 'Roboto Mono', monospace;
  display: inline-flex;
  align-items: center;
  min-width: 160rpx;
  box-sizing: border-box;
  transition: border-color .2s ease, box-shadow .2s ease;
}
.ctrl-addr:focus {
  border-color: var(--color-primary);
  box-shadow: inset 2rpx 2rpx 6rpx var(--color-input-inset), 0 0 0 3rpx var(--glow-primary-soft);
}
.ctrl-addr-flex { flex: 1; width: auto; }
/* 扫码按钮：橙色金属实体键 */
.ctrl-scan-btn {
  flex-shrink: 0;
  height: 64rpx; padding: 0 28rpx;
  display: flex; align-items: center; justify-content: center;
  border-radius: var(--radius-sm);
  background: var(--grad-btn-primary);
  border: 2rpx var(--panel-border-style) var(--color-border-strong);
  color: #FFF;
  font-size: 26rpx; font-weight: 700; letter-spacing: 2rpx;
  box-shadow:
    inset 2rpx 2rpx 0 rgba(255, 255, 255, 0.35),
    inset -2rpx -2rpx 0 rgba(0, 0, 0, 0.2),
    0 4rpx 12rpx var(--glow-primary);
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.25);
  transition: transform .15s ease, filter .15s ease;
}
.ctrl-scan-btn:active { transform: scale(0.94); filter: brightness(0.94); }
.ctrl-init-row { display: flex; padding: 20rpx; }
/* 重新初始化：描边金属键 */
.ctrl-init-btn {
  flex: 1; height: 88rpx;
  display: flex; align-items: center; justify-content: center;
  border-radius: var(--radius-sm);
  background: var(--grad-btn-outline);
  border: 2rpx var(--panel-border-style) var(--color-border-strong);
  color: var(--color-text);
  font-size: 28rpx; font-weight: 600; letter-spacing: 2rpx;
  box-shadow: inset 2rpx 2rpx 0 var(--color-highlight), inset -2rpx -2rpx 0 rgba(0, 0, 0, 0.12);
  transition: transform .15s ease, filter .15s ease;
}
.ctrl-init-btn:active { transform: scale(0.97); filter: brightness(0.95); }
.ctrl-init-btn.loading { opacity: 0.75; }
.ctrl-init-spinner {
  width: 30rpx; height: 30rpx; margin-right: 14rpx;
  border: 4rpx solid var(--color-border);
  border-top-color: var(--color-primary);
  border-radius: 50%;
  animation: ctrl-spin 0.7s linear infinite;
}
@keyframes ctrl-spin { to { transform: rotate(360deg); } }

/* 蓝牙模式：仪表读数窗 + LED（广播/监听=绿光 / 待机=琥珀闪烁 / 未就绪=熄灭） */
.ctrl-mode {
  display: flex; align-items: center; justify-content: center; gap: 12rpx;
  flex: 1; min-width: 180rpx; height: 64rpx;
  background: var(--color-panel-3);
  border: 2rpx var(--panel-border-style) var(--color-border);
  box-shadow: inset 2rpx 2rpx 6rpx var(--color-input-inset);
  border-radius: var(--radius-sm);
  padding: 0 14rpx;
  box-sizing: border-box;
}
.ctrl-mode-dot {
  width: 16rpx; height: 16rpx; border-radius: 50%;
  background: var(--color-track);
  box-shadow: inset 0 0 4rpx rgba(0, 0, 0, 0.4);
}
.ctrl-mode-dot.on { background: var(--color-success); box-shadow: 0 0 10rpx var(--color-success); }
.ctrl-mode-dot.ready { background: var(--color-warning); box-shadow: 0 0 10rpx var(--color-warning); animation: ledBlink 1.2s ease-in-out infinite; }
@keyframes ledBlink { 0%, 100% { opacity: 1; } 50% { opacity: 0.45; } }
.ctrl-mode-text { font-size: 26rpx; color: var(--color-text); font-weight: 600; letter-spacing: 1rpx; }

/* 工作状态：读数窗 + 状态色文字 */
.ctrl-workstatus {
  flex: 1; min-width: 180rpx; height: 64rpx;
  display: flex; align-items: center; justify-content: center;
  background: var(--color-panel-3);
  border: 2rpx var(--panel-border-style) var(--color-border);
  box-shadow: inset 2rpx 2rpx 6rpx var(--color-input-inset);
  border-radius: var(--radius-sm);
  padding: 0 14rpx;
  font-size: 26rpx; font-weight: 600; letter-spacing: 1rpx;
  box-sizing: border-box;
}
.ctrl-workstatus.status-success { color: var(--color-success); }
.ctrl-workstatus.status-error { color: var(--color-danger); }
.ctrl-workstatus.status-processing,
.ctrl-workstatus.status-loading { color: var(--color-warning); }
.ctrl-workstatus.status-default { color: var(--color-text-secondary); }
.ctrl-divider {
  height: 1rpx;
  background: var(--color-border);
  margin: 0 20rpx;
}
.ctrl-picker {
  height: 64rpx;
  background: var(--color-panel-2);
  border: 2rpx var(--panel-border-style) var(--color-border);
  box-shadow: inset 2rpx 2rpx 6rpx var(--color-input-inset);
  border-radius: var(--radius-sm);
  padding: 0 14rpx;
  font-size: 26rpx;
  color: var(--color-text);
  display: flex;
  align-items: center;
  min-width: 160rpx;
  justify-content: center;
  box-sizing: border-box;
}

/* 旧版输入选择器（模板未引用，保持兼容） */
.ctrl-input {
  height: 72rpx;
  background: var(--color-panel-2);
  border: 2rpx var(--panel-border-style) var(--color-border);
  box-shadow: inset 2rpx 2rpx 6rpx var(--color-input-inset);
  border-radius: var(--radius-sm);
  padding: 0 14rpx;
  font-size: 28rpx;
  color: var(--color-text);
  text-align: center;
  width: 110rpx;
  box-sizing: border-box;
}
.ctrl-input-sm { width: 80rpx; }
.ctrl-input-xs { width: 72rpx; }
.ctrl-input-wide { width: 100%; text-align: left; }
.ctrl-unit {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  min-width: 30rpx;
  text-align: center;
}

/* ======================= HISTORY：终端读数 ========================== */

.hist-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
/* 标题：螺丝点 + 铭牌 + 英文角标 */
.hist-title {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text);
  letter-spacing: 3rpx;
}
.hist-title::before {
  content: '';
  width: 14rpx; height: 14rpx; border-radius: 50%;
  margin-right: 12rpx; flex-shrink: 0;
  background: radial-gradient(circle at 35% 30%, var(--deco-rivet) 0 3rpx, var(--deco-rivet-shadow) 3.6rpx 5rpx, var(--color-border-strong) 5.6rpx 8rpx);
  box-shadow: inset 0 0 2rpx rgba(0, 0, 0, 0.3), 0 1rpx 2rpx rgba(0, 0, 0, 0.2);
}
.hist-title::after {
  content: 'LOG';
  margin-left: 14rpx;
  font-family: 'DIN Alternate', 'Roboto Mono', 'SF Mono', Menlo, monospace;
  font-size: 18rpx; font-weight: 700; letter-spacing: 2rpx;
  color: var(--color-text-tertiary);
}
.hist-clear {
  font-size: 26rpx;
  color: var(--color-danger);
  padding: 8rpx;
  letter-spacing: 1rpx;
}
.hist-empty {
  text-align: center;
  padding: 80rpx 0;
  font-size: 26rpx;
  color: var(--color-text-tertiary);
  letter-spacing: 2rpx;
}
/* 日志条：金属面板 + 方向色条（发送=绿 / 接收=钢灰） */
.hist-item {
  background: var(--grad-panel);
  border: 2rpx var(--panel-border-style) var(--color-border);
  border-left: 6rpx solid var(--color-border);
  border-radius: var(--radius);
  padding: 20rpx 24rpx;
  margin-bottom: 10rpx;
  box-shadow:
    inset 2rpx 2rpx 0 var(--color-highlight),
    inset -2rpx -2rpx 0 rgba(0, 0, 0, 0.12),
    var(--shadow-card);
}
.hist-item.hist-send { border-left-color: var(--color-success); }
.hist-item.hist-recv { border-left-color: var(--color-accent-2); }
.hist-top {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 8rpx;
}
.hist-time {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  font-family: 'SF Mono', Menlo, 'Roboto Mono', monospace;
  font-variant-numeric: tabular-nums;
}
.hist-tag {
  font-size: 18rpx;
  font-weight: 600;
  padding: 3rpx 14rpx;
  border-radius: 6rpx;
  letter-spacing: 1rpx;
}
.hist-tag.send {
  background: var(--tint-success);
  color: var(--color-success);
}
.hist-tag.recv {
  background: var(--color-fill);
  color: var(--color-accent-2);
  border: 1rpx solid var(--color-border);
}
.hist-copy {
  margin-left: auto;
  font-size: 22rpx;
  color: var(--color-text-secondary);
  padding: 4rpx 14rpx;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-sm);
}
/* HEX 数据：终端内凹屏读数 */
.hist-hex {
  display: block; margin-top: 8rpx;
  font-size: 20rpx;
  color: var(--color-text-tertiary);
  font-family: 'SF Mono', Menlo, 'Roboto Mono', monospace;
  letter-spacing: 1rpx;
  word-break: break-all;
  line-height: 1.5;
  background: var(--color-panel-3);
  border: 1rpx solid var(--color-border-strong);
  border-radius: var(--radius-sm);
  box-shadow: inset 2rpx 2rpx 6rpx var(--color-input-inset);
  padding: 12rpx 14rpx;
}

/* ======================= TAB BAR：金属底座 ========================== */

.tabbar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 100;   /* 置于最上层：否则同层渲染的原生 input 会浮在 tabbar 之上，抢走「历史」等按钮的点击 */
  height: 100rpx;
  background: var(--color-card);
  border-top: 2rpx var(--panel-border-style) var(--color-border);
  box-shadow: inset 0 2rpx 0 var(--color-highlight);
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding-bottom: env(safe-area-inset-bottom, 0);
}
.tabbar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 10rpx 32rpx;
  border-radius: var(--radius-sm);
  transition: background .2s ease;
}
.tabbar-icon {
  font-size: 36rpx;
  color: var(--color-text-tertiary);
}
.tabbar-label {
  font-size: 18rpx;
  color: var(--color-text-tertiary);
  font-weight: 500;
  letter-spacing: 2rpx;
}
/* 选中项：橙色点亮 + 内凹按压位 */
.tabbar-active { background: var(--color-fill); box-shadow: inset 0 0 0 1rpx var(--color-border); }
.tabbar-active .tabbar-icon,
.tabbar-active .tabbar-label {
  color: var(--color-primary);
}

/* ======================= 动效 ========================== */
/* 错峰入场 */
.anim-in { opacity: 0; animation: bcFadeUp .5s cubic-bezier(.22, .9, .32, 1) forwards; }
@keyframes bcFadeUp {
  from { opacity: 0; transform: translateY(24rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* ======================= 暗档补丁②：提亮橙色光效 ==========================
   面板/文字/边框/LED 均由语义变量自动切换，这里只把橙色实体键的辉光
   换成暗档琥珀橙（与 ble/prepare.mpx 同一套补丁口径）。 */
.app.dark .db-read-btn {
  box-shadow:
    inset 2rpx 2rpx 0 rgba(255, 255, 255, 0.3),
    inset -2rpx -2rpx 0 rgba(0, 0, 0, 0.25),
    0 8rpx 20rpx var(--glow-primary);
}
.app.dark .pf-btn {
  box-shadow:
    inset 2rpx 2rpx 0 rgba(255, 255, 255, 0.3),
    inset -2rpx -2rpx 0 rgba(0, 0, 0, 0.25),
    0 4rpx 12rpx var(--glow-primary);
}
.app.dark .ctrl-scan-btn {
  box-shadow:
    inset 2rpx 2rpx 0 rgba(255, 255, 255, 0.3),
    inset -2rpx -2rpx 0 rgba(0, 0, 0, 0.25),
    0 4rpx 12rpx var(--glow-primary);
}
.app.dark .pf-input:focus,
.app.dark .ps-kpa:focus,
.app.dark .ctrl-addr:focus {
  box-shadow: inset 2rpx 2rpx 6rpx var(--color-input-inset), 0 0 0 3rpx var(--glow-primary-soft);
}
</style>

<script type="application/json">
{ "navigationBarTitleText": "智能阀门 · 远程控制" }
</script>
