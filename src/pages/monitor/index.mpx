<template>
  <view class="monitor-container {{darkMode ? 'dark' : ''}}">
    <!-- 顶部Hero区：设备信息卡片 -->
    <view class="hero-section anim-fade-in">
      <view class="hero-deco deco-1"></view>
      <view class="hero-deco deco-2"></view>

      <view class="hero-content">
        <!-- 设备标题行 -->
        <view class="device-header">
          <view class="device-info">
            <text class="device-name">{{ deviceName }}</text>
            <text class="device-sn">SN: {{ deviceSn }}</text>
          </view>
          <view class="theme-switch" bindtap="toggleTheme">
            <text class="theme-icon">{{darkMode ? '🌙' : '☀️'}}</text>
          </view>
        </view>

        <!-- 设备状态指示器 -->
        <view class="status-indicator">
          <view class="status-badge {{isOnline ? 'online' : 'offline'}}">
            <view class="status-dot"></view>
            <text class="status-text">{{ isOnline ? '在线' : '离线' }}</text>
          </view>
          <text class="last-update">{{ lastReportText }}</text>
        </view>
      </view>
    </view>

    <!-- 主内容区 -->
    <view class="content-wrapper">
      <!-- 实时数据面板 -->
      <view class="data-panel anim-slide-up d1" wx:if="{{ realtimeData }}">
        <view class="panel-header">
          <view class="header-left">
            <view class="header-accent"></view>
            <text class="header-title">实时数据</text>
          </view>
          <view class="refresh-badge" bindtap="handleRefresh">
            <text class="refresh-icon {{loading ? 'rotating' : ''}}">↻</text>
          </view>
        </view>

        <!-- 压力数据网格 -->
        <view class="data-section" wx:if="{{ hasPressure }}">
          <view class="section-label">压力监测</view>
          <view class="metrics-grid">
            <view class="metric-card pressure" wx:if="{{ realtimeData.data.intake_pressure != null }}">
              <text class="metric-label">阀前压力</text>
              <view class="metric-value-row">
                <text class="metric-value">{{ realtimeData.data.intake_pressure }}</text>
                <text class="metric-unit">MPa</text>
              </view>
              <view class="metric-indicator"></view>
            </view>

            <view class="metric-card pressure" wx:if="{{ realtimeData.data.return_pressure != null }}">
              <text class="metric-label">阀后压力</text>
              <view class="metric-value-row">
                <text class="metric-value">{{ realtimeData.data.return_pressure }}</text>
                <text class="metric-unit">MPa</text>
              </view>
              <view class="metric-indicator"></view>
            </view>

            <view class="metric-card pressure" wx:if="{{ realtimeData.data.secondary_intake_pressure != null }}">
              <text class="metric-label">二次进水</text>
              <view class="metric-value-row">
                <text class="metric-value">{{ realtimeData.data.secondary_intake_pressure }}</text>
                <text class="metric-unit">MPa</text>
              </view>
              <view class="metric-indicator"></view>
            </view>

            <view class="metric-card pressure" wx:if="{{ realtimeData.data.secondary_return_pressure != null }}">
              <text class="metric-label">二次回水</text>
              <view class="metric-value-row">
                <text class="metric-value">{{ realtimeData.data.secondary_return_pressure }}</text>
                <text class="metric-unit">MPa</text>
              </view>
              <view class="metric-indicator"></view>
            </view>
          </view>
        </view>

        <!-- 温度数据网格 -->
        <view class="data-section" wx:if="{{ hasTemperature }}">
          <view class="section-label">温度监测</view>
          <view class="metrics-grid">
            <view class="metric-card temperature" wx:if="{{ realtimeData.data.temp_intake != null }}">
              <text class="metric-label">进水温度</text>
              <view class="metric-value-row">
                <text class="metric-value">{{ formatValue(realtimeData.data.temp_intake) }}</text>
                <text class="metric-unit">°C</text>
              </view>
              <view class="metric-indicator"></view>
            </view>

            <view class="metric-card temperature" wx:if="{{ realtimeData.data.temp_return != null }}">
              <text class="metric-label">回水温度</text>
              <view class="metric-value-row">
                <text class="metric-value">{{ formatValue(realtimeData.data.temp_return) }}</text>
                <text class="metric-unit">°C</text>
              </view>
              <view class="metric-indicator"></view>
            </view>

            <view class="metric-card temperature" wx:if="{{ realtimeData.data.temp_set != null }}">
              <text class="metric-label">设定温度</text>
              <view class="metric-value-row">
                <text class="metric-value">{{ formatValue(realtimeData.data.temp_set) }}</text>
                <text class="metric-unit">°C</text>
              </view>
              <view class="metric-indicator"></view>
            </view>

            <view class="metric-card temperature" wx:if="{{ realtimeData.data.temp_indoor != null }}">
              <text class="metric-label">室内温度</text>
              <view class="metric-value-row">
                <text class="metric-value">{{ formatValue(realtimeData.data.temp_indoor) }}</text>
                <text class="metric-unit">°C</text>
              </view>
              <view class="metric-indicator"></view>
            </view>
          </view>
        </view>

        <!-- 阀门状态 -->
        <view class="data-section">
          <view class="section-label">阀门状态</view>
          <view class="metrics-grid">
            <!-- 只有流量调节阀等非先导阀才显示开度相关参数 -->
            <view class="metric-card valve" wx:if="{{ valveType !== 'pilot' && realtimeData.data.openness != null }}">
              <text class="metric-label">当前开度</text>
              <view class="metric-value-row">
                <text class="metric-value">{{ realtimeData.data.openness }}</text>
                <text class="metric-unit">%</text>
              </view>
              <view class="metric-indicator"></view>
            </view>

            <view class="metric-card valve" wx:if="{{ valveType !== 'pilot' && realtimeData.data.set_opening != null }}">
              <text class="metric-label">设定开度</text>
              <view class="metric-value-row">
                <text class="metric-value">{{ realtimeData.data.set_opening }}</text>
                <text class="metric-unit">%</text>
              </view>
              <view class="metric-indicator"></view>
            </view>

            <view class="metric-card flow" wx:if="{{ realtimeData.data.flow != null }}">
              <text class="metric-label">流量</text>
              <view class="metric-value-row">
                <text class="metric-value">{{ formatValue(realtimeData.data.flow) }}</text>
                <text class="metric-unit">m³/h</text>
              </view>
              <view class="metric-indicator"></view>
            </view>
          </view>
        </view>

        <!-- 设备信息 -->
        <view class="data-section">
          <view class="section-label">设备信息</view>
          <view class="info-grid">
            <view class="info-item">
              <text class="info-label">电池电量</text>
              <view class="info-value-row">
                <text class="info-value battery {{getBatteryClass(realtimeData.data.battery)}}">
                  {{ realtimeData.data.battery != null ? realtimeData.data.battery : '-' }}
                </text>
                <text class="info-unit" wx:if="{{ realtimeData.data.battery != null }}">%</text>
              </view>
            </view>

            <view class="info-item">
              <text class="info-label">信号强度</text>
              <view class="info-value-row">
                <text class="info-value signal {{getSignalClass(realtimeData.data.signal_strength)}}">
                  {{ realtimeData.data.signal_strength != null ? realtimeData.data.signal_strength : '-' }}
                </text>
                <text class="info-unit" wx:if="{{ realtimeData.data.signal_strength != null }}">dBm</text>
              </view>
            </view>

            <view class="info-item" wx:if="{{ realtimeData.data.work_mode }}">
              <text class="info-label">工作模式</text>
              <view class="info-value-row">
                <text class="info-value mode">{{ realtimeData.data.work_mode }}</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 空状态 -->
      <view class="empty-state anim-fade-in" wx:if="{{ !loading && !realtimeData }}">
        <view class="empty-icon">
          <view class="empty-wave wave-1"></view>
          <view class="empty-wave wave-2"></view>
          <view class="empty-dot"></view>
        </view>
        <text class="empty-title">暂无数据</text>
        <text class="empty-hint">点击下方刷新按钮获取实时数据</text>
      </view>

      <!-- 加载状态 -->
      <view class="loading-state anim-fade-in" wx:if="{{ loading && !realtimeData }}">
        <view class="loading-spinner"></view>
        <text class="loading-text">加载中...</text>
      </view>

      <!-- 自动刷新控制面板 -->
      <view class="control-panel anim-slide-up d2">
        <view class="panel-header">
          <view class="header-left">
            <view class="header-accent"></view>
            <text class="header-title">自动刷新</text>
          </view>
          <switch
            class="auto-switch"
            checked="{{ autoRefreshEnabled }}"
            bindchange="handleAutoRefreshToggle"
            color="#34C759"
          />
        </view>

        <view class="refresh-settings" wx:if="{{ autoRefreshEnabled }}">
          <text class="settings-label">刷新间隔</text>
          <picker
            mode="selector"
            range="{{ intervalOptions }}"
            range-key="label"
            value="{{ selectedIntervalIndex }}"
            bindchange="handleIntervalChange"
            class="interval-picker"
          >
            <view class="picker-display">
              <text class="picker-value">{{ intervalOptions[selectedIntervalIndex].label }}</text>
              <text class="picker-arrow">›</text>
            </view>
          </picker>
        </view>
      </view>
    </view>

    <!-- 底部操作栏 -->
    <view class="action-bar">
      <button class="action-btn btn-refresh" bindtap="handleRefresh" disabled="{{ loading }}">
        <text class="btn-icon {{loading ? 'rotating' : ''}}">↻</text>
        <text class="btn-text">{{ loading ? '刷新中' : '刷新数据' }}</text>
      </button>
      <button class="action-btn btn-control" bindtap="handleControl">
        <text class="btn-icon">⚙</text>
        <text class="btn-text">远程控制</text>
      </button>
    </view>
  </view>
</template>

<script>
import { createPage } from '@mpxjs/core'
import { getDeviceRealtime, getDeviceBySn } from '../../services/api/tenant'
import { useDeviceStore } from '../../stores/device'

createPage({
  data: {
    deviceSn: '',
    deviceId: null,
    deviceName: '',
    valveType: '', // 阀门类型：pilot=先导阀，flow=流量阀等
    realtimeData: null,
    loading: false,
    isOnline: false,
    lastReportText: '-',
    darkMode: false,
    autoRefreshEnabled: false,
    selectedIntervalIndex: 1,
    intervalOptions: [
      { label: '5秒', value: 5000 },
      { label: '10秒', value: 10000 },
      { label: '30秒', value: 30000 },
      { label: '60秒', value: 60000 }
    ],
    refreshTimer: null
  },

  computed: {
    // 判断是否有压力数据：用于决定是否显示压力监测区域
    hasPressure() {
      if (!this.realtimeData || !this.realtimeData.data) return false
      const d = this.realtimeData.data
      return d.intake_pressure != null || d.return_pressure != null ||
             d.secondary_intake_pressure != null || d.secondary_return_pressure != null ||
             d.pressure != null
    },

    // 判断是否有温度数据：用于决定是否显示温度监测区域
    hasTemperature() {
      if (!this.realtimeData || !this.realtimeData.data) return false
      const d = this.realtimeData.data
      return d.temp_intake != null || d.temp_return != null ||
             d.temp_set != null || d.temp_indoor != null
    }
  },

  onLoad(options) {
    const { sn, id, name } = options

    // SN是必须参数，没有SN无法查询设备
    if (!sn) {
      wx.showToast({ title: '缺少设备SN参数', icon: 'none' })
      setTimeout(() => wx.navigateBack(), 1500)
      return
    }

    this.deviceSn = sn
    this.deviceId = id ? parseInt(id) : null
    this.deviceName = name || sn

    // 从store获取当前设备信息（包含阀门类型等）
    const store = useDeviceStore()
    const currentDevice = store.currentDevice

    // 将4G/WiFi模式的设备记入连接记录，方便下次快速进入
    if (sn && currentDevice) {
      store.addDevice({
        deviceId: sn,
        localName: currentDevice.localName || name || sn,
        valveType: currentDevice.valveType || '',
        valveTypeId: currentDevice.valveTypeId || 'old',
        mode: 'bluetooth', // 标记为4G/WiFi模式（历史原因mode字段叫bluetooth）
      })
    }

    // 如果没有设备ID，先查询获取完整设备信息
    if (!this.deviceId) {
      this.fetchDeviceInfo()
    } else {
      this.loadRealtimeData()
    }
  },

  onShow() {
    // 恢复深色模式状态
    const store = useDeviceStore()
    this.setData({ darkMode: store.darkMode })

    // 页面显示时，如果开启了自动刷新则启动定时器
    if (this.autoRefreshEnabled && !this.refreshTimer) {
      this.startAutoRefresh()
    }
  },

  onHide() {
    // 页面隐藏时停止自动刷新，节省资源和流量
    this.stopAutoRefresh()
  },

  onUnload() {
    // 页面卸载时清理定时器，避免内存泄漏
    this.stopAutoRefresh()
  },

  methods: {
    // 获取设备基本信息：通过SN查询设备ID和名称
    async fetchDeviceInfo() {
      try {
        const device = await getDeviceBySn(this.deviceSn)
        this.deviceId = device.id
        this.deviceName = device.name || device.sn
        this.valveType = device.valve_type || ''
        this.loadRealtimeData()
      } catch (e) {
        wx.showToast({ title: e.message || '获取设备信息失败', icon: 'none' })
      }
    },

    // 加载实时数据：调用API获取设备最新上报数据
    async loadRealtimeData() {
      this.loading = true
      try {
        const data = await getDeviceRealtime(this.deviceSn)
        this.realtimeData = data
        this.isOnline = data.online_status === 1
        this.updateLastReportText(data.data.reported_at)
      } catch (e) {
        console.error('加载实时数据失败:', e)
        wx.showToast({ title: e.message || '获取数据失败', icon: 'none' })
      } finally {
        this.loading = false
      }
    },

    // 手动刷新：用户点击刷新按钮触发
    handleRefresh() {
      if (this.loading) return
      this.loadRealtimeData()
    },

    // 跳转到远程控制页面
    handleControl() {
      if (!this.deviceId) {
        wx.showToast({ title: '设备信息加载中', icon: 'none' })
        return
      }
      wx.navigateTo({
        url: `/pages/control/index?sn=${this.deviceSn}&deviceId=${this.deviceId}&name=${encodeURIComponent(this.deviceName)}`
      })
    },

    // 自动刷新开关切换
    handleAutoRefreshToggle(e) {
      this.autoRefreshEnabled = e.detail.value
      if (this.autoRefreshEnabled) {
        this.startAutoRefresh()
      } else {
        this.stopAutoRefresh()
      }
    },

    // 刷新间隔切换
    handleIntervalChange(e) {
      this.selectedIntervalIndex = parseInt(e.detail.value)
      // 如果自动刷新已开启，需要重新启动定时器以应用新间隔
      if (this.autoRefreshEnabled) {
        this.stopAutoRefresh()
        this.startAutoRefresh()
      }
    },

    // 启动自动刷新定时器
    startAutoRefresh() {
      const interval = this.intervalOptions[this.selectedIntervalIndex].value
      this.refreshTimer = setInterval(() => {
        this.loadRealtimeData()
      }, interval)
    },

    // 停止自动刷新定时器
    stopAutoRefresh() {
      if (this.refreshTimer) {
        clearInterval(this.refreshTimer)
        this.refreshTimer = null
      }
    },

    // 更新最后上报时间文本：将时间戳转换为易读的相对时间
    updateLastReportText(timestamp) {
      if (!timestamp) {
        this.lastReportText = '暂无上报'
        return
      }
      const now = Math.floor(Date.now() / 1000)
      const diff = now - timestamp

      if (diff < 60) {
        this.lastReportText = '刚刚上报'
      } else if (diff < 3600) {
        this.lastReportText = `${Math.floor(diff / 60)}分钟前`
      } else if (diff < 86400) {
        this.lastReportText = `${Math.floor(diff / 3600)}小时前`
      } else {
        this.lastReportText = `${Math.floor(diff / 86400)}天前`
      }
    },

    // 格式化数值：保留1位小数
    formatValue(value) {
      if (value == null) return '-'
      return Number(value).toFixed(1)
    },

    // 获取电池电量样式类：根据电量百分比返回不同颜色类名
    getBatteryClass(battery) {
      if (battery == null) return ''
      if (battery >= 80) return 'battery-high'
      if (battery >= 30) return 'battery-medium'
      return 'battery-low'
    },

    // 获取信号强度样式类：根据信号强度返回不同颜色类名
    getSignalClass(signal) {
      if (signal == null) return ''
      if (signal >= -60) return 'signal-strong'
      if (signal >= -80) return 'signal-medium'
      return 'signal-weak'
    },

    // 切换深色模式
    toggleTheme() {
      const store = useDeviceStore()
      store.toggleDarkMode()
      this.setData({ darkMode: store.darkMode })
    }
  }
})
</script>

<style scoped>
/* ==================== 颜色系统与主题变量 ==================== */
.monitor-container {
  --bg-primary: #F2F2F7;
  --bg-secondary: #FFFFFF;
  --bg-hero: linear-gradient(150deg, #4C9AFF 0%, #007AFF 55%, #0055D4 100%);

  --text-primary: #1C1C1E;
  --text-secondary: #8E8E93;
  --text-tertiary: #C7C7CC;

  --accent-primary: #007AFF;
  --accent-success: #34C759;
  --accent-warning: #FF9500;
  --accent-danger: #FF3B30;

  --color-pressure: #0A84FF;
  --color-temperature: #FF6B6B;
  --color-valve: #34C759;
  --color-flow: #5AC8FA;

  --shadow-card: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  --shadow-float: 0 8rpx 30rpx rgba(0, 0, 0, 0.12);

  --radius-sm: 12rpx;
  --radius-md: 20rpx;
  --radius-lg: 28rpx;

  min-height: 100vh;
  background: var(--bg-primary);
  padding-bottom: 140rpx;
}

/* 深色模式主题 */
.monitor-container.dark {
  --bg-primary: #000000;
  --bg-secondary: #1C1C1E;
  --bg-hero: linear-gradient(150deg, #0A5CFF 0%, #0A84FF 60%, #0040B0 100%);

  --text-primary: #F2F2F7;
  --text-secondary: #98989F;
  --text-tertiary: #636366;

  --accent-primary: #0A84FF;
  --accent-success: #30D158;
  --accent-warning: #FF9F0A;
  --accent-danger: #FF453A;

  --color-pressure: #0A84FF;
  --color-temperature: #FF6B6B;
  --color-valve: #30D158;
  --color-flow: #5AC8FA;

  --shadow-card: 0 4rpx 20rpx rgba(0, 0, 0, 0.4);
  --shadow-float: 0 8rpx 30rpx rgba(0, 0, 0, 0.6);
}

/* ==================== 动画定义 ==================== */
@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(40rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes rotate {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

@keyframes pulse {
  0%, 100% {
    box-shadow: 0 0 0 0 rgba(52, 199, 89, 0.7);
  }
  50% {
    box-shadow: 0 0 0 12rpx rgba(52, 199, 89, 0);
  }
}

.anim-fade-in {
  animation: fadeIn 0.5s ease-out;
}

.anim-slide-up {
  animation: slideUp 0.6s cubic-bezier(0.22, 0.9, 0.32, 1);
}

.anim-slide-up.d1 {
  animation-delay: 0.1s;
  opacity: 0;
  animation-fill-mode: forwards;
}

.anim-slide-up.d2 {
  animation-delay: 0.2s;
  opacity: 0;
  animation-fill-mode: forwards;
}

.rotating {
  animation: rotate 1s linear infinite;
}

/* ==================== Hero区域 ==================== */
.hero-section {
  position: relative;
  overflow: hidden;
  background: var(--bg-hero);
  padding: 48rpx 32rpx 56rpx;
  margin: 0 0 32rpx 0;
  border-radius: 0 0 48rpx 48rpx;
}

/* Hero装饰圆圈 */
.hero-deco {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}

.deco-1 {
  width: 320rpx;
  height: 320rpx;
  top: -140rpx;
  right: -80rpx;
  background: rgba(255, 255, 255, 0.08);
}

.deco-2 {
  width: 180rpx;
  height: 180rpx;
  bottom: -60rpx;
  left: -40rpx;
  background: rgba(255, 255, 255, 0.05);
}

.hero-content {
  position: relative;
  z-index: 1;
}

/* 设备头部 */
.device-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.device-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.device-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: 1rpx;
  word-break: break-all;
}

.device-sn {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.72);
  font-family: 'SF Mono', Menlo, monospace;
  letter-spacing: 0.5rpx;
}

/* 主题切换按钮 */
.theme-switch {
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.18);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.2s ease;
}

.theme-switch:active {
  transform: scale(0.9) rotate(-15deg);
}

.theme-icon {
  font-size: 32rpx;
}

/* 状态指示器 */
.status-indicator {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.status-badge {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  backdrop-filter: blur(10rpx);
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #FFFFFF;
}

.status-badge.online .status-dot {
  background: #30D158;
  animation: pulse 2s ease-in-out infinite;
}

.status-badge.offline .status-dot {
  background: #8E8E93;
}

.status-text {
  font-size: 24rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.last-update {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.64);
}

/* ==================== 内容包装器 ==================== */
.content-wrapper {
  padding: 0 24rpx;
}

/* ==================== 数据面板 ==================== */
.data-panel {
  background: var(--bg-secondary);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-card);
}

.monitor-container.dark .data-panel {
  border: 1rpx solid rgba(255, 255, 255, 0.06);
}

/* 面板头部 */
.panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.header-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.header-accent {
  width: 6rpx;
  height: 28rpx;
  border-radius: 4rpx;
  background: linear-gradient(180deg, var(--accent-primary), var(--color-pressure));
}

.header-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
  letter-spacing: 0.5rpx;
}

.refresh-badge {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--bg-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.2s ease;
}

.refresh-badge:active {
  transform: scale(0.9);
}

.refresh-icon {
  font-size: 32rpx;
  color: var(--accent-primary);
}

/* 数据区域 */
.data-section {
  margin-bottom: 32rpx;
}

.data-section:last-child {
  margin-bottom: 0;
}

.section-label {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--text-secondary);
  text-transform: uppercase;
  letter-spacing: 2rpx;
  margin-bottom: 16rpx;
  padding-left: 4rpx;
}

/* 指标网格 */
.metrics-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

/* 指标卡片 */
.metric-card {
  position: relative;
  background: var(--bg-primary);
  border-radius: var(--radius-md);
  padding: 24rpx 20rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  overflow: hidden;
  transition: transform 0.2s ease;
}

.metric-card:active {
  transform: scale(0.98);
}

.monitor-container.dark .metric-card {
  background: #2C2C2E;
  border: 1rpx solid rgba(255, 255, 255, 0.04);
}

/* 指标指示条 */
.metric-indicator {
  position: absolute;
  left: 0;
  top: 0;
  width: 6rpx;
  height: 100%;
  border-radius: 0 4rpx 4rpx 0;
}

.metric-card.pressure .metric-indicator {
  background: var(--color-pressure);
}

.metric-card.temperature .metric-indicator {
  background: var(--color-temperature);
}

.metric-card.valve .metric-indicator {
  background: var(--color-valve);
}

.metric-card.flow .metric-indicator {
  background: var(--color-flow);
}

.metric-label {
  font-size: 24rpx;
  color: var(--text-secondary);
  font-weight: 500;
}

.metric-value-row {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.metric-value {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--text-primary);
  font-family: 'SF Mono', Menlo, monospace;
  line-height: 1;
}

.metric-unit {
  font-size: 24rpx;
  color: var(--text-secondary);
  font-weight: 500;
}

/* 信息网格（设备信息用） */
.info-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1rpx;
  background: var(--bg-primary);
  border-radius: var(--radius-md);
  overflow: hidden;
}

.monitor-container.dark .info-grid {
  background: rgba(255, 255, 255, 0.04);
}

.info-item {
  background: var(--bg-primary);
  padding: 24rpx 20rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.monitor-container.dark .info-item {
  background: #2C2C2E;
}

.info-label {
  font-size: 24rpx;
  color: var(--text-secondary);
  font-weight: 500;
}

.info-value-row {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.info-value {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
  font-family: 'SF Mono', Menlo, monospace;
}

.info-unit {
  font-size: 22rpx;
  color: var(--text-secondary);
}

/* 电池电量颜色 */
.battery-high {
  color: var(--accent-success) !important;
}

.battery-medium {
  color: var(--accent-warning) !important;
}

.battery-low {
  color: var(--accent-danger) !important;
}

/* 信号强度颜色 */
.signal-strong {
  color: var(--accent-success) !important;
}

.signal-medium {
  color: var(--accent-warning) !important;
}

.signal-weak {
  color: var(--accent-danger) !important;
}

/* ==================== 控制面板 ==================== */
.control-panel {
  background: var(--bg-secondary);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  box-shadow: var(--shadow-card);
}

.monitor-container.dark .control-panel {
  border: 1rpx solid rgba(255, 255, 255, 0.06);
}

.auto-switch {
  transform: scale(0.9);
}

.refresh-settings {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--bg-primary);
}

.monitor-container.dark .refresh-settings {
  border-top-color: rgba(255, 255, 255, 0.06);
}

.settings-label {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.interval-picker {
  flex-shrink: 0;
}

.picker-display {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 24rpx;
  background: var(--bg-primary);
  border-radius: var(--radius-sm);
  min-width: 140rpx;
  justify-content: space-between;
}

.monitor-container.dark .picker-display {
  background: #2C2C2E;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.picker-value {
  font-size: 26rpx;
  color: var(--accent-primary);
  font-weight: 600;
}

.picker-arrow {
  font-size: 28rpx;
  color: var(--text-tertiary);
}

/* ==================== 空状态 ==================== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 32rpx;
}

.empty-dot {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 24rpx;
  height: 24rpx;
  margin: -12rpx 0 0 -12rpx;
  border-radius: 50%;
  background: var(--text-tertiary);
}

.empty-wave {
  position: absolute;
  left: 50%;
  top: 50%;
  border-radius: 50%;
  border: 3rpx solid var(--text-tertiary);
  opacity: 0.3;
}

.wave-1 {
  width: 60rpx;
  height: 60rpx;
  margin: -30rpx 0 0 -30rpx;
}

.wave-2 {
  width: 100rpx;
  height: 100rpx;
  margin: -50rpx 0 0 -50rpx;
  opacity: 0.2;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: var(--text-tertiary);
  text-align: center;
  line-height: 1.5;
}

/* ==================== 加载状态 ==================== */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid var(--bg-primary);
  border-top-color: var(--accent-primary);
  border-radius: 50%;
  animation: rotate 0.8s linear infinite;
  margin-bottom: 24rpx;
}

.loading-text {
  font-size: 28rpx;
  color: var(--text-secondary);
}

/* ==================== 底部操作栏 ==================== */
.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 100;
  display: flex;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(242, 242, 247, 0.95);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border-top: 1rpx solid rgba(0, 0, 0, 0.08);
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.monitor-container.dark .action-bar {
  background: rgba(28, 28, 30, 0.95);
  border-top-color: rgba(255, 255, 255, 0.08);
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.3);
}

.action-btn {
  flex: 1;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  transition: all 0.2s ease;
}

.action-btn::after {
  border: none;
}

.action-btn:active {
  transform: scale(0.97);
  opacity: 0.85;
}

.btn-refresh {
  background: var(--bg-secondary);
  color: var(--accent-primary);
  border: 2rpx solid var(--accent-primary);
}

.btn-refresh:disabled {
  opacity: 0.5;
}

.monitor-container.dark .btn-refresh {
  background: #2C2C2E;
  border-color: var(--accent-primary);
}

.btn-control {
  background: linear-gradient(135deg, #3D8BFF 0%, #007AFF 60%, #0060E0 100%);
  color: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(0, 122, 255, 0.3);
}

.monitor-container.dark .btn-control {
  background: linear-gradient(135deg, #1A7AFF 0%, #0A84FF 60%, #0055D4 100%);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.4);
}

.btn-icon {
  font-size: 36rpx;
}

.btn-text {
  letter-spacing: 1rpx;
}
</style>

