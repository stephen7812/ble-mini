<template>
  <view class="monitor-container {{themeClass}}">
    <!-- 顶部Hero区：设备信息卡片 -->
    <view class="hero-section riveted anim-fade-in">
      <view class="hero-deco deco-1"></view>
      <view class="hero-deco deco-2"></view>

      <view class="hero-content">
        <!-- 设备标题行 -->
        <view class="device-header">
          <view class="device-info">
            <text class="device-name">{{ deviceName }}</text>
            <text class="device-sn mono">SN: {{ deviceSn }}</text>
          </view>
          <view class="theme-switch" bindtap="toggleTheme">
            <text class="theme-icon">{{themeIcon}}</text>
          </view>
        </view>

        <!-- 设备状态指示器 -->
        <view class="status-indicator">
          <view class="status-badge {{isOnline ? 'online' : 'offline'}}">
            <view class="led {{isOnline ? 'on' : ''}}"></view>
            <text class="status-text">{{ isOnline ? '在线' : '离线' }}</text>
          </view>
          <text class="last-update">{{ lastReportText }}</text>
        </view>
      </view>
    </view>

    <!-- 主内容区 -->
    <view class="content-wrapper">
      <!-- 实时数据面板 -->
      <view class="data-panel card riveted anim-slide-up d1" wx:if="{{ realtimeData }}">
        <view class="panel-header">
          <view class="header-left">
            <view class="header-accent"></view>
            <text class="header-title">实时数据</text>
          </view>
          <view class="refresh-badge" bindtap="handleRefresh">
            <text class="refresh-icon {{loading ? 'rotating' : ''}}">↻</text>
          </view>
        </view>

        <!-- 压力数据网格：先导减压阀专属（流量调节阀只关注开度，不显示阀前/阀后压力） -->
        <view class="data-section" wx:if="{{ isPilot && hasPressure }}">
          <view class="section-label">压力监测</view>
          <view class="metrics-grid">
            <view class="metric-card pressure" wx:if="{{ realtimeData.data.intake_pressure != null }}">
              <text class="metric-label">阀前压力</text>
              <view class="metric-value-row">
                <text class="metric-value mono">{{ realtimeData.data.intake_pressure }}</text>
                <text class="metric-unit">MPa</text>
              </view>
              <view class="metric-indicator"></view>
            </view>

            <view class="metric-card pressure" wx:if="{{ realtimeData.data.return_pressure != null }}">
              <text class="metric-label">阀后压力</text>
              <view class="metric-value-row">
                <text class="metric-value mono">{{ realtimeData.data.return_pressure }}</text>
                <text class="metric-unit">MPa</text>
              </view>
              <view class="metric-indicator"></view>
            </view>

            <view class="metric-card pressure" wx:if="{{ realtimeData.data.secondary_intake_pressure != null }}">
              <text class="metric-label">二次进水</text>
              <view class="metric-value-row">
                <text class="metric-value mono">{{ realtimeData.data.secondary_intake_pressure }}</text>
                <text class="metric-unit">MPa</text>
              </view>
              <view class="metric-indicator"></view>
            </view>

            <view class="metric-card pressure" wx:if="{{ realtimeData.data.secondary_return_pressure != null }}">
              <text class="metric-label">二次回水</text>
              <view class="metric-value-row">
                <text class="metric-value mono">{{ realtimeData.data.secondary_return_pressure }}</text>
                <text class="metric-unit">MPa</text>
              </view>
              <view class="metric-indicator"></view>
            </view>
          </view>
        </view>

        <!-- 温度数据网格：流量调节阀只显示自身具备的传感器（回水/设定/室温），
             进水温度为先导阀专属，避免把 temperature 兜底值错标成进水温度 -->
        <view class="data-section" wx:if="{{ hasTemperature }}">
          <view class="section-label">温度监测</view>
          <view class="metrics-grid">
            <view class="metric-card temperature" wx:if="{{ isPilot && realtimeData.data.temp_intake != null }}">
              <text class="metric-label">进水温度</text>
              <view class="metric-value-row">
                <text class="metric-value mono">{{ formatValue(realtimeData.data.temp_intake) }}</text>
                <text class="metric-unit">°C</text>
              </view>
              <view class="metric-indicator"></view>
            </view>

            <view class="metric-card temperature" wx:if="{{ realtimeData.data.temp_return != null }}">
              <text class="metric-label">回水温度</text>
              <view class="metric-value-row">
                <text class="metric-value mono">{{ formatValue(realtimeData.data.temp_return) }}</text>
                <text class="metric-unit">°C</text>
              </view>
              <view class="metric-indicator"></view>
            </view>

            <view class="metric-card temperature" wx:if="{{ realtimeData.data.temp_set != null }}">
              <text class="metric-label">设定温度</text>
              <view class="metric-value-row">
                <text class="metric-value mono">{{ formatValue(realtimeData.data.temp_set) }}</text>
                <text class="metric-unit">°C</text>
              </view>
              <view class="metric-indicator"></view>
            </view>

            <view class="metric-card temperature" wx:if="{{ realtimeData.data.temp_indoor != null }}">
              <text class="metric-label">室内温度</text>
              <view class="metric-value-row">
                <text class="metric-value mono">{{ formatValue(realtimeData.data.temp_indoor) }}</text>
                <text class="metric-unit">°C</text>
              </view>
              <view class="metric-indicator"></view>
            </view>
          </view>
        </view>

        <!-- 阀门状态 -->
        <view class="data-section">
          <view class="section-label">阀门状态</view>
          <view class="metrics-grid">
            <!-- 只有流量调节阀等非先导阀才显示开度相关参数 -->
            <view class="metric-card valve" wx:if="{{ !isPilot && realtimeData.data.openness != null }}">
              <text class="metric-label">当前开度</text>
              <view class="metric-value-row">
                <text class="metric-value mono">{{ realtimeData.data.openness }}</text>
                <text class="metric-unit">%</text>
              </view>
              <view class="metric-indicator"></view>
            </view>

            <view class="metric-card valve" wx:if="{{ !isPilot && realtimeData.data.set_opening != null }}">
              <text class="metric-label">设定开度</text>
              <view class="metric-value-row">
                <text class="metric-value mono">{{ realtimeData.data.set_opening }}</text>
                <text class="metric-unit">%</text>
              </view>
              <view class="metric-indicator"></view>
            </view>

            <view class="metric-card flow" wx:if="{{ realtimeData.data.flow != null }}">
              <text class="metric-label">流量</text>
              <view class="metric-value-row">
                <text class="metric-value mono">{{ formatValue(realtimeData.data.flow) }}</text>
                <text class="metric-unit">m³/h</text>
              </view>
              <view class="metric-indicator"></view>
            </view>
          </view>
        </view>

        <!-- 设备信息 -->
        <view class="data-section">
          <view class="section-label">设备信息</view>
          <view class="info-grid">
            <view class="info-item">
              <text class="info-label">电池电量</text>
              <view class="info-value-row">
                <text class="info-value mono battery {{getBatteryClass(realtimeData.data.battery)}}">
                  {{ realtimeData.data.battery != null ? realtimeData.data.battery : '-' }}
                </text>
                <text class="info-unit" wx:if="{{ realtimeData.data.battery != null }}">%</text>
                <view class="led-meter {{getBatteryClass(realtimeData.data.battery)}}">
                  <view class="seg"></view>
                  <view class="seg"></view>
                  <view class="seg"></view>
                  <view class="seg"></view>
                  <view class="seg"></view>
                </view>
              </view>
            </view>

            <view class="info-item">
              <text class="info-label">信号强度</text>
              <view class="info-value-row">
                <text class="info-value mono signal {{getSignalClass(realtimeData.data.signal_strength)}}">
                  {{ realtimeData.data.signal_strength != null ? realtimeData.data.signal_strength : '-' }}
                </text>
                <text class="info-unit" wx:if="{{ realtimeData.data.signal_strength != null }}">dBm</text>
                <view class="led-meter {{getSignalClass(realtimeData.data.signal_strength)}}">
                  <view class="seg"></view>
                  <view class="seg"></view>
                  <view class="seg"></view>
                  <view class="seg"></view>
                  <view class="seg"></view>
                </view>
              </view>
            </view>

            <view class="info-item" wx:if="{{ realtimeData.data.work_mode }}">
              <text class="info-label">工作模式</text>
              <view class="info-value-row">
                <text class="info-value mode">{{ realtimeData.data.work_mode }}</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 空状态 -->
      <view class="empty-state anim-fade-in" wx:if="{{ !loading && !realtimeData }}">
        <view class="empty-icon">
          <view class="empty-wave wave-1"></view>
          <view class="empty-wave wave-2"></view>
          <view class="empty-dot"></view>
        </view>
        <text class="empty-title">暂无数据</text>
        <text class="empty-hint">点击下方刷新按钮获取实时数据</text>
      </view>

      <!-- 加载状态 -->
      <view class="loading-state anim-fade-in" wx:if="{{ loading && !realtimeData }}">
        <view class="loading-spinner"></view>
        <text class="loading-text">加载中...</text>
      </view>

      <!-- 自动刷新控制面板 -->
      <view class="control-panel card riveted anim-slide-up d2">
        <view class="panel-header">
          <view class="header-left">
            <view class="header-accent"></view>
            <text class="header-title">自动刷新</text>
          </view>
          <switch
            class="auto-switch"
            checked="{{ autoRefreshEnabled }}"
            bindchange="handleAutoRefreshToggle"
            color="#1F9D55"
          />
        </view>

        <view class="refresh-settings" wx:if="{{ autoRefreshEnabled }}">
          <text class="settings-label">刷新间隔</text>
          <picker
            mode="selector"
            range="{{ intervalOptions }}"
            range-key="label"
            value="{{ selectedIntervalIndex }}"
            bindchange="handleIntervalChange"
            class="interval-picker"
          >
            <view class="picker-display">
              <text class="picker-value">{{ intervalOptions[selectedIntervalIndex].label }}</text>
              <text class="picker-arrow">›</text>
            </view>
          </picker>
        </view>
      </view>
    </view>

    <!-- 底部操作栏 -->
    <view class="action-bar">
      <button class="action-btn btn-refresh" bindtap="handleRefresh" disabled="{{ loading }}">
        <text class="btn-icon {{loading ? 'rotating' : ''}}">↻</text>
        <text class="btn-text">{{ loading ? '刷新中' : '刷新数据' }}</text>
      </button>
      <button class="action-btn btn-control" bindtap="handleControl">
        <text class="btn-icon">⚙</text>
        <text class="btn-text">远程控制</text>
      </button>
    </view>
  </view>
</template>

<script>
import { createPage } from '@mpxjs/core'
import { getDeviceRealtime, getDeviceBySn } from '../../services/api/tenant'
import { useDeviceStore } from '../../stores/device'

createPage({
  data: {
    deviceSn: '',
    deviceId: null,
    deviceName: '',
    valveType: '', // 阀门类型：pilot=先导阀，flow=流量阀等
    realtimeData: null,
    loading: false,
    isOnline: false,
    lastReportText: '-',
    themeClass: '',
    themeIcon: '☀️',
    autoRefreshEnabled: false,
    selectedIntervalIndex: 1,
    intervalOptions: [
      { label: '5秒', value: 5000 },
      { label: '10秒', value: 10000 },
      { label: '30秒', value: 30000 },
      { label: '60秒', value: 60000 }
    ],
    refreshTimer: null
  },

  computed: {
    // 是否先导减压阀：决定压力区与进水温度是否渲染。
    // 优先用设备档案的 valve_type；从设备详情带 id 直进时 valve_type 还没查回来，
    // 回落到实时数据自带的 product_category（后端已归一为 pilot_reducing / flow_control）。
    isPilot() {
      const cat = this.valveType ||
        (this.realtimeData && this.realtimeData.data && this.realtimeData.data.product_category) ||
        ''
      return cat.indexOf('pilot') >= 0
    },

    // 判断是否有压力数据：用于决定是否显示压力监测区域（仅先导阀）
    hasPressure() {
      if (!this.isPilot) return false
      if (!this.realtimeData || !this.realtimeData.data) return false
      const d = this.realtimeData.data
      return d.intake_pressure != null || d.return_pressure != null ||
             d.secondary_intake_pressure != null || d.secondary_return_pressure != null ||
             d.pressure != null
    },

    // 判断是否有温度数据：用于决定是否显示温度监测区域
    // 流量调节阀只有回水/设定/室温传感器，进水温度不参与判断
    hasTemperature() {
      if (!this.realtimeData || !this.realtimeData.data) return false
      const d = this.realtimeData.data
      return (this.isPilot && d.temp_intake != null) || d.temp_return != null ||
             d.temp_set != null || d.temp_indoor != null
    }
  },

  onLoad(options) {
    const { sn, id, name } = options

    // SN是必须参数，没有SN无法查询设备
    if (!sn) {
      wx.showToast({ title: '缺少设备SN参数', icon: 'none' })
      setTimeout(() => wx.navigateBack(), 1500)
      return
    }

    this.deviceSn = sn
    this.deviceId = id ? parseInt(id) : null
    this.deviceName = name || sn

    // 从store获取当前设备信息（包含阀门类型等）
    const store = useDeviceStore()
    const currentDevice = store.currentDevice

    // 将4G/WiFi模式的设备记入连接记录，方便下次快速进入
    if (sn && currentDevice) {
      store.addDevice({
        deviceId: sn,
        localName: currentDevice.localName || name || sn,
        valveType: currentDevice.valveType || '',
        valveTypeId: currentDevice.valveTypeId || 'old',
        mode: 'bluetooth', // 标记为4G/WiFi模式（历史原因mode字段叫bluetooth）
      })
    }

    // 如果没有设备ID，先查询获取完整设备信息
    if (!this.deviceId) {
      this.fetchDeviceInfo()
    } else {
      this.loadRealtimeData()
    }
  },

  onShow() {
    // 恢复主题状态
    const store = useDeviceStore()
    this.setData({ themeClass: store.themeClass, themeIcon: store.themeIcon })

    // 页面显示时，如果开启了自动刷新则启动定时器
    if (this.autoRefreshEnabled && !this.refreshTimer) {
      this.startAutoRefresh()
    }
  },

  onHide() {
    // 页面隐藏时停止自动刷新，节省资源和流量
    this.stopAutoRefresh()
  },

  onUnload() {
    // 页面卸载时清理定时器，避免内存泄漏
    this.stopAutoRefresh()
  },

  methods: {
    // 获取设备基本信息：通过SN查询设备ID和名称
    async fetchDeviceInfo() {
      try {
        const device = await getDeviceBySn(this.deviceSn)
        this.deviceId = device.id
        this.deviceName = device.name || device.sn
        this.valveType = device.valve_type || ''
        this.loadRealtimeData()
      } catch (e) {
        wx.showToast({ title: e.message || '获取设备信息失败', icon: 'none' })
      }
    },

    // 加载实时数据：调用API获取设备最新上报数据
    async loadRealtimeData() {
      this.loading = true
      try {
        const data = await getDeviceRealtime(this.deviceSn)
        this.realtimeData = data
        this.isOnline = data.online_status === 1
        this.updateLastReportText(data.data.reported_at)
      } catch (e) {
        console.error('加载实时数据失败:', e)
        wx.showToast({ title: e.message || '获取数据失败', icon: 'none' })
      } finally {
        this.loading = false
      }
    },

    // 手动刷新：用户点击刷新按钮触发
    handleRefresh() {
      if (this.loading) return
      this.loadRealtimeData()
    },

    // 跳转到远程控制页面
    handleControl() {
      if (!this.deviceId) {
        wx.showToast({ title: '设备信息加载中', icon: 'none' })
        return
      }
      wx.navigateTo({
        url: `/pages/control/index?sn=${this.deviceSn}&deviceId=${this.deviceId}&name=${encodeURIComponent(this.deviceName)}`
      })
    },

    // 自动刷新开关切换
    handleAutoRefreshToggle(e) {
      this.autoRefreshEnabled = e.detail.value
      if (this.autoRefreshEnabled) {
        this.startAutoRefresh()
      } else {
        this.stopAutoRefresh()
      }
    },

    // 刷新间隔切换
    handleIntervalChange(e) {
      this.selectedIntervalIndex = parseInt(e.detail.value)
      // 如果自动刷新已开启，需要重新启动定时器以应用新间隔
      if (this.autoRefreshEnabled) {
        this.stopAutoRefresh()
        this.startAutoRefresh()
      }
    },

    // 启动自动刷新定时器
    startAutoRefresh() {
      const interval = this.intervalOptions[this.selectedIntervalIndex].value
      this.refreshTimer = setInterval(() => {
        this.loadRealtimeData()
      }, interval)
    },

    // 停止自动刷新定时器
    stopAutoRefresh() {
      if (this.refreshTimer) {
        clearInterval(this.refreshTimer)
        this.refreshTimer = null
      }
    },

    // 更新最后上报时间文本：将时间戳转换为易读的相对时间
    updateLastReportText(timestamp) {
      if (!timestamp) {
        this.lastReportText = '暂无上报'
        return
      }
      const now = Math.floor(Date.now() / 1000)
      const diff = now - timestamp

      if (diff < 60) {
        this.lastReportText = '刚刚上报'
      } else if (diff < 3600) {
        this.lastReportText = `${Math.floor(diff / 60)}分钟前`
      } else if (diff < 86400) {
        this.lastReportText = `${Math.floor(diff / 3600)}小时前`
      } else {
        this.lastReportText = `${Math.floor(diff / 86400)}天前`
      }
    },

    // 格式化数值：保留1位小数
    formatValue(value) {
      if (value == null) return '-'
      return Number(value).toFixed(1)
    },

    // 获取电池电量样式类：根据电量百分比返回不同颜色类名
    getBatteryClass(battery) {
      if (battery == null) return ''
      if (battery >= 80) return 'battery-high'
      if (battery >= 30) return 'battery-medium'
      return 'battery-low'
    },

    // 获取信号强度样式类：根据信号强度返回不同颜色类名
    getSignalClass(signal) {
      if (signal == null) return ''
      if (signal >= -60) return 'signal-strong'
      if (signal >= -80) return 'signal-medium'
      return 'signal-weak'
    },

    // 切换主题（三档循环）
    toggleTheme() {
      const store = useDeviceStore()
      store.toggleDarkMode()
      this.setData({ themeClass: store.themeClass, themeIcon: store.themeIcon })
    }
  }
})
</script>

<style scoped>
/* ==================== 页面根：拉丝金属墙面（明暗档由全局主题变量自动切换） ==================== */
.monitor-container {
  min-height: 100vh;
  background-color: var(--color-bg);
  background-image: var(--bg-texture);
  /* 底部预留 = fixed 操作栏（约 160rpx）+ 安全区 + 呼吸余量 */
  padding-bottom: calc(240rpx + env(safe-area-inset-bottom));
}

/* ==================== 动画定义 ==================== */
@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(40rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes rotate {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* LED 呼吸（在线指示灯，辉光由全局 .led.on 提供） */
@keyframes ledBlink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.45; }
}

.anim-fade-in {
  animation: fadeIn 0.5s ease-out;
}

.anim-slide-up {
  animation: slideUp 0.6s cubic-bezier(0.22, 0.9, 0.32, 1);
}

.anim-slide-up.d1 {
  animation-delay: 0.1s;
  opacity: 0;
  animation-fill-mode: forwards;
}

.anim-slide-up.d2 {
  animation-delay: 0.2s;
  opacity: 0;
  animation-fill-mode: forwards;
}

.rotating {
  animation: rotate 1s linear infinite;
}

/* ==================== Hero区：设备金属铭牌（四角铆钉由全局 .riveted 提供） ==================== */
.hero-section {
  position: relative;
  overflow: hidden;
  background: var(--grad-panel);
  border-bottom: 2rpx var(--panel-border-style) var(--color-border);
  box-shadow:
    inset 2rpx 2rpx 0 var(--color-highlight),
    inset -2rpx -2rpx 0 rgba(0, 0, 0, 0.12),
    var(--shadow-card);
  padding: 44rpx 32rpx 48rpx;
  margin: 0 0 24rpx 0;
}

/* Hero装饰：工业警示斜纹（位置避开四角铆钉） */
.hero-deco {
  position: absolute;
  pointer-events: none;
}

.deco-1 {
  top: 0;
  left: 64rpx;
  right: 64rpx;
  height: 8rpx;
  background: repeating-linear-gradient(
    -45deg,
    var(--color-primary) 0 14rpx,
    transparent 14rpx 28rpx
  );
  opacity: 0.75;
}

.deco-2 {
  bottom: 0;
  left: 64rpx;
  right: 64rpx;
  height: 6rpx;
  background: repeating-linear-gradient(
    -45deg,
    var(--color-track) 0 12rpx,
    transparent 12rpx 24rpx
  );
}

.hero-content {
  position: relative;
  z-index: 1;
}

/* 设备头部 */
.device-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.device-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.device-name {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-text);
  letter-spacing: 1rpx;
  word-break: break-all;
}

.device-sn {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  letter-spacing: 1rpx;
}

/* 主题切换金属圆钮 */
.theme-switch {
  flex-shrink: 0;
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background: var(--grad-btn-outline);
  border: 2rpx var(--panel-border-style) var(--color-border-strong);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow:
    inset 2rpx 2rpx 0 var(--color-highlight),
    inset -2rpx -2rpx 0 rgba(0, 0, 0, 0.12);
  transition: transform 0.2s ease;
}

.theme-switch:active {
  transform: scale(0.9) rotate(-15deg);
}

.theme-icon {
  font-size: 32rpx;
}

/* 状态指示器：LED + 铭牌 */
.status-indicator {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.status-badge {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  background: var(--color-panel-3);
  border: 1rpx solid var(--color-border);
  box-shadow: inset 1rpx 1rpx 0 var(--color-highlight);
}

.status-badge.online {
  background: var(--tint-success);
  border-color: var(--line-success);
}

/* 在线 LED 呼吸（绿色辉光由全局 .led.on 提供） */
.status-badge.online .led {
  animation: ledBlink 2s ease-in-out infinite;
}

.status-text {
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  color: var(--color-text-secondary);
}

.status-badge.online .status-text {
  color: var(--color-success);
}

.last-update {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}

/* ==================== 内容包装器 ==================== */
.content-wrapper {
  padding: 0 24rpx;
}

/* ==================== 数据面板：金属面板质感由全局 .card + .riveted 提供 ==================== */
.data-panel {
  margin: 0 0 24rpx;
  padding: 32rpx;
}

/* 面板头部 */
.panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.header-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

/* 标题发光短柱 */
.header-accent {
  width: 10rpx;
  height: 28rpx;
  border-radius: 3rpx;
  background: var(--color-primary);
  box-shadow: 0 0 8rpx var(--color-primary);
}

.header-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text);
  letter-spacing: 2rpx;
}

/* 刷新：金属凸起圆钮 */
.refresh-badge {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: var(--grad-btn-outline);
  border: 2rpx var(--panel-border-style) var(--color-border);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow:
    inset 2rpx 2rpx 0 var(--color-highlight),
    inset -2rpx -2rpx 0 rgba(0, 0, 0, 0.12);
  transition: transform 0.2s ease;
}

.refresh-badge:active {
  transform: scale(0.9);
}

.refresh-icon {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-primary);
}

/* 数据区域 */
.data-section {
  margin-bottom: 36rpx;
}

.data-section:last-child {
  margin-bottom: 0;
}

/* 小节铭牌：LED 方块 + 刻字 */
.section-label {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--color-text-secondary);
  text-transform: uppercase;
  letter-spacing: 3rpx;
  margin-bottom: 16rpx;
  padding-left: 4rpx;
}

.section-label::before {
  content: '';
  width: 14rpx;
  height: 14rpx;
  border-radius: 3rpx;
  background: var(--color-primary);
  box-shadow: 0 0 8rpx var(--color-primary);
}

/* 指标网格 */
.metrics-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

/* 指标数据格：内凹金属槽 */
.metric-card {
  position: relative;
  background: var(--color-panel-2);
  border: 2rpx var(--panel-border-style) var(--color-border);
  border-radius: var(--radius-sm);
  padding: 24rpx 20rpx 30rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  overflow: hidden;
  box-shadow:
    inset 2rpx 2rpx 4rpx var(--color-input-inset),
    inset -1rpx -1rpx 0 var(--color-highlight);
  transition: transform 0.2s ease;
}

.metric-card:active {
  transform: scale(0.98);
}

/* 指标仪表条：不同参数用状态色系区分（压力橙/温度红/阀门绿/流量琥珀） */
.metric-indicator {
  position: absolute;
  left: 20rpx;
  right: 20rpx;
  bottom: 12rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: var(--color-track);
}

.metric-card.pressure .metric-indicator {
  background: var(--color-primary);
  box-shadow: 0 0 8rpx var(--color-primary);
}

.metric-card.temperature .metric-indicator {
  background: var(--color-danger);
  box-shadow: 0 0 8rpx var(--color-danger);
}

.metric-card.valve .metric-indicator {
  background: var(--color-success);
  box-shadow: 0 0 8rpx var(--color-success);
}

.metric-card.flow .metric-indicator {
  background: var(--color-warning);
  box-shadow: 0 0 8rpx var(--color-warning);
}

.metric-label {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  font-weight: 500;
}

.metric-value-row {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

/* 大号 DIN 数码读数（字体由全局 .mono 提供） */
.metric-value {
  font-size: 52rpx;
  font-weight: 700;
  color: var(--color-text);
  line-height: 1;
}

.metric-unit {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  font-weight: 500;
}

/* 信息网格（设备信息用）：独立内凹金属槽 */
.info-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.info-item {
  background: var(--color-panel-2);
  border: 2rpx var(--panel-border-style) var(--color-border);
  border-radius: var(--radius-sm);
  padding: 24rpx 20rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  box-shadow:
    inset 2rpx 2rpx 4rpx var(--color-input-inset),
    inset -1rpx -1rpx 0 var(--color-highlight);
}

.info-label {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  font-weight: 500;
}

.info-value-row {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

/* 数码读数（字体由全局 .mono 提供） */
.info-value {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-text);
}

.info-unit {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}

/* ---------- LED 段式电平表（电量/信号） ---------- */
.led-meter {
  display: flex;
  align-items: center;
  gap: 5rpx;
  margin-left: auto;
  align-self: center;
  padding: 5rpx 7rpx;
  border-radius: 6rpx;
  background: var(--color-input-inset);
}

.led-meter .seg {
  width: 10rpx;
  height: 18rpx;
  border-radius: 2rpx;
  background: var(--color-track);
}

/* 电池：高→5段全亮绿 / 中→前3段琥珀 / 低→前1段红 */
.led-meter.battery-high .seg {
  background: var(--color-success);
  box-shadow: 0 0 8rpx var(--color-success);
}

.led-meter.battery-medium .seg:nth-child(-n+3) {
  background: var(--color-warning);
  box-shadow: 0 0 8rpx var(--color-warning);
}

.led-meter.battery-low .seg:nth-child(-n+1) {
  background: var(--color-danger);
  box-shadow: 0 0 8rpx var(--color-danger);
}

/* 信号：强→5段绿 / 中→前3段琥珀 / 弱→前1段红 */
.led-meter.signal-strong .seg {
  background: var(--color-success);
  box-shadow: 0 0 8rpx var(--color-success);
}

.led-meter.signal-medium .seg:nth-child(-n+3) {
  background: var(--color-warning);
  box-shadow: 0 0 8rpx var(--color-warning);
}

.led-meter.signal-weak .seg:nth-child(-n+1) {
  background: var(--color-danger);
  box-shadow: 0 0 8rpx var(--color-danger);
}

/* 电池/信号读数状态色 + 数码管辉光 */
.info-value.battery-high,
.info-value.signal-strong {
  color: var(--color-success);
  text-shadow: 0 0 12rpx var(--line-success);
}

.info-value.battery-medium,
.info-value.signal-medium {
  color: var(--color-warning);
  text-shadow: 0 0 12rpx var(--line-warning);
}

.info-value.battery-low,
.info-value.signal-weak {
  color: var(--color-danger);
  text-shadow: 0 0 12rpx var(--line-danger);
}

/* ==================== 控制面板：金属面板质感由全局 .card + .riveted 提供 ==================== */
.control-panel {
  margin: 0;
  padding: 32rpx;
}

.auto-switch {
  transform: scale(0.9);
}

.refresh-settings {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--color-border);
}

.settings-label {
  font-size: 28rpx;
  color: var(--color-text);
  font-weight: 500;
}

.interval-picker {
  flex-shrink: 0;
}

/* 间隔选择：内凹金属槽 */
.picker-display {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 24rpx;
  background: var(--color-panel-2);
  border: 2rpx var(--panel-border-style) var(--color-border);
  border-radius: var(--radius-sm);
  min-width: 150rpx;
  justify-content: space-between;
  box-shadow: inset 2rpx 2rpx 4rpx var(--color-input-inset);
}

.picker-value {
  font-size: 26rpx;
  color: var(--color-primary);
  font-weight: 700;
}

.picker-arrow {
  font-size: 28rpx;
  color: var(--color-text-tertiary);
}

/* ==================== 空状态：熄灭态 LED + 仪表刻度环 ==================== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 32rpx;
}

/* 中央熄灭态 LED */
.empty-dot {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 24rpx;
  height: 24rpx;
  margin: -12rpx 0 0 -12rpx;
  border-radius: 50%;
  background: var(--color-track);
  box-shadow: inset 0 0 6rpx var(--color-input-inset);
}

/* 仪表刻度环 */
.empty-wave {
  position: absolute;
  left: 50%;
  top: 50%;
  border-radius: 50%;
  border: 2rpx dashed var(--color-border);
}

.wave-1 {
  width: 60rpx;
  height: 60rpx;
  margin: -30rpx 0 0 -30rpx;
}

.wave-2 {
  width: 100rpx;
  height: 100rpx;
  margin: -50rpx 0 0 -50rpx;
  opacity: 0.6;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: var(--color-text-tertiary);
  text-align: center;
  line-height: 1.5;
}

/* ==================== 加载状态 ==================== */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid var(--color-track);
  border-top-color: var(--color-primary);
  border-radius: 50%;
  animation: rotate 0.8s linear infinite;
  margin-bottom: 24rpx;
}

.loading-text {
  font-size: 28rpx;
  color: var(--color-text-secondary);
  letter-spacing: 2rpx;
}

/* ==================== 底部操作栏：金属操控台 ==================== */
.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 100;
  display: flex;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: var(--grad-panel);
  border-top: 2rpx var(--panel-border-style) var(--color-border-strong);
  box-shadow:
    inset 2rpx 2rpx 0 var(--color-highlight),
    0 -6rpx 20rpx rgba(0, 0, 0, 0.18);
}

.action-btn {
  flex: 1;
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  border-radius: var(--radius);
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  border: none;
  transition: all 0.2s ease;
}

.action-btn::after {
  border: none;
}

.action-btn:active {
  transform: translateY(2rpx);
  filter: brightness(0.95);
}

/* 刷新：金属描边键 */
.btn-refresh {
  background: var(--grad-btn-outline);
  color: var(--color-primary);
  border: 2rpx var(--panel-border-style) var(--color-border-strong);
  box-shadow:
    inset 2rpx 2rpx 0 var(--color-highlight),
    inset -2rpx -2rpx 0 rgba(0, 0, 0, 0.12);
}

.btn-refresh:disabled {
  opacity: 0.5;
}

/* 远程控制：工业橙实体键 */
.btn-control {
  background: var(--grad-btn-primary);
  color: #FFFFFF;
  border: 2rpx var(--panel-border-style) var(--color-border-strong);
  box-shadow:
    inset 2rpx 2rpx 0 rgba(255, 255, 255, 0.35),
    inset -2rpx -2rpx 0 rgba(0, 0, 0, 0.2),
    0 6rpx 16rpx var(--glow-primary);
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.25);
}

.btn-icon {
  font-size: 36rpx;
}

.btn-text {
  letter-spacing: 2rpx;
}
</style>

