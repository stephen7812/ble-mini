.page.dark .btn-send:active { background: rgba(10, 132, 255, 0.15); }
.page.dark .status-tag.on { background: rgba(48, 209, 88, 0.15); color: var(--color-success); }
.page.dark .status-tag.off { background: #2C2C2E; color: var(--color-text-secondary); }
.page.dark .data-item { background: #2C2C2E; }
.page.dark .log-item { border-color: var(--color-border); }
.page.dark .param-input,
.page.dark .param-input-sm { background: #2C2C2E; border-color: transparent; color: var(--color-text); }
.page.dark .log-hex,
.page.dark .cmd-hex { color: #636366; }
