  --line-success: rgba(82, 183, 136, 0.4);
  --tint-warning: rgba(240, 180, 84, 0.14);
  --line-warning: rgba(240, 180, 84, 0.4);
  --tint-danger: rgba(229, 115, 95, 0.14);
  --line-danger: rgba(229, 115, 95, 0.4);

  --bg-texture:
    linear-gradient(180deg, #24382D 0%, #1C2B23 35%, #16221B 60%, #1E2F26 100%);

  background-color: var(--color-bg);
  background-image: var(--bg-texture);
}

/* ============ 能源 · 深黑档（近黑林绿）============ */
.theme-energy.darker {
  --color-primary: #74C69D;
  --color-success: #52B788;
  --color-warning: #F0B454;
  --color-danger: #E5735F;
  --color-accent-2: #7E9186;
