  --line-danger: rgba(229, 115, 95, 0.4);

  --bg-texture:
    linear-gradient(180deg, #1B2C23 0%, #121D17 35%, #0E1712 60%, #16241C 100%);

  background-color: var(--color-bg);
  background-image: var(--bg-texture);
}

/* ============================================================
   蓝图工程风 blueprint：工程图纸网格底、小圆角线框面板、
   蓝白双色。浅档=白图纸，暗档=经典深蓝蓝图。
   ============================================================ */
.theme-blueprint {
  --color-primary: #2E6FB0;          /* 制图蓝 */
  --color-success: #2F8F5B;
  --color-warning: #C88A2E;
  --color-danger: #C05046;
  --color-accent-2: #7A8BA3;         /* 蓝灰辅色 */
  --color-bg: #F4F7FB;
  --color-bg-secondary: #EAF0F7;
  --color-card: #FFFFFF;
  --color-text: #1C2B3A;
  --color-text-secondary: #52657A;
  --color-text-tertiary: #93A3B5;
  --color-border: #C3D2E2;
  --color-border-strong: #9AB0C7;
  --color-fill: rgba(46, 111, 176, 0.07);
  --color-fill-strong: rgba(46, 111, 176, 0.13);
  --color-panel-2: #F8FAFD;
  --color-panel-3: #EDF2F8;
  --color-highlight: rgba(255, 255, 255, 0.7);
  --color-input-inset: rgba(28, 43, 58, 0.08);
  --color-track: rgba(28, 43, 58, 0.14);

  --grad-panel: linear-gradient(170deg, #FFFFFF 0%, #F2F6FA 100%);
  --grad-btn-primary: linear-gradient(170deg, #4C8BC9 0%, #2E6FB0 55%, #1F5485 100%);
  --grad-btn-outline: linear-gradient(170deg, #F8FAFD 0%, #EDF2F8 100%);

  --deco-rivet: transparent;
  --deco-rivet-shadow: transparent;
  --panel-border-style: solid;       /* 线框制图边 */

  --radius-lg: 12rpx;                /* 技术感小圆角 */
  --radius: 8rpx;
  --radius-sm: 6rpx;
  --shadow-card: 0 2rpx 10rpx rgba(28, 43, 58, 0.10);
  --shadow-float: 0 10rpx 28rpx rgba(28, 43, 58, 0.16);

  --tint-primary: rgba(46, 111, 176, 0.12);
  --glow-primary-soft: rgba(46, 111, 176, 0.18);
  --glow-primary: rgba(46, 111, 176, 0.32);
  --glow-primary-strong: rgba(46, 111, 176, 0.5);

  --tint-success: rgba(47, 143, 91, 0.12);
  --line-success: rgba(47, 143, 91, 0.4);
  --tint-warning: rgba(200, 138, 46, 0.12);
  --line-warning: rgba(200, 138, 46, 0.4);
  --tint-danger: rgba(192, 80, 70, 0.12);
  --line-danger: rgba(192, 80, 70, 0.4);

  /* 图纸网格：浅蓝细线 + 白纸渐变（蓝图风签名底纹） */
  --bg-texture:
    repeating-linear-gradient(0deg, rgba(46, 111, 176, 0.05) 0 1px, transparent 1px 24px),
    repeating-linear-gradient(90deg, rgba(46, 111, 176, 0.05) 0 1px, transparent 1px 24px),
    linear-gradient(180deg, #F7FAFC 0%, #F0F5FA 55%, #F4F7FB 100%);

  background-color: var(--color-bg);
  background-image: var(--bg-texture);
}

/* ============ 蓝图 · 暗档（经典深蓝图纸 + 青蓝线）============ */
.theme-blueprint.dark {
  --color-primary: #7FC4F8;          /* 青蓝线稿色 */
  --color-success: #6BCB8B;
  --color-warning: #F0C24B;
  --color-danger: #F07A6A;
  --color-accent-2: #8CA2C4;
  --color-bg: #16233F;
  --color-bg-secondary: #101A30;
