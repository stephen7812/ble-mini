  --color-fill: rgba(116, 198, 157, 0.06);
  --color-fill-strong: rgba(116, 198, 157, 0.11);
  --color-panel-2: #19271F;
  --color-panel-3: #121C16;
  --color-highlight: rgba(255, 255, 255, 0.05);
  --color-input-inset: rgba(0, 0, 0, 0.40);
