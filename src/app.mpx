  --grad-btn-primary: linear-gradient(165deg, #8FD4AF 0%, #52B788 60%, #3E8E68 100%);
  --grad-btn-outline: linear-gradient(165deg, #19271F 0%, #121C16 100%);

  --deco-rivet: transparent;
  --deco-rivet-shadow: transparent;
  --panel-border-style: solid;

  --shadow-card: 0 6rpx 20rpx rgba(0, 0, 0, 0.5);
  --shadow-float: 0 14rpx 36rpx rgba(0, 0, 0, 0.65);

  --tint-primary: rgba(116, 198, 157, 0.14);
  --glow-primary-soft: rgba(116, 198, 157, 0.22);
  --glow-primary: rgba(116, 198, 157, 0.35);
  --glow-primary-strong: rgba(116, 198, 157, 0.55);

