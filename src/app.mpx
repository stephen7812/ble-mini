  --grad-panel: linear-gradient(145deg, #34383F 0%, #262A30 60%, #1F2227 100%);
  --grad-btn-primary: linear-gradient(145deg, #FF9F42 0%, #FF8A1E 60%, #D97316 100%);
  --grad-btn-outline: linear-gradient(145deg, #2E323A 0%, #23262C 100%);

  --deco-rivet: #7A7E88;
  --deco-rivet-shadow: #141619;

  --shadow-card: 0 4rpx 16rpx rgba(0, 0, 0, 0.4);
  --shadow-float: 0 12rpx 32rpx rgba(0, 0, 0, 0.55);

  --tint-primary: rgba(255, 138, 30, 0.14);
  --glow-primary-soft: rgba(255, 138, 30, 0.22);
  --glow-primary: rgba(255, 138, 30, 0.35);
  --glow-primary-strong: rgba(255, 138, 30, 0.55);

  --tint-success: rgba(61, 220, 132, 0.14);
  --line-success: rgba(61, 220, 132, 0.4);
  --tint-warning: rgba(255, 176, 32, 0.14);
  --line-warning: rgba(255, 176, 32, 0.4);
  --tint-danger: rgba(255, 69, 58, 0.14);
  --line-danger: rgba(255, 69, 58, 0.4);

  --bg-texture:
    linear-gradient(180deg, #3A3E46 0%, #2C2F36 32%, #23262C 58%, #2B2E35 82%, #34383F 100%);

  background-color: var(--color-bg);
  background-image: var(--bg-texture);
}

/* ============ 工业 · 深黑档（近黑 + 琥珀橙）============ */
.darker,
.theme-industrial.darker {
  --color-primary: #FF8A1E;
  --color-success: #3DDC84;
  --color-warning: #FFB020;
  --color-danger: #FF453A;
  --color-accent-2: #7A8089;
  --color-bg: #1C1E23;
  --color-bg-secondary: #16181C;
  --color-card: #212429;
  --color-text: #E7E9ED;
  --color-text-secondary: #8F95A0;
  --color-text-tertiary: #565B65;
  --color-border: #4A4E57;
  --color-border-strong: #33373E;
  --color-fill: rgba(255, 255, 255, 0.06);
  --color-fill-strong: rgba(255, 255, 255, 0.11);
  --color-panel-2: #212429;
  --color-panel-3: #17191E;
  --color-highlight: rgba(255, 255, 255, 0.08);
  --color-input-inset: rgba(0, 0, 0, 0.45);
  --color-track: #26292F;

  --grad-panel: linear-gradient(145deg, #262A30 0%, #1B1E23 60%, #15171B 100%);
  --grad-btn-primary: linear-gradient(145deg, #FF9F42 0%, #FF8A1E 60%, #D97316 100%);
  --grad-btn-outline: linear-gradient(145deg, #212429 0%, #17191E 100%);

  --deco-rivet: #6E727B;
  --deco-rivet-shadow: #0C0D10;

  --shadow-card: 0 4rpx 16rpx rgba(0, 0, 0, 0.5);
  --shadow-float: 0 12rpx 32rpx rgba(0, 0, 0, 0.65);

  --tint-primary: rgba(255, 138, 30, 0.14);
  --glow-primary-soft: rgba(255, 138, 30, 0.22);
  --glow-primary: rgba(255, 138, 30, 0.35);
  --glow-primary-strong: rgba(255, 138, 30, 0.55);

  --tint-success: rgba(61, 220, 132, 0.14);
  --line-success: rgba(61, 220, 132, 0.4);
  --tint-warning: rgba(255, 176, 32, 0.14);
  --line-warning: rgba(255, 176, 32, 0.4);
  --tint-danger: rgba(255, 69, 58, 0.14);
  --line-danger: rgba(255, 69, 58, 0.4);

  --bg-texture:
    linear-gradient(180deg, #26292F 0%, #1B1E23 32%, #16181C 58%, #1A1D22 82%, #22252B 100%);

  background-color: var(--color-bg);
  background-image: var(--bg-texture);
}

/* ============================================================
   能源管道风 energy：生态绿主色、柔和圆角、无铆钉装饰。
   布局意象：供水→阀门→回水的管道流向叙事。
   ============================================================ */
.theme-energy {
  --color-primary: #2D6A4F;          /* 生态绿 */
  --color-success: #40916C;
  --color-warning: #CC8A2E;
  --color-danger: #C1554A;
  --color-accent-2: #7A8B80;         /* 苔灰辅色 */
  --color-bg: #F2F6F3;
  --color-bg-secondary: #E6EEE9;
  --color-card: #FFFFFF;
  --color-text: #22312A;
  --color-text-secondary: #5C6E64;
  --color-text-tertiary: #9AABA1;
  --color-border: #C2D4C9;
  --color-border-strong: #9DB8A8;
  --color-fill: rgba(45, 106, 79, 0.07);
  --color-fill-strong: rgba(45, 106, 79, 0.13);
  --color-panel-2: #F7FAF8;
  --color-panel-3: #EAF1EC;
  --color-highlight: rgba(255, 255, 255, 0.8);
  --color-input-inset: rgba(45, 106, 79, 0.08);
  --color-track: rgba(45, 106, 79, 0.14);

  --grad-panel: linear-gradient(165deg, #FFFFFF 0%, #F4F8F5 100%);
  --grad-btn-primary: linear-gradient(165deg, #52B788 0%, #2D6A4F 60%, #1B4332 100%);
  --grad-btn-outline: linear-gradient(165deg, #F7FAF8 0%, #EAF1EC 100%);

  /* 能源风无金属铆钉：置透明隐藏 */
  --deco-rivet: transparent;
  --deco-rivet-shadow: transparent;
  --panel-border-style: solid;       /* 柔和细边 */

  --radius-lg: 28rpx;                /* 圆角放大一档 */
  --radius: 20rpx;
  --radius-sm: 14rpx;
  --shadow-card: 0 6rpx 20rpx rgba(45, 106, 79, 0.10);
  --shadow-float: 0 14rpx 36rpx rgba(45, 106, 79, 0.16);

  --tint-primary: rgba(45, 106, 79, 0.12);
  --glow-primary-soft: rgba(45, 106, 79, 0.18);
  --glow-primary: rgba(45, 106, 79, 0.32);
  --glow-primary-strong: rgba(45, 106, 79, 0.5);

  --tint-success: rgba(64, 145, 108, 0.12);
  --line-success: rgba(64, 145, 108, 0.4);
  --tint-warning: rgba(204, 138, 46, 0.12);
  --line-warning: rgba(204, 138, 46, 0.4);
  --tint-danger: rgba(193, 85, 74, 0.12);
  --line-danger: rgba(193, 85, 74, 0.4);

  --bg-texture:
    linear-gradient(180deg, #F7FAF8 0%, #F0F5F1 38%, #EAF1EC 62%, #F2F6F3 100%);

  background-color: var(--color-bg);
  background-image: var(--bg-texture);
}

/* ============ 能源 · 暗档（深林绿 + 薄荷绿）============ */
.theme-energy.dark {
  --color-primary: #74C69D;          /* 薄荷绿（发光） */
  --color-success: #52B788;
  --color-warning: #F0B454;
  --color-danger: #E5735F;
  --color-accent-2: #8FA398;
