<script>
import { createApp } from '@mpxjs/core'
import { createPinia } from '@mpxjs/pinia'
import { useAuthStore } from './stores/auth'
import { useDeviceStore } from './stores/device'

createApp({
  onLaunch() {
    createPinia()
    // 顺序要紧：先恢复登录态再让首页 onShow 去读 isLogged，
    // 反过来会让首页在第一帧把已登录的人当成未登录。
    useAuthStore().loadAuth()
    const store = useDeviceStore()
    store.loadDevices()
    store.loadDarkMode()
  },
})
</script>

<style>
/* ============ Apple Design · Light ============ */
page {
  --color-primary: #007AFF;
  --color-success: #34C759;
  --color-warning: #FF9500;
  --color-danger: #FF3B30;
  --color-bg: #F2F2F7;
  --color-bg-secondary: #E5E5EA;
  --color-card: #FFFFFF;
  --color-text: #1C1C1E;
  --color-text-secondary: #8E8E93;
  --color-text-tertiary: #C7C7CC;
  --color-border: #E5E5EA;
  --color-fill: rgba(120, 120, 128, 0.12);
