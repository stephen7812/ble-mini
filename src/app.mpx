  --color-text-secondary: #93A7C7;
  --color-text-tertiary: #5A6E92;
  --color-border: #3A5178;
  --color-border-strong: #2A3C5E;
  --color-fill: rgba(127, 196, 248, 0.08);
  --color-fill-strong: rgba(127, 196, 248, 0.14);
  --color-panel-2: #1C2C4E;
  --color-panel-3: #152340;
  --color-highlight: rgba(255, 255, 255, 0.07);
  --color-input-inset: rgba(0, 0, 0, 0.35);
  --color-track: #24365C;

  --grad-panel: linear-gradient(170deg, #22355C 0%, #1A2A4C 60%, #141F3A 100%);
  --grad-btn-primary: linear-gradient(170deg, #5FB0E8 0%, #3B82C4 60%, #2A5E94 100%);
  --grad-btn-outline: linear-gradient(170deg, #1C2C4E 0%, #152340 100%);

  --deco-rivet: transparent;
  --deco-rivet-shadow: transparent;
  --panel-border-style: solid;

  --shadow-card: 0 4rpx 16rpx rgba(0, 0, 0, 0.4);
  --shadow-float: 0 12rpx 32rpx rgba(0, 0, 0, 0.55);

  --tint-primary: rgba(127, 196, 248, 0.14);
  --glow-primary-soft: rgba(127, 196, 248, 0.22);
  --glow-primary: rgba(127, 196, 248, 0.35);
  --glow-primary-strong: rgba(127, 196, 248, 0.55);

  --tint-success: rgba(107, 203, 139, 0.14);
  --line-success: rgba(107, 203, 139, 0.4);
  --tint-warning: rgba(240, 194, 75, 0.14);
  --line-warning: rgba(240, 194, 75, 0.4);
  --tint-danger: rgba(240, 122, 106, 0.14);
  --line-danger: rgba(240, 122, 106, 0.4);

  --bg-texture:
    repeating-linear-gradient(0deg, rgba(127, 196, 248, 0.06) 0 1px, transparent 1px 24px),
    repeating-linear-gradient(90deg, rgba(127, 196, 248, 0.06) 0 1px, transparent 1px 24px),
    linear-gradient(180deg, #1C2C4E 0%, #16233F 50%, #101A30 100%);

  background-color: var(--color-bg);
  background-image: var(--bg-texture);
}

/* ============ 蓝图 · 深黑档（午夜图纸）============ */
.theme-blueprint.darker {
  --color-primary: #7FC4F8;
  --color-success: #6BCB8B;
  --color-warning: #F0C24B;
  --color-danger: #F07A6A;
  --color-accent-2: #7B90B4;
  --color-bg: #0E1729;
  --color-bg-secondary: #0A1120;
  --color-card: #14213B;
  --color-text: #DCE9F8;
  --color-text-secondary: #8298BC;
  --color-text-tertiary: #4C5F84;
  --color-border: #2E4266;
  --color-border-strong: #1E2F4E;
  --color-fill: rgba(127, 196, 248, 0.06);
  --color-fill-strong: rgba(127, 196, 248, 0.11);
  --color-panel-2: #14213B;
  --color-panel-3: #0F1B33;
  --color-highlight: rgba(255, 255, 255, 0.05);
  --color-input-inset: rgba(0, 0, 0, 0.45);
  --color-track: #1A2A4A;

  --grad-panel: linear-gradient(170deg, #1A2A4C 0%, #131F3C 60%, #0D1730 100%);
  --grad-btn-primary: linear-gradient(170deg, #5FB0E8 0%, #3B82C4 60%, #2A5E94 100%);
  --grad-btn-outline: linear-gradient(170deg, #14213B 0%, #0F1B33 100%);

  --deco-rivet: transparent;
  --deco-rivet-shadow: transparent;
  --panel-border-style: solid;

  --shadow-card: 0 4rpx 16rpx rgba(0, 0, 0, 0.5);
  --shadow-float: 0 12rpx 32rpx rgba(0, 0, 0, 0.65);

  --tint-primary: rgba(127, 196, 248, 0.14);
  --glow-primary-soft: rgba(127, 196, 248, 0.22);
  --glow-primary: rgba(127, 196, 248, 0.35);
  --glow-primary-strong: rgba(127, 196, 248, 0.55);

  --tint-success: rgba(107, 203, 139, 0.14);
  --line-success: rgba(107, 203, 139, 0.4);
  --tint-warning: rgba(240, 194, 75, 0.14);
  --line-warning: rgba(240, 194, 75, 0.4);
  --tint-danger: rgba(240, 122, 106, 0.14);
  --line-danger: rgba(240, 122, 106, 0.4);

  --bg-texture:
    repeating-linear-gradient(0deg, rgba(127, 196, 248, 0.05) 0 1px, transparent 1px 24px),
    repeating-linear-gradient(90deg, rgba(127, 196, 248, 0.05) 0 1px, transparent 1px 24px),
    linear-gradient(180deg, #14213B 0%, #0E1729 50%, #0A1120 100%);

  background-color: var(--color-bg);
  background-image: var(--bg-texture);
}

/* ============ 以下组件类全部只消费语义变量（多主题兼容核心）============ */

/* ---------- 数字读数：DIN 数码管风格 ---------- */
.mono,
.num {
  font-family: 'DIN Alternate', 'Roboto Mono', 'SF Mono', Menlo, monospace;
  letter-spacing: 1rpx;
}

/* ---------- 面板 ---------- */
.card {
  position: relative;
  background: var(--grad-panel);
  border: 2rpx var(--panel-border-style) var(--color-border);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  margin: 24rpx 24rpx 0;
  box-shadow:
    inset 2rpx 2rpx 0 var(--color-highlight),
    inset -2rpx -2rpx 0 rgba(0, 0, 0, 0.12),
    var(--shadow-card);
}

/* ---------- 铆钉角标：四角螺丝（工业风专属；其他风格变量置透明即隐藏）---------- */
.riveted { position: relative; }
.riveted::before,
.riveted::after {
  content: '';
  position: absolute;
  inset: 0;
  pointer-events: none;
  border-radius: inherit;
  background-repeat: no-repeat;
  z-index: 1;
}
.riveted::before {
  background-image:
    radial-gradient(circle at 14rpx 14rpx, var(--deco-rivet) 0 4rpx, var(--deco-rivet-shadow) 4.6rpx 6rpx, transparent 7rpx),
    radial-gradient(circle at calc(100% - 14rpx) 14rpx, var(--deco-rivet) 0 4rpx, var(--deco-rivet-shadow) 4.6rpx 6rpx, transparent 7rpx);
}
.riveted::after {
  background-image:
    radial-gradient(circle at 14rpx calc(100% - 14rpx), var(--deco-rivet) 0 4rpx, var(--deco-rivet-shadow) 4.6rpx 6rpx, transparent 7rpx),
    radial-gradient(circle at calc(100% - 14rpx) calc(100% - 14rpx), var(--deco-rivet) 0 4rpx, var(--deco-rivet-shadow) 4.6rpx 6rpx, transparent 7rpx);
}

/* ---------- LED 指示灯 ---------- */
.led {
  width: 14rpx; height: 14rpx; border-radius: 50%;
  background: var(--color-track);
  box-shadow: inset 0 0 4rpx rgba(0, 0, 0, 0.4);
  flex-shrink: 0;
}
.led.on { background: var(--color-success); box-shadow: 0 0 10rpx var(--color-success); }
.led.warn { background: var(--color-warning); box-shadow: 0 0 10rpx var(--color-warning); }
.led.err  { background: var(--color-danger);  box-shadow: 0 0 10rpx var(--color-danger); }
.led.accent { background: var(--color-primary); box-shadow: 0 0 10rpx var(--color-primary); }

/* ---------- 章节标题 ---------- */
.section-title {
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
  color: var(--color-text-secondary);
  text-transform: uppercase;
}

/* ---------- 布局与排版 ---------- */
.flex-center { display: flex; align-items: center; justify-content: center; }
.flex-between { display: flex; align-items: center; justify-content: space-between; }
.text-primary { color: var(--color-primary); }
.text-success { color: var(--color-success); }
.text-danger { color: var(--color-danger); }
.text-secondary { color: var(--color-text-secondary); }
.text-sm { font-size: 24rpx; }
.text-lg { font-size: 34rpx; }
.font-bold { font-weight: 600; }
.mt-8 { margin-top: 16rpx; }
.mt-16 { margin-top: 32rpx; }
.mb-8 { margin-bottom: 16rpx; }
.ml-8 { margin-left: 16rpx; }

/* ---------- 主按钮 ---------- */
.btn-primary {
  background: var(--grad-btn-primary);
  color: #fff;
  border: 2rpx var(--panel-border-style) var(--color-border-strong);
  border-radius: var(--radius);
  padding: 24rpx 48rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  box-shadow:
    inset 2rpx 2rpx 0 rgba(255, 255, 255, 0.35),
    inset -2rpx -2rpx 0 rgba(0, 0, 0, 0.2),
    0 6rpx 16rpx var(--glow-primary);
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.25);
}
.btn-primary:active { opacity: 0.9; transform: scale(0.98) translateY(2rpx); filter: brightness(0.94); }
.btn-outline {
  border: 2rpx var(--panel-border-style) var(--color-border);
  background: var(--grad-btn-outline);
  color: var(--color-primary);
  border-radius: var(--radius);
  padding: 22rpx 48rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  box-shadow:
    inset 2rpx 2rpx 0 var(--color-highlight),
    inset -2rpx -2rpx 0 rgba(0, 0, 0, 0.12);
}
.btn-outline:active { filter: brightness(0.95); transform: translateY(2rpx); }

/* ---------- 标签（tint/line 令牌驱动，随风格+明暗自适应）---------- */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  border: 1rpx solid var(--color-border);
  background: var(--color-panel-2);
  color: var(--color-text-secondary);
}
.tag-success { background: var(--tint-success); color: var(--color-success); border-color: var(--line-success); }
.tag-warning { background: var(--tint-warning); color: var(--color-warning); border-color: var(--line-warning); }
.tag-error   { background: var(--tint-danger); color: var(--color-danger); border-color: var(--line-danger); }

/* ---------- 输入框：内凹槽 ---------- */
.field-input {
  background: var(--color-panel-2);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-sm);
  color: var(--color-text);
  box-shadow: inset 2rpx 2rpx 4rpx var(--color-input-inset);
}
.field-input:focus,
.field-input.field-focus { border-color: var(--color-primary); }

/* ---------- 选项按钮 ---------- */
.sel-option {
  background: var(--color-panel-2);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-sm);
  box-shadow: inset 2rpx 2rpx 0 var(--color-highlight);
}
.sel-active {
  background: var(--color-fill);
  border-color: var(--color-primary);
  box-shadow:
    inset 2rpx 2rpx 0 var(--color-highlight),
    0 0 0 2rpx var(--color-fill);
}

/* ---------- 历史记录条 ---------- */
.history-item {
  background: var(--color-panel-2);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-sm);
  box-shadow: inset 1rpx 1rpx 0 var(--color-highlight);
}
.history-item:active { filter: brightness(0.96); }
.history-tag {
  background: var(--color-fill);
  color: var(--color-primary);
  border: 1rpx solid var(--color-border);
  border-radius: 6rpx;
}

/* ---------- 命令按钮 ---------- */
.btn-cmd {
  background: var(--color-panel-2);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-sm);
  box-shadow:
    inset 2rpx 2rpx 0 var(--color-highlight),
    inset -2rpx -2rpx 0 rgba(0, 0, 0, 0.1);
}
.btn-cmd:active { filter: brightness(0.94); transform: translateY(2rpx); }
.btn-send { border-color: var(--color-primary); }
.btn-send:active { background: var(--color-fill); }

/* ---------- 状态铭牌 ---------- */
.status-tag {
  border-radius: 6rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}
.status-tag.on {
  background: var(--tint-success);
  color: var(--color-success);
  border: 1rpx solid var(--line-success);
}
.status-tag.off {
  background: var(--color-panel-3);
  color: var(--color-text-secondary);
  border: 1rpx solid var(--color-border);
}

/* ---------- 数据格 ---------- */
.data-item {
  background: var(--color-panel-2);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-sm);
  box-shadow: inset 1rpx 1rpx 0 var(--color-highlight);
}

/* ---------- 日志条 ---------- */
.log-item { border: 1rpx solid var(--color-border); border-radius: var(--radius-sm); }

/* ---------- 参数输入 ---------- */
.param-input,
.param-input-sm {
  background: var(--color-panel-2);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-sm);
  color: var(--color-text);
  box-shadow: inset 2rpx 2rpx 4rpx var(--color-input-inset);
}
.param-input:focus,
.param-input-sm:focus { border-color: var(--color-primary); }

/* ---------- 十六进制字节 ---------- */
.log-hex,
.cmd-hex { color: var(--color-text-tertiary); font-family: 'SF Mono', Menlo, monospace; }

/* ---------- 命令特殊按钮 ---------- */
.btn-cmd-full {
  background: var(--tint-success);
  border: 1rpx solid var(--line-success);
  border-radius: var(--radius-sm);
}
.btn-cmd-close {
  background: var(--tint-danger);
  border: 1rpx solid var(--line-danger);
  border-radius: var(--radius-sm);
}
.btn-cmd-primary { border-color: var(--color-primary); }
.btn-cmd-primary .cmd-name { color: var(--color-primary); }
</style>

