  color: #fff;
  border-radius: 999rpx;
  padding: 24rpx 48rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  box-shadow: 0 8rpx 20rpx rgba(0, 122, 255, 0.25);
}
.btn-primary:active { opacity: 0.75; transform: scale(0.98); }
.btn-outline {
  border: none;
  background: var(--color-fill);
  color: var(--color-primary);
  border-radius: 999rpx;
  padding: 22rpx 48rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
}
.btn-outline:active { background: var(--color-fill-strong); }

/* ---------- 标签：iOS 柔和填充 ---------- */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 500;
}
.tag-success { background: rgba(52, 199, 89, 0.12); color: #34C759; }
.tag-warning { background: rgba(255, 149, 0, 0.12); color: #FF9500; }
.tag-error { background: rgba(255, 59, 48, 0.12); color: #FF3B30; }

/* ============ Apple Design · Dark ============ */
.page.dark {
  --color-primary: #0A84FF;
  --color-success: #30D158;
  --color-warning: #FF9F0A;
  --color-danger: #FF453A;
  --color-bg: #000000;
  --color-bg-secondary: #1C1C1E;
