<script>
import { createApp } from '@mpxjs/core'
import { createPinia } from '@mpxjs/pinia'
import { useAuthStore } from './stores/auth'
import { useDeviceStore } from './stores/device'

createApp({
  onLaunch() {
    createPinia()
    // 顺序要紧：先恢复登录态再让首页 onShow 去读 isLogged，
    // 反过来会让首页在第一帧把已登录的人当成未登录。
    useAuthStore().loadAuth()
    const store = useDeviceStore()
    store.loadDevices()
    store.loadDarkMode()
  },
})
</script>

<style>
/* ============================================================
   多主题架构 · 语义变量层
   ------------------------------------------------------------
   两个正交维度：
   1) 风格 themeStyle：industrial（工业机械）/ energy（能源管道）/ blueprint（蓝图工程）
      挂载类：.theme-<style>
   2) 明暗 themeLevel：light / dark / darker
      挂载类：'' / dark / dark darker

   页面根节点 class="{{themeClass}}"（store getter 拼装）：
     theme-industrial            → 工业风浅档
     theme-energy dark           → 能源风暗档
     theme-blueprint dark darker → 蓝图风深黑档

   兼容回退：page 与裸 .dark/.darker 内置工业风默认值，
   未挂风格类的旧节点依然正确显示。

   新增风格四步（以 xxx 为例）：
   a) 复制一份 .theme-xxx 三块（light/dark/darker）并改变量值；
   b) 只改变量，不碰组件类（.card/.btn-primary 等全部由变量驱动）；
   c) store 的 THEME_STYLES 白名单加 'xxx'；
   d) 设置页 styles 数组加一项。
   ============================================================ */

/* ============ 工业 mechanical · 浅档（银灰金属 + 青绿点缀）============ */
page,
.theme-industrial {
  /* ---- 语义色 ---- */
  --color-primary: #0D9488;          /* 工业青绿（浅档点缀色） */
  --color-success: #1F9D55;
  --color-warning: #D6830A;
  --color-danger: #D8392B;
  --color-accent-2: #6E7680;         /* 钢灰辅色（信息类中性色） */
  --color-bg: #D7DBE1;               /* 银铝墙面 */
  --color-bg-secondary: #C6CCD4;
  --color-card: #E6E9EE;
  --color-text: #20242B;
  --color-text-secondary: #5B616B;
  --color-text-tertiary: #9BA1AB;
  --color-border: #A9AFB8;
  --color-border-strong: #8B919B;
  --color-fill: rgba(32, 36, 43, 0.08);
  --color-fill-strong: rgba(32, 36, 43, 0.14);
  --color-panel-2: #DFE3E9;          /* 亮面板 */
  --color-panel-3: #C9CFD7;          /* 暗面板 */
  --color-highlight: rgba(255, 255, 255, 0.5);   /* 金属上沿高光 */
  --color-input-inset: rgba(0, 0, 0, 0.10);      /* 输入框内凹暗影 */
  --color-track: rgba(32, 36, 43, 0.16);         /* 轨道/未点亮底 */

  /* ---- 渐变 ---- */
  --grad-panel: linear-gradient(145deg, #EEF1F5 0%, #D6DBE2 55%, #C6CCD4 100%);
  --grad-btn-primary: linear-gradient(145deg, #16B8A6 0%, #0D9488 60%, #0B7A70 100%);
  --grad-btn-outline: linear-gradient(145deg, #DFE3E9 0%, #C9CFD7 100%);

  /* ---- 装饰 ---- */
  --deco-rivet: #F3F5F8;             /* 铆钉高光 */
  --deco-rivet-shadow: #8A9099;      /* 铆钉暗影 */
  --panel-border-style: groove;      /* 工业凹槽边框 */

  /* ---- 形状与阴影 ---- */
  --radius-lg: 20rpx;
  --radius: 14rpx;
  --radius-sm: 10rpx;
  --shadow-card: 0 4rpx 16rpx rgba(0, 0, 0, 0.12);
  --shadow-float: 0 12rpx 32rpx rgba(0, 0, 0, 0.20);

  /* ---- 主色 tint / 辉光令牌 ---- */
  --tint-primary: rgba(13, 148, 136, 0.12);
  --glow-primary-soft: rgba(13, 148, 136, 0.18);
  --glow-primary: rgba(13, 148, 136, 0.35);
  --glow-primary-strong: rgba(13, 148, 136, 0.5);

  /* ---- 状态色 tint / 描边令牌 ---- */
  --tint-success: rgba(31, 157, 85, 0.12);
  --line-success: rgba(31, 157, 85, 0.4);
  --tint-warning: rgba(214, 131, 10, 0.12);
  --line-warning: rgba(214, 131, 10, 0.4);
  --tint-danger: rgba(216, 57, 43, 0.12);
  --line-danger: rgba(216, 57, 43, 0.4);

  /* ---- 页面背景：银灰渐变金属 ---- */
  --bg-texture:
    linear-gradient(180deg, #E6E9EE 0%, #D5DAE1 32%, #CBD1D8 58%, #D4D9DF 82%, #DFE3E9 100%);

  background-color: var(--color-bg);
  background-image: var(--bg-texture);
  font-size: 28rpx;
  line-height: 1.45;
  color: var(--color-text);
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC', sans-serif;
  -webkit-font-smoothing: antialiased;
}

/* ============ 工业 · 暗档（枪灰渐变 + 琥珀橙）============ */
.dark,
.theme-industrial.dark {
  --color-primary: #FF8A1E;          /* 琥珀橙（发光） */
  --color-success: #3DDC84;
  --color-warning: #FFB020;
  --color-danger: #FF453A;
  --color-accent-2: #8E959F;
  --color-bg: #2A2D34;
